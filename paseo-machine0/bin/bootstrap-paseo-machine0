#!/usr/bin/env bash
# bootstrap-paseo-machine0 -- provision a paseo-machine0 hub or spoke
# (plugins/paseo-machine0): per-project Paseo spokes on machine0, run from a hub.
#
#   bootstrap-paseo-machine0 --role hub   [--host exe|machine0]   # default host: exe
#   bootstrap-paseo-machine0 --role spoke [--host machine0|exe]   # default host: machine0
#
# Both roles run a Paseo daemon (paseo-setup) with Claude Code, Codex, pi and
# opencode. The hub adds the machine0 CLI, the credential broker's pi SDK, the
# Spokes plugin and hubd. `paseo-machine0 image build` runs this with --role
# spoke on a builder VM and snapshots it into paseo-machine0-spoke, so spokes
# normally never run it themselves. No herdr, Moshi or Heeler here.
#
# Hub on exe.dev, from the Mac:
#   ssh exe.dev new --name=paseo-hub --cpu=2 --memory=4GB
#   ssh exe.dev integrations attach dotfiles vm:paseo-hub   # the GitHub proxy; applies after a minute
#   ssh paseo-hub.exe.xyz 'git clone https://github.int.exe.xyz/justmytwospence/dotfiles.git ~/dotfiles \
#       && ~/dotfiles/paseo-machine0/bin/bootstrap-paseo-machine0 --role hub'
#
# Every step is idempotent; re-run at will. Derived from m0/bin/bootstrap-m0.
set -euo pipefail

DOTFILES=${DOTFILES_DIR:-$HOME/dotfiles}
BIN=$HOME/.local/bin
export PATH="$BIN:$PATH"
mkdir -p "$BIN"

role= host=
while [[ $# -gt 0 ]]; do
    case $1 in
        --role) role=$2; shift 2 ;;
        --host) host=$2; shift 2 ;;
        *) echo "usage: bootstrap-paseo-machine0 --role hub|spoke [--host exe|machine0]" >&2; exit 2 ;;
    esac
done
[[ $role == hub || $role == spoke ]] || { echo "bootstrap-paseo-machine0: --role hub|spoke is required" >&2; exit 2; }
[[ -n $host ]] || { [[ $role == hub ]] && host=exe || host=machine0; }
[[ $host == exe || $host == machine0 ]] || { echo "bootstrap-paseo-machine0: --host exe|machine0" >&2; exit 2; }

log() { printf '\n==> %s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

[[ $(uname) == Linux ]] || { echo "bootstrap-paseo-machine0 provisions a Linux VM; run it there" >&2; exit 1; }
[[ -d $DOTFILES ]] || { echo "no dotfiles checkout at $DOTFILES" >&2; exit 1; }
PLUGIN=$DOTFILES/plugins/paseo-machine0
STATE=$HOME/.config/paseo-machine0

write_managed() {
    local path=$1 body=$2 marker="written by bootstrap-paseo-machine0"
    if [[ -e $path ]] && ! grep -qF "$marker" "$path"; then
        log "leaving hand-edited $path alone"
        return 0
    fi
    printf '%s' "$body" > "$path"
}

backup_unowned() {
    local f=$1
    [[ -e $f || -L $f ]] || return 0
    [[ -L $f && $(readlink -f "$f" 2>/dev/null) == "$DOTFILES"/* ]] && return 0
    log "backing up unowned $f -> $f.pre-stow"
    mv -f "$f" "$f.pre-stow"
}

log "role $role on $host"
mkdir -p "$STATE" && chmod 700 "$STATE"

# systemd user services (Paseo, hubd) need a lingering user manager and, over
# a non-interactive ssh session (exe.dev skips pam_systemd), XDG_RUNTIME_DIR.
[[ $(loginctl show-user "$USER" -p Linger --value 2>/dev/null) == yes ]] || sudo loginctl enable-linger "$USER"
for _ in $(seq 1 20); do [[ -d /run/user/$UID ]] && break; sleep 1; done
[[ -n ${XDG_RUNTIME_DIR:-} || ! -d /run/user/$UID ]] || export XDG_RUNTIME_DIR=/run/user/$UID

log "submodules"
git -C "$DOTFILES" submodule update --init --recursive

log "apt packages"
# A fresh cloud VM is still running cloud-init and unattended-upgrades, which
# hold the dpkg lock; wait for them instead of failing.
have cloud-init && { sudo cloud-init status --wait >/dev/null 2>&1 || true; }
APT=(sudo DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=900)
"${APT[@]}" update -qq
"${APT[@]}" install -y -qq --no-install-recommends \
    zsh stow fd-find bat eza zoxide direnv git-delta just \
    tmux vim ripgrep jq curl wget unzip build-essential python3 >/dev/null
ln -sfn /usr/bin/batcat "$BIN/bat"
ln -sfn /usr/bin/fdfind "$BIN/fd"
if [[ $(readlink -f /usr/bin/vim) == */nvim && -x /usr/bin/vim.basic ]]; then
    sudo update-alternatives --set vim /usr/bin/vim.basic
fi

install_release() {
    local name=$1 repo=$2 asset=$3 tmp ver
    have "$name" && [[ $(command -v "$name") == "$BIN/$name" ]] && return 0
    log "installing $name"
    ver=$(curl -fsSL "https://api.github.com/repos/$repo/releases/latest" | jq -r .tag_name)
    tmp=$(mktemp -d)
    curl -fsSL "https://github.com/$repo/releases/download/$ver/${asset//VERSION/${ver#v}}" | tar -xz -C "$tmp"
    install -m755 "$(find "$tmp" -name "$name" -type f -perm -u+x | head -1)" "$BIN/$name"
    rm -rf "$tmp"
}
install_release atuin atuinsh/atuin atuin-x86_64-unknown-linux-gnu.tar.gz
install_release lazygit jesseduffield/lazygit lazygit_VERSION_linux_x86_64.tar.gz
install_release fzf junegunn/fzf fzf-VERSION-linux_amd64.tar.gz

log "node"
if [[ ! -d $HOME/.nvm ]]; then
    PROFILE=/dev/null bash -c "$(curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/master/install.sh)"
fi
export NVM_DIR="$HOME/.nvm"
# shellcheck disable=SC1091
. "$NVM_DIR/nvm.sh"
nvm install --lts >/dev/null
nvm alias default "$(nvm current)" >/dev/null
# ~/.npmrc (stowed below) carries the supply-chain cooldown; stow first so the
# global installs here respect it.
backup_unowned "$HOME/.npmrc"
"$DOTFILES/shell/.local/bin/dotfiles-restow" shell paseo-machine0 >/dev/null 2>&1 || true

log "agents"
if [[ $host == exe ]]; then
    claude install latest
    sudo exeuntu update codex || true
    exeuntu update pi || true
else
    have claude && [[ $(command -v claude) == "$BIN/claude" ]] || curl -fsSL https://claude.ai/install.sh | bash
    have codex || npm install -g @openai/codex
    have pi || npm install -g @earendil-works/pi-coding-agent
fi
have opencode || npm install -g --allow-scripts=opencode-ai opencode-ai
have defuddle || npm install -g defuddle

log "host-local git and shell config"
if [[ $host == exe ]]; then
    write_managed "$HOME/.gitconfig.local" '# written by bootstrap-paseo-machine0 -- exe.dev host.
# GitHub goes through the exe.dev integration proxy (see bootstrap-exe).
[url "https://github.com/"]
	insteadOf = https://github.com/
[url "https://github.int.exe.xyz/justmytwospence/"]
	insteadOf = https://github.com/justmytwospence/
	insteadOf = git@github.com:justmytwospence/
	insteadOf = ssh://git@github.com/justmytwospence/
'
else
    # machine0 profile `paseo-machine0` connects GitHub (a GitHub App token for
    # gh). There is no SSH key, so cancel the shared ssh rewrite and use gh as
    # the credential helper. (`gh auth setup-git` would write into the stowed,
    # tracked ~/.gitconfig.)
    write_managed "$HOME/.gitconfig.local" '# written by bootstrap-paseo-machine0 -- machine0 host.
[url "https://github.com/"]
	insteadOf = https://github.com/
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
'
fi

# ~/.zshenv is read by every zsh, including the `zsh -c` the Paseo daemon,
# hubd and the hub's ssh commands run under, so the role, the brokered-auth file
# and the secrets reach the daemon and every agent it spawns.
zshenv="# written by bootstrap-paseo-machine0 -- paseo-machine0 $role on $host.
[[ -n \$XDG_RUNTIME_DIR || ! -d /run/user/\$UID ]] || export XDG_RUNTIME_DIR=/run/user/\$UID
export PASEO_MACHINE0_ROLE=$role
# pi-brokered-auth: openai-codex and radius come from the hub's broker.
export PI_BROKERED_AUTH_FILE=\$HOME/.config/paseo-machine0/brokered-auth.json
export PI_BROKERED_AUTH_PROVIDERS=openai-codex,radius
# The Claude setup-token and API keys (on the hub also MACHINE0_API_TOKEN).
[[ -r \$HOME/.config/paseo-machine0/secrets.env ]] && source \$HOME/.config/paseo-machine0/secrets.env
"
[[ $host == exe ]] && zshenv+="export GH_HOST=github.int.exe.xyz
"
write_managed "$HOME/.zshenv.local" "$zshenv"

log "stow"
# Base images ship their own shell and editor dotfiles (machine0's
# ubuntu-24-04-loaded has a ~/.zshrc); move every one stow needs aside.
for f in .gitconfig .hushlogin .zshrc .zshenv .zprofile .tmux.conf .vimrc .inputrc .npmrc; do
    backup_unowned "$HOME/$f"
done
backup_unowned "$HOME/.agents/AGENTS.md"
backup_unowned "$HOME/.claude/CLAUDE.md"
backup_unowned "$HOME/.codex/AGENTS.md"
backup_unowned "$HOME/.config/opencode/AGENTS.md"
backup_unowned "$HOME/.config/opencode/opencode.jsonc"
backup_unowned "$HOME/.claude/settings.json"
rc=0
"$DOTFILES/shell/.local/bin/dotfiles-restow" shell paseo-machine0 || rc=$?
case $rc in
    0) ;;
    1) log "stowed except for the conflicts listed above" ;;
    *) echo "stow failed" >&2; exit 1 ;;
esac

# The tracked Claude and Codex hooks call /usr/local/bin/moshi-hook and herdr's
# hook script; neither Moshi nor herdr runs here, so give them silent stand-ins.
log "hook stand-ins"
if [[ ! -e /usr/local/bin/moshi-hook ]]; then
    printf '#!/bin/sh\ncat >/dev/null 2>&1\nexit 0\n' | sudo tee /usr/local/bin/moshi-hook >/dev/null
    sudo chmod 755 /usr/local/bin/moshi-hook
fi
mkdir -p ~/.claude/hooks
[[ -e ~/.claude/hooks/herdr-agent-state.sh ]] ||
    printf '#!/bin/sh\n# written by bootstrap-paseo-machine0: no herdr on this host.\ncat >/dev/null 2>&1\nexit 0\n' \
        > ~/.claude/hooks/herdr-agent-state.sh

log "codex: managed worktrees off"
mkdir -p ~/.codex
codex features disable worktrees || true

log "pi: self-maintained plugins at their pins"
"$DOTFILES/shell/.local/bin/pi-plugin" sync || true

# exeuntu's pi asks once whether to use exe.dev's LLM integrations. Paseo runs
# pi in RPC mode, which cannot answer, so pi would exit at once; answer for it.
if [[ $host == exe && ! -e ~/.pi/agent/exe-dev-llm-integration.json ]]; then
    log "pi: configure pi myself (not exe.dev's LLM integrations)"
    printf '{\n  "version": 1,\n  "useExeIntegration": false\n}\n' > ~/.pi/agent/exe-dev-llm-integration.json
fi

log "pi packages"
timeout 900 pi update --extensions </dev/null >/dev/null 2>&1 || true

log "paseo-machine0 CLI"
ln -sfn "$PLUGIN/paseo-machine0" "$BIN/paseo-machine0"

log "paseo"
"$DOTFILES/shell/.local/bin/paseo-setup"

if [[ $role == hub ]]; then
    log "hub: Spokes plugin"
    paseo daemon config set pluginsEnabled true --json >/dev/null
    paseo reload --json >/dev/null 2>&1 || true
    if paseo plugin ls --json 2>/dev/null | jq -e 'any(.[]; .id == "machine0")' >/dev/null; then
        paseo plugin reload machine0 >/dev/null
    else
        paseo plugin install "$PLUGIN/paseo-plugin" >/dev/null
    fi

    log "hub: machine0 CLI"
    have machine0 || npm install -g @machine0/cli

    # The credential broker imports pi's SDK. exe.dev's pi is a compiled binary
    # with no JavaScript inside, so the broker gets a private npm copy.
    log "hub: pi SDK for the credential broker"
    sdk=~/.local/share/paseo-machine0/pi-sdk
    mkdir -p "$sdk"
    [[ -f $sdk/node_modules/@earendil-works/pi-coding-agent/dist/index.js ]] ||
        (cd "$sdk" && npm install --no-audit --no-fund --loglevel=error @earendil-works/pi-coding-agent)

    log "hub: ssh"
    [[ -f ~/.ssh/id_ed25519 ]] || ssh-keygen -q -t ed25519 -N '' -C "paseo-hub" -f ~/.ssh/id_ed25519
    mkdir -p ~/.ssh/config.d && chmod 700 ~/.ssh ~/.ssh/config.d
    touch ~/.ssh/config && chmod 600 ~/.ssh/config
    grep -qF 'Include ~/.ssh/config.d/*' ~/.ssh/config || \
        { printf 'Include ~/.ssh/config.d/*\n\n'; cat ~/.ssh/config; } > ~/.ssh/config.new && mv ~/.ssh/config.new ~/.ssh/config

    log "hub: hubd"
    unit=~/.config/systemd/user/paseo-machine0-hubd.service
    want="# written by bootstrap-paseo-machine0
[Unit]
Description=paseo-machine0 hubd (credential pushes, idle suspend, spoke status)
After=paseo.service

[Service]
Type=simple
# zsh -c reads ~/.zshenv: PATH, the role and secrets.env (MACHINE0_API_TOKEN).
ExecStart=$(command -v zsh) -c 'exec paseo-machine0 hubd'
Restart=on-failure
RestartSec=30
WorkingDirectory=%h

[Install]
WantedBy=default.target
"
    mkdir -p "$(dirname "$unit")"
    if [[ ! -f $unit || $(cat "$unit") != "${want%$'\n'}" ]]; then
        printf '%s' "$want" > "$unit"
        systemctl --user daemon-reload
    fi
    systemctl --user enable --now paseo-machine0-hubd.service >/dev/null 2>&1
    systemctl --user restart paseo-machine0-hubd.service
fi

log "memory guard"
"$DOTFILES/exe/bin/exe-memory-guard"

log "python"
have uv || curl -LsSf https://astral.sh/uv/install.sh | env UV_NO_MODIFY_PATH=1 sh
uv python install

log "common bootstrap"
"$DOTFILES/shell/.local/bin/bootstrap-common"

if [[ $role == hub ]]; then
    cat <<'EOF'

==> hub ready. Remaining steps need a human (README "Paseo spokes on machine0"):

  1. machine0: create an API token in the dashboard, then
       paseo-machine0 secrets set MACHINE0_API_TOKEN && exec zsh
     Once per account (skip what exists; `machine0 keys ls`, `machine0 profiles ls`):
       machine0 keys new paseo-hub --type PUBLIC --publicKeyPath ~/.ssh/id_ed25519.pub
       machine0 profiles new paseo-machine0
       # spokes must not get a fleet-wide machine0 key; setting these disables its injection
       machine0 env set MACHINE0_API_KEY=disabled-on-paseo-machine0-spokes MACHINE0_MCP_URL=disabled -p paseo-machine0
       machine0 integrations connect github -p paseo-machine0     # browser
  2. Claude subscription token (`claude setup-token` on any machine):
       paseo-machine0 secrets set CLAUDE_CODE_OAUTH_TOKEN      # stored under both names
  3. Broker logins (openai-codex, radius):  paseo-machine0 secrets login
  4. API keys:  paseo-machine0 secrets set MODEL_API_KEY ; paseo-machine0 secrets set TYPESAFE_API_KEY
  5. Give the hub's own daemon the secrets:
       systemctl --user restart paseo.service paseo-machine0-hubd.service
  6. Pair the hub: `paseo daemon pair --relay` here, scan it in the phone app;
     desktop: Settings, Add host, Remote SSH, ssh://paseo-hub.exe.xyz
  7. Golden image:  paseo-machine0 image build --fresh
  8. First spoke: Spokes screen, New spoke (or paseo-machine0 new demo --repo owner/repo), then Connect.
EOF
fi
