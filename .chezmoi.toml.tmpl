{{- /*
  Per-machine answers, asked once by `chezmoi init` and kept in
  ~/.config/chezmoi/chezmoi.toml. Answer without a prompt with
    chezmoi init --source ~/dotfiles --apply --promptChoice host=<host> --promptString extras=<list>
  README "Hosts" describes each host.
*/ -}}
{{- $hosts := list "mac-pro" "mac-air" "nuc" "exe" "m0-hub" "m0-spoke" "paseo-hub" "paseo-spoke" -}}
{{- /* The prompt text is the flag key (--promptChoice host=...), so it is the bare name. */ -}}
{{- $host := promptChoiceOnce . "host" "host" $hosts -}}
{{- /* Comma-separated: emacs, jupyter, linux-desktop; empty for none. */ -}}
{{- $extras := promptStringOnce . "extras" "extras" "" -}}
sourceDir = {{ .chezmoi.sourceDir | quote }}
encryption = "age"

[age]
identity = "~/.config/chezmoi/key.txt"
recipient = "age175qn2wp0ekscukgnw2mj703lankldttwyejg4rs76d5uker3tcrspadwxq"

[data]
host = {{ $host | quote }}
role = {{ if eq $host "mac-pro" }}"pro"{{ else }}"air"{{ end }}
extras = {{ $extras | quote }}

[diff]
exclude = ["scripts"]
