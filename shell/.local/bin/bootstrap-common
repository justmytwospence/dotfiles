#!/usr/bin/env bash
set -e

# set zsh as the default shell: Homebrew's on macOS, the distro's everywhere else
if [[ -x /opt/homebrew/bin/zsh ]]; then
    zsh_path="/opt/homebrew/bin/zsh"
elif [[ -x /usr/local/bin/zsh ]]; then
    zsh_path="/usr/local/bin/zsh"
else
    zsh_path="$(command -v zsh)"
fi
grep -qF "$zsh_path" /etc/shells || echo "$zsh_path" | sudo tee -a /etc/shells
# chsh authenticates as the user, which a passwordless account (an exe.dev or
# machine0 VM) cannot do, and with a terminal attached it waits for a password
# forever. Use passwordless sudo where there is one; otherwise ask as usual.
# Skip entirely when zsh is already the shell.
if [[ "$SHELL" != "$zsh_path" ]]; then
    if sudo -n true 2>/dev/null; then
        sudo chsh -s "$zsh_path" "$USER"
    else
        chsh -s "$zsh_path"
    fi
fi

# tmux plugin manager
if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
    git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
fi

# vim plugins
vim +PlugUpgrade +PlugUpdate +quitall

# agent skills: the canonical ~/.agents/skills directory plus the Claude Code
# bridge. Exits 2 without npx, which is not fatal to the rest of the bootstrap.
skills-install || true

# Vercel CLI, which the vercel-cli skill drives. The Mac gets it from the
# Brewfile; elsewhere it comes from npm, like opencode.
if ! command -v vercel >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then
    npm install -g --no-audit --no-fund --loglevel=error vercel || true
fi

# MCP servers: register the shared ~/.config/mcp/mcp.json set in Claude Code
# and Codex, which keep their own machine-local configs (pi and opencode are
# covered by tracked files). Sign-in stays interactive.
mcp-install || true
