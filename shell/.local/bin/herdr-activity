#!/bin/sh
# herdr-activity blocked|working|idle|clear
#
# Report this pane's agent state to herdr-attention-queue through the pane token
# `activity`, for harnesses whose state herdr has to read off the screen:
#
#   blocked  waiting on the user (a question or plan approval)
#   working  running a turn
#   idle     the turn is over (herdr reads Codex as unknown after a response)
#   clear    stop reporting; herdr's own reading applies again
#
# Meant for harness hooks (Claude Code, Codex). It drains the hook's JSON on
# stdin, never fails the hook, and does nothing outside herdr. herdr's own
# blocked always wins over a report. The token lives 24 h at most, so a crashed
# agent cannot leave it behind for long; SessionStart hooks clear it.
[ -t 0 ] || cat >/dev/null 2>&1
[ "${HERDR_ENV:-}" = 1 ] || exit 0
pane=${HERDR_PANE_ID:-}
bin=${HERDR_BIN_PATH:-}
[ -n "$pane" ] && [ -n "$bin" ] || exit 0

case "${1:-}" in
  blocked|working|idle) set -- --token "activity=$1" --ttl-ms 86400000 ;;
  clear) set -- --clear-token activity ;;
  *) echo "usage: herdr-activity blocked|working|idle|clear" >&2; exit 0 ;;
esac

"$bin" pane report-metadata "$pane" --source user:herdr-activity "$@" >/dev/null 2>&1
# Token changes emit no plugin event: ask the plugin to show it now, without
# making the harness wait.
("$bin" plugin action invoke attention-queue.refresh >/dev/null 2>&1 &)
exit 0
