{
  // opencode global config -- stowed to ~/.config/opencode/opencode.jsonc.
  //
  // opencode validates strictly and refuses to start on an invalid field, so
  // check https://opencode.ai/config.json before adding keys. It reads config
  // once at startup: quit and relaunch after editing.
  //
  // Not tracked here, because opencode and herdr own them: auth.json (in
  // ~/.local/share/opencode), plugins/herdr-agent-state.js, herdr-tui-session.js,
  // and tui.jsonc. Credentials never belong in this repo -- it is public.
  //
  // Skills need no config: opencode auto-loads ~/.claude/skills/<name>/SKILL.md
  // and ~/.agents/skills/<name>/SKILL.md, which is where `npx skills` installs.
  "$schema": "https://opencode.ai/config.json",

  // Ported from Claude Code's settings.json. opencode evaluates the LAST
  // matching rule, so the catch-all goes first and the allowances after it.
  // "edit": "allow" mirrors Claude Code's defaultMode "auto"; drop it to "ask"
  // if you want edits confirmed here but not there.
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "bat*": "allow",
      "bd *": "allow",
      "brew info*": "allow",
      "brew list*": "allow",
      "brew search*": "allow",
      "date*": "allow",
      "delta*": "allow",
      "df*": "allow",
      "diff*": "allow",
      "dig*": "allow",
      "du*": "allow",
      "env": "allow",
      "eza*": "allow",
      "file *": "allow",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "gh pr list*": "allow",
      "gh pr view*": "allow",
      "gh repo view*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "git blame*": "allow",
      "git branch*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git remote*": "allow",
      "git rev-parse*": "allow",
      "git show*": "allow",
      "git stash list*": "allow",
      "git status*": "allow",
      "git tag*": "allow",
      "herdr agent list*": "allow",
      "herdr api snapshot*": "allow",
      "herdr config check*": "allow",
      "herdr integration status*": "allow",
      "herdr pane list*": "allow",
      "herdr plugin list*": "allow",
      "herdr status*": "allow",
      "hostname*": "allow",
      "id": "allow",
      "jq *": "allow",
      "ls*": "allow",
      "lsof*": "allow",
      "man *": "allow",
      "npm info*": "allow",
      "npm list*": "allow",
      "npm root*": "allow",
      "npm run*": "allow",
      "npm test*": "allow",
      "ps*": "allow",
      "pwd": "allow",
      "pytest*": "allow",
      "realpath*": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "sw_vers*": "allow",
      "tree*": "allow",
      "type *": "allow",
      "uname*": "allow",
      "uv pip*": "allow",
      "wc *": "allow",
      "which *": "allow",
      "whoami": "allow"
    }
  },

  // Matches Claude Code's autoUpdatesChannel "latest".
  "autoupdate": true,
  // The login shell on every one of these machines.
  "shell": "/bin/zsh",
  // Nothing here gets shared to opencode's servers.
  "share": "disabled",

  // Plugins
  "plugin": ["@ex-machina/opencode-anthropic-auth"],

  // Single source for global preferences, shared with Claude Code (which reads
  // the file directly) and Codex (whose ~/.codex/AGENTS.md symlinks to it).
  "instructions": ["~/.claude/CLAUDE.md"],

  // Mirrors the user-scope servers Claude Code has in ~/.claude.json. The
  // tool-agnostic ~/.config/mcp/mcp.json covers pi; opencode does not read that
  // path, so these are declared again here. Remote servers authenticate
  // interactively with `opencode mcp auth <name>`.
  "mcp": {
    "obsidian": {
      "type": "remote",
      "url": "https://obsidian.mcp.spencerboucher.com/"
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp"
    },
    "paperless": {
      "type": "remote",
      "url": "https://paperless.mcp.spencerboucher.com/"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "chrome-devtools-mcp@latest",
        "--browserUrl=http://127.0.0.1:5858",
        "--experimentalIncludeAllPages=true",
        "--categoryEmulation=false"
      ]
    }
  }
}
