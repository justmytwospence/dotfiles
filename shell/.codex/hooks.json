{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.superset/hooks/notify.sh\" ]; then SUPERSET_AGENT_ID=codex \"$HOME/.superset/hooks/notify.sh\"; fi",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "if [ -f \"$HOME/.codex/herdr-agent-state.sh\" ]; then bash \"$HOME/.codex/herdr-agent-state.sh\" session; fi",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.local/share/plugins/tmux-agents/bin/agent-state\" clear",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "'/usr/local/bin/moshi-hook' codex-hook",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$HOME/.local/share/plugins/herdr-attention-queue/attention.py\" activity clear",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.superset/hooks/notify.sh\" ]; then SUPERSET_AGENT_ID=codex \"$HOME/.superset/hooks/notify.sh\"; fi",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.local/share/plugins/tmux-agents/bin/agent-state\" done",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "'/usr/local/bin/moshi-hook' codex-hook",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$HOME/.local/share/plugins/herdr-attention-queue/attention.py\" ask-check --report --else idle",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.superset/hooks/notify.sh\" ]; then SUPERSET_AGENT_ID=codex \"$HOME/.superset/hooks/notify.sh\"; fi",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.local/share/plugins/tmux-agents/bin/agent-state\" running",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "'/usr/local/bin/moshi-hook' codex-hook",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$HOME/.local/share/plugins/herdr-attention-queue/attention.py\" activity working",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.local/share/plugins/tmux-agents/bin/agent-state\" running",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.local/share/plugins/tmux-agents/bin/agent-state\" clear",
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "'/usr/local/bin/moshi-hook' codex-hook",
            "type": "command"
          }
        ]
      }
    ]
  }
}
