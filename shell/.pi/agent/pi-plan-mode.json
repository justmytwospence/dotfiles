{
  "toggleShortcut": "shift+tab",
  "defaultPlanTools": [
    "read",
    "bash",
    "grep",
    "find",
    "ls",
    "web_search",
    "fetch_content",
    "get_search_content",
    "mcp"
  ],
  "implementationModelMap": {
    "anthropic/claude-fable-5-1": "anthropic/claude-opus-5-5:high",
    "anthropic/claude-opus-5-5": "anthropic/claude-sonnet-5:high",
    "openai-codex/gpt-6-astra": "openai-codex/gpt-6-sol:high"
  },
  "planners": [
    "anthropic/claude-fable-5-1:xhigh",
    "openai-codex/gpt-6-astra:xhigh"
  ],
  "scoutModelMap": {
    "anthropic/claude-fable-5-1": "anthropic/claude-opus-5-5:high",
    "openai-codex/gpt-6-astra": "openai-codex/gpt-6-sol:high"
  },
  "plannerToolsets": {
    "web": {
      "label": "Web research",
      "description": "Web search and page fetching: library and API documentation, release notes and version facts, known bugs, standards, prior art.",
      "extensions": [
        "~/.pi/agent/npm/node_modules/pi-web-access"
      ],
      "tools": [
        "web_search",
        "fetch_content",
        "get_search_content"
      ]
    },
    "mcp": {
      "label": "MCP servers",
      "description": "Connected services: Context7 library documentation, the user's Obsidian notes, Paperless documents, Figma designs, and a Chrome browser for inspecting live pages.",
      "extensions": [
        "~/.pi/agent/npm/node_modules/pi-mcp-adapter"
      ],
      "tools": [
        "mcp"
      ]
    }
  },
  "planCompleteCommand": [
    "bash",
    "~/.claude/hooks/save-plan-to-obsidian.sh"
  ]
}
