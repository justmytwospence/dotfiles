<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  herdr-attention-queue's notifier: clickable desktop notifications for agents
  on every herdr machine (Local, NUC, exe.dev), replacing herdr-focus-notify.
  Log: ~/.local/state/herdr/plugins/attention-queue/notifier/notifier.log.
  /usr/bin/python3 keeps a stable identity for the Automation permission that
  lets the notifier focus Ghostty.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.spencerboucher.herdr-attention-notifier</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>-B</string>
		<string>/Users/spencerboucher/.local/share/plugins/herdr-attention-queue/attention.py</string>
		<string>notifier</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardErrorPath</key>
	<string>/Users/spencerboucher/Library/Logs/herdr-attention-notifier.log</string>
</dict>
</plist>
