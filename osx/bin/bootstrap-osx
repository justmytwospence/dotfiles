#!/usr/bin/env bash
# Usage: bootstrap-osx [pro|air]
#   The Mac's role selects the Brewfile slice (README "Mac roles"): pro adds the
#   heavy desk-only block, air (the default) is the travel subset. Given an
#   argument, it is saved as DOTFILES_ROLE in ~/.zshenv.local; without one, the
#   role already saved there is used.
set -e

role=${1-}
case $role in
    pro|air|'') ;;
    *) echo "usage: bootstrap-osx [pro|air]" >&2; exit 2 ;;
esac
if [[ -n $role ]]; then
    touch "$HOME/.zshenv.local"
    sed -i '' '/^export DOTFILES_ROLE=/d' "$HOME/.zshenv.local"
    echo "export DOTFILES_ROLE=$role" >> "$HOME/.zshenv.local"
else
    role=$(sed -n 's/^export DOTFILES_ROLE=//p' "$HOME/.zshenv.local" 2>/dev/null | tail -1)
fi
# brew passes only HOMEBREW_* variables into the Brewfile's Ruby
export HOMEBREW_DOTFILES_ROLE=${role:-air}
echo "Mac role: $HOMEBREW_DOTFILES_ROLE"

# install Xcode Command Line Tools (needed for git, compilers)
if ! xcode-select -p &>/dev/null; then
    echo "Installing Xcode Command Line Tools..."
    xcode-select --install
    echo "Press any key after Xcode CLT installation completes."
    read -n 1
fi

# install Homebrew
if ! command -v brew &>/dev/null; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# set up Homebrew in current shell (Apple Silicon vs Intel)
if [[ -d /opt/homebrew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"  # Apple Silicon
else
    eval "$(/usr/local/bin/brew shellenv)"  # Intel
fi

# stow dotfiles
brew install stow
stow shell --dir "$HOME/dotfiles"
stow osx --dir "$HOME/dotfiles"

# install everything
brew bundle install --global

# register herdr's Claude Code integration hook (idempotent). The installer
# regenerates the herdr-managed ~/.claude/hooks/herdr-agent-state.sh (not tracked
# here) but also rewrites settings.json with a machine-absolute hook path; restore
# the tracked, portable $HOME wiring afterward so it stays correct across machines.
if command -v herdr &>/dev/null; then
    herdr integration install claude
    git -C "$HOME/dotfiles" checkout -- shell/.claude/settings.json
fi

# Codex's managed worktrees (codex --worktree, /worktree) live in one global
# pool. Worktrees here go in <project>/.worktrees through ~/.local/bin/worktree
# (README "Coding agents"), so switch Codex's off. ~/.codex/config.toml is
# machine-local, hence here rather than in the repo.
if command -v codex &>/dev/null; then
    codex features disable worktrees
fi

# self-maintained plugins (pi packages, herdr plugins, tmux-agents) at the commits
# dotfiles pins (README "Plugins")
"$HOME/dotfiles/shell/.local/bin/plugins" sync

# moshi-hook daemon, the /usr/local/bin link the tracked agent hooks call, and
# the pi/opencode hooks (idempotent; pairing with the phone is printed, not done)
"$HOME/dotfiles/shell/.local/bin/moshi-setup"

# always-on Paseo daemon (launchd) for the Paseo phone and desktop apps
"$HOME/dotfiles/shell/.local/bin/paseo-setup"

# Heeler herdr plugin: pairing QR and pushes for the Heeler iOS app
"$HOME/dotfiles/shell/.local/bin/heeler-setup"

# install default Python
uv python install

# install Rust stable toolchain
rustup default stable

# common setup (zsh default shell, vim plugins)
bootstrap-common

# macOS defaults
defaults write NSGlobalDomain KeyRepeat -int 2
defaults write NSGlobalDomain InitialKeyRepeat -int 15
defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false

defaults write com.apple.dock autohide -bool true
defaults write com.apple.dock autohide-delay -float 0
defaults write com.apple.dock autohide-time-modifier -float 0.3
defaults write com.apple.dock mru-spaces -bool false
defaults write com.apple.dock show-recents -bool false
defaults write com.apple.dock tilesize -int 48

defaults write com.apple.finder AppleShowAllExtensions -bool true
defaults write com.apple.finder ShowPathbar -bool true
defaults write com.apple.finder ShowStatusBar -bool true
defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false

defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false
defaults write NSGlobalDomain NSAutomaticDashSubstitutionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false

defaults write com.apple.screencapture disable-shadow -bool true
defaults write com.apple.screencapture type -string "png"

defaults write com.apple.AppleMultitouchTrackpad TrackpadThreeFingerDrag -bool true
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadThreeFingerDrag -bool true

killall Dock Finder 2>/dev/null || true
