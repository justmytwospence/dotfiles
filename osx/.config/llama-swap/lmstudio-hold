#!/bin/sh
# llama-swap's process for the LM Studio model (config.yaml "qwen3.8-27b").
# LM Studio is a long-lived app, so there is no server for llama-swap to start
# and stop. This makes sure LM Studio's server is up, then stands in for the
# model while llama-swap considers it running. The first proxied request
# JIT-loads the model with its saved defaults (osx/.lmstudio/.internal/
# user-concrete-model-default-config). When llama-swap stops this process
# (ttl expiry, unload, or a swap to MTPLX), it unloads everything in LM Studio,
# so the two 27B models are never resident together.
set -u
LMS=/Users/spencerboucher/.lmstudio/bin/lms
[ -x "$LMS" ] || LMS=lms

"$LMS" server start >/dev/null 2>&1 || exit 1

stop() {
  "$LMS" unload --all >/dev/null 2>&1
  exit 0
}
trap stop TERM INT HUP

while :; do
  sleep 3600 &
  wait $!
done
