#!/usr/bin/env bash
# skills-install -- install this machine's agent skills into one directory.
#
# Every skill lives in ~/.agents/skills, which is the cross-vendor convention:
# Codex, Zed, opencode and pi all read it with no configuration at all.
# Claude Code is the exception -- it reads only ~/.claude/skills and has no
# setting for additional roots -- so that path is a single symlink to the
# canonical directory. One link for the whole set, not one per skill, which is
# why adding or removing a skill needs no sync step anywhere.
#
# Third-party skills come from `npx skills`, which copies each into
# ~/.agents/skills and records it in ~/.agents/.skill-lock.json. Personal
# skills are authored in dotfiles under dot_agents/skills/<name>/ and written
# into the same directory by chezmoi, so both kinds sit side by side and every
# harness sees one list. The ~/.claude/skills link is chezmoi's too
# (dot_claude/symlink_skills); this script only checks it.
#
# Two rules this script exists to enforce, both learned the hard way:
#
# Every add passes an explicit `-a claude-code`. Without it the CLI installs
# to every agent whose config directory it can detect and leaves behind a
# directory of per-skill symlinks for each one (~/.pi/agent/skills,
# ~/.codeium/windsurf/skills, ~/.snowflake/cortex/skills, ~/.kiro/skills and
# so on). Every one of those is redundant -- those agents already read
# ~/.agents/skills -- and they drift, because each is only as complete as the
# install that happened to create it. Detection keys off directories that
# exist for unrelated reasons, so the only way to stop it is the flag.
#
# `skills update` is never used. It respawns its work as `add` with no `-a`,
# so it recreates exactly that fan-out and takes no flag to prevent it. `add`
# reinstalls each skill from source and is idempotent, so re-running this
# script IS the update. The list below, not the lock file, defines what this
# machine should have: the CLI discards the lock outright when its format
# version changes.
#
# Usage: skills-install
#
# Exit:  0  canonical directory and Claude Code bridge in place, sources installed
#        1  ~/.claude/skills is occupied by something this script will not remove
#        2  npx is unavailable; the bridge is in place but nothing was installed

set -uo pipefail

canonical="$HOME/.agents/skills"
bridge="$HOME/.claude/skills"

# "<repo> [skill ...]" -- no skill names means take every skill in the repo.
sources=(
    "boldsoftware/exe.dev"
    "vercel-labs/skills                find-skills"
    "steipete/clawdis                  tmux"
    "vercel/vercel                     vercel-cli"
    "stablyai/orca                     orca-cli orchestration"
)

mkdir -p "$canonical" "$HOME/.claude"

# Claude Code follows a symlinked skills root; it refuses one only deeper, at
# skills/synced, which is Anthropic's own sync area and not ours.
if [ -L "$bridge" ]; then
    if [ "$(cd "$bridge" && pwd -P)" != "$(cd "$canonical" && pwd -P)" ]; then
        echo "skills-install: $bridge points elsewhere: $(readlink "$bridge")" >&2
        exit 1
    fi
elif [ ! -e "$bridge" ]; then
    ln -s ../.agents/skills "$bridge"
elif [ -d "$bridge" ] && [ -z "$(ls -A "$bridge")" ]; then
    rmdir "$bridge" && ln -s ../.agents/skills "$bridge"
else
    echo "skills-install: $bridge is a non-empty directory. Move anything worth" >&2
    echo "  keeping into $canonical, remove the rest, then run this again." >&2
    exit 1
fi

status=0

if ! command -v npx >/dev/null 2>&1; then
    echo "skills-install: npx is not installed; skipping skill installs" >&2
    exit 2
fi

for entry in "${sources[@]}"; do
    read -r repo names <<<"$entry"
    # shellcheck disable=SC2086  # names is a deliberate word list
    if ! npx --yes skills@latest add "$repo" -g -y -a claude-code ${names:+-s $names}; then
        echo "skills-install: failed to install from $repo" >&2
        status=1
    fi
done

printf '\n%s\n' "$canonical:"
ls -1 "$canonical"

exit $status
