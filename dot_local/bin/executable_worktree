#!/usr/bin/env bash
# worktree -- the one way git worktrees get made here, whatever the harness.
#
# Checkouts live in <project>/.worktrees/<branch-slug>, next to the code they
# belong to. The global gitignore (~/.config/git/ignore) hides /.worktrees/, and
# the dot keeps pytest, pyright and tsc from scanning the copies. Where the new
# checkout opens depends on where this runs:
#
#   herdr-machine0 spoke a new pane on the hub, in the spoke's herdr space
#                        (`spoke open-slot`; the hub's herdr is remote)
#   herdr (HERDR_ENV=1)  a child space grouped under the repo's space
#   tmux ($TMUX)         a new window
#   anything else        nowhere; the path is printed
#
# A new space or window starts $WORKTREE_AGENT (default: pi) unless --no-agent,
# and takes focus only with --focus (or WORKTREE_FOCUS=1), so an agent calling
# this does not yank the screen away from you.
# stdout carries only the checkout path, so `cd "$(worktree path foo)"` and
# hooks can consume it; everything human-readable goes to stderr.
#
# Callers: the shell, herdr's prefix+G popup (`worktree popup`), pi's
# /worktree extension and pi-subagents, opencode's /worktree command, Claude
# Code's and Claude Desktop's WorktreeCreate/WorktreeRemove hooks (`worktree
# hook claude-*`), the paseo-machine0 skill, and any agent following
# ~/.agents/AGENTS.md. Tools that can't call it are pointed at the same
# directory or switched off (~/dotfiles docs/agents.md "Worktrees"). Needs git;
# herdr mode and hooks also need jq.
set -euo pipefail

prog=${0##*/}

usage() {
  cat >&2 <<EOF
usage:
  $prog new <branch> [--name DIR] [--base REF] [--focus] [--no-open] [--no-agent] [--agent CMD]
  $prog open <branch|name|path> [--focus] [--no-agent] [--agent CMD]
  $prog rm <branch|name|path> [--force] [--delete-branch]
  $prog ls
  $prog path <branch|name|path>
  $prog clean                     # drop finished Claude subagent worktrees
  $prog link [--all | <repo>]     # point herdr's sidebar worktrees at .worktrees
  $prog popup                     # interactive; bound to herdr prefix+G
  $prog hook claude-create        # Claude Code WorktreeCreate (JSON on stdin)
  $prog hook claude-remove        # Claude Code WorktreeRemove (JSON on stdin)
  $prog hook claude-subagent-stop # Claude Code SubagentStop (JSON on stdin)

new     create <project>/.worktrees/<DIR> (default: the branch, slashes as
        dashes) on <branch>: checks out a local
        branch, tracks a unique remote branch, or creates it from --base
        (default: the current HEAD). Copies untracked files matched by
        .worktreeinclude. Opens it (see header) unless --no-open. If the
        checkout already exists, just opens it.
open    open an existing worktree of this repo.
rm      remove a worktree checkout (closing its herdr space). Branches are kept
        unless --delete-branch (git branch -d; -D with --force).
clean   remove this repo's Claude subagent worktrees (branch worktree-agent-*)
        that hold no uncommitted changes and no commits of their own.
link    make the repo's directory under herdr's global worktree root a symlink
        to <repo>/.worktrees, so herdr's sidebar "New worktree" lands there
        too. --all: every repo in ~/Projects and ~/dotfiles, and drop links
        whose repo is gone. new links the repo it touches; a global git
        post-checkout hook links fresh clones.
EOF
}

die() { printf '%s: %s\n' "$prog" "$*" >&2; exit 1; }
say() { printf '%s\n' "$*" >&2; }

# ---------------------------------------------------------------- repo helpers

# Main worktree of the repository containing $1. Worktrees are always created
# relative to it, even when the caller sits in a linked worktree.
main_root() {
  local dir=${1:-.} porcelain
  porcelain=$(git -C "$dir" worktree list --porcelain 2>/dev/null) ||
    die "not in a git repository: $dir"
  [ "$(printf '%s\n' "$porcelain" | sed -n 2p)" != bare ] ||
    die "bare repositories are not supported"
  printf '%s\n' "$porcelain" | sed -n '1s/^worktree //p'
}

slugify() {
  printf '%s' "$1" | tr '/' '-' | LC_ALL=C tr -c 'A-Za-z0-9._-' '-' | sed 's/^[-.]*//'
}

realdir() { (cd "$1" 2>/dev/null && pwd -P); }

# Print "path<TAB>branch" for every linked worktree of the repo at $1.
list_linked() {
  git -C "$1" worktree list --porcelain | awk '
    /^worktree / { p = substr($0, 10); b = "" }
    /^branch /   { b = substr($0, 8); sub("^refs/heads/", "", b) }
    /^$/         { if (p != "") print p "\t" b; p = "" }
    END          { if (p != "") print p "\t" b }' | tail -n +2
}

# Resolve a worktree by path, branch, or directory name. Prints its path.
resolve() {
  local root=$1 want=$2 real="" path branch
  [ -d "$want" ] && real=$(realdir "$want")
  while IFS=$'\t' read -r path branch; do
    if { [ -n "$real" ] && [ "$(realdir "$path")" = "$real" ]; } ||
       [ "$branch" = "$want" ] || [ "${path##*/}" = "$want" ] ||
       [ "${path##*/}" = "$(slugify "$want")" ]; then
      printf '%s\n' "$path"; return 0
    fi
  done < <(list_linked "$root")
  return 1
}

# Create the checkout: an existing local branch as is, a branch that exists on
# exactly one remote as a tracking branch, else a new branch from $4 (explicit
# --base) or $5 (the caller's HEAD). Git's own chatter goes to stderr.
git_add() {
  local root=$1 path=$2 branch=$3 base=$4 fallback=$5 remotes
  if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$root" worktree add "$path" "$branch" >&2
    return
  fi
  if [ -z "$base" ]; then
    remotes=$(git -C "$root" for-each-ref --format='%(refname:short)' "refs/remotes/*/$branch")
    if [ -n "$remotes" ] && [ "$(printf '%s\n' "$remotes" | wc -l)" -eq 1 ]; then
      git -C "$root" worktree add --track -b "$branch" "$path" "$remotes" >&2
      return
    fi
  fi
  git -C "$root" worktree add -b "$branch" "$path" "${base:-$fallback}" >&2
}

# Claude Code's .worktreeinclude convention, for every harness: copy untracked
# files matching its patterns (.env and friends) into the new checkout.
copy_includes() {
  local root=$1 path=$2 f
  [ -f "$root/.worktreeinclude" ] || return 0
  while IFS= read -r -d '' f; do
    case $f in .worktrees/*) continue ;; esac
    mkdir -p "$path/$(dirname "$f")"
    cp -p "$root/$f" "$path/$f"
    say "copied $f"
  done < <(git -C "$root" ls-files -z --others --ignored --exclude-from=.worktreeinclude)
}

# ---------------------------------------------------------------- links

# herdr's sidebar "New worktree" uses one global root, <[worktrees] directory>/
# <repo dir name>/<branch>. Making each repo's directory there a symlink to
# <repo>/.worktrees puts those checkouts in .worktrees too: git resolves the
# link and records the real path, and herdr matches its spaces by real path.
# Other single-root tools were tried and are not linked: Paseo refuses to
# manage a checkout whose real path leaves its root, and OpenCode Desktop 1.18
# lists such a checkout twice (v2 reads worktree.directory from opencode.jsonc).
HERDR_WORKTREES=${HERDR_WORKTREES:-$HOME/.herdr/worktrees}

# Make $1 a symlink to $2, unless something real is already there.
link_dir() {
  local link=$1 want=$2 have
  if [ -L "$link" ]; then
    have=$(readlink "$link")
    [ "$have" = "$want" ] && return 0
    if [ -e "$have" ]; then
      say "left $link alone: it points to $have, not $want"; return 0
    fi
    rm -f "$link"
  elif [ -d "$link" ]; then
    if [ -n "$(ls -A "$link")" ]; then
      say "left $link alone: it holds checkouts made before linking (git worktree move them into $want, remove the directory, then rerun)"
      return 0
    fi
    rmdir "$link"
  elif [ -e "$link" ]; then
    say "left $link alone: not a directory"; return 0
  fi
  mkdir -p "$(dirname "$link")" && ln -s "$want" "$link"
}

link_repo() {
  local root=$1
  [ -d "$HOME/.herdr" ] || [ -d "$HERDR_WORKTREES" ] || return 0
  mkdir -p "$root/.worktrees"
  link_dir "$HERDR_WORKTREES/$(basename "$root")" "$root/.worktrees"
}

# Repositories that get links: the ones you work in, not every clone in /tmp.
linkable() {
  local home; home=$(realdir "$HOME")  # git reports real paths
  case $1 in "$home"/Projects/*|"$home/dotfiles") return 0 ;; esac
  return 1
}

cmd_link() {
  local d root link
  if [ "${1:-}" = --all ]; then
    [ -d "$HOME/.herdr" ] || [ -d "$HERDR_WORKTREES" ] || return 0
    for d in "$HOME"/Projects/*/ "$HOME/dotfiles/"; do
      [ -e "$d.git" ] || continue
      # Already linked: skip the git calls, so this stays cheap on every apply.
      [ "$(readlink "$HERDR_WORKTREES/$(basename "$d")" 2>/dev/null)" = "${d%/}/.worktrees" ] &&
        [ -d "$d.worktrees" ] && continue
      root=$(main_root "$d" 2>/dev/null) || continue
      [ "$(realdir "$root")" = "$(realdir "$d")" ] || continue  # a linked worktree, not a repo
      link_repo "$root"
    done
    for link in "$HERDR_WORKTREES"/*; do
      if [ -L "$link" ] && [ ! -e "$link" ]; then
        case $(readlink "$link") in */.worktrees) rm -f "$link" ;; esac
      fi
    done
    return 0
  fi
  root=$(main_root "${1:-.}")
  link_repo "$root"
}

# ---------------------------------------------------------------- openers

in_spoke() {
  [ "${HERDR_MACHINE0_ROLE:-}" = spoke ] && [ -n "${HERDR_SOCKET_PATH:-}" ] && command -v spoke >/dev/null 2>&1
}

# On a spoke HERDR_ENV points at the hub's relay, which only takes reports.
in_herdr() {
  [ "${HERDR_ENV:-}" = 1 ] && ! in_spoke && command -v herdr >/dev/null 2>&1 && command -v jq >/dev/null 2>&1
}

open_spoke() {
  local path=$1 focus=$2 agent=$3 args
  if [ -z "$agent" ]; then
    say "on a spoke a new hub pane always runs an agent; skipped (--no-agent): cd $path"
    return
  fi
  args=(open-slot --cwd "$path" --label "$(basename "$path")")
  case $agent in pi|claude|codex|opencode) args+=(--harness "$agent") ;; esac
  [ "$focus" = 1 ] && args+=(--focus)
  spoke "${args[@]}" >&2 || die "spoke open-slot failed"
}

open_herdr() {
  local root=$1 path=$2 focus=$3 agent=$4 res pane
  res=$(herdr worktree open --cwd "$root" --path "$path" "$([ "$focus" = 1 ] && echo --focus || echo --no-focus)") ||
    die "herdr worktree open failed"
  if [ "$(jq -r '.result.already_open' <<<"$res")" = true ]; then
    say "herdr: already open as $(jq -r '.result.workspace.workspace_id' <<<"$res")"
    return
  fi
  pane=$(jq -r '.result.root_pane.pane_id // empty' <<<"$res")
  say "herdr: opened $(jq -r '.result.workspace.workspace_id' <<<"$res")"
  if [ -n "$agent" ] && [ -n "$pane" ]; then
    herdr pane run "$pane" "$agent" >/dev/null && say "herdr: started $agent in $pane"
  fi
}

open_tmux() {
  local path=$1 focus=$2 agent=$3 pane
  pane=$(tmux new-window -P -F '#{pane_id}' $([ "$focus" = 1 ] || echo -d) \
    -c "$path" -n "$(basename "$path")")
  say "tmux: opened window $pane"
  [ -z "$agent" ] || tmux send-keys -t "$pane" "$agent" Enter
}

open_somewhere() {
  local root=$1 path=$2 focus=$3 agent=$4
  if in_spoke; then open_spoke "$path" "$focus" "$agent"
  elif in_herdr; then open_herdr "$root" "$path" "$focus" "$agent"
  elif [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then open_tmux "$path" "$focus" "$agent"
  else say "not in herdr or tmux, so nothing opened: cd $path"
  fi
}

# ---------------------------------------------------------------- commands

cmd_new() {
  local branch="" name="" base="" focus=${WORKTREE_FOCUS:-0} open=1 agent=${WORKTREE_AGENT-pi}
  while [ $# -gt 0 ]; do
    case $1 in
      --name) name=${2:?--name needs a directory name}; shift ;;
      --base) base=${2:?--base needs a ref}; shift ;;
      --focus) focus=1 ;;
      --no-focus) focus=0 ;;
      --no-open) open=0 ;;
      --no-agent) agent="" ;;
      --agent) agent=${2?--agent needs a command}; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) die "unknown option: $1" ;;
      *) [ -z "$branch" ] || die "one branch at a time"; branch=$1 ;;
    esac
    shift
  done
  [ -n "$branch" ] || { usage; exit 2; }
  git check-ref-format --branch "$branch" >/dev/null 2>&1 || die "invalid branch name: $branch"

  local root path existing
  root=$(main_root .)
  path="$root/.worktrees/$(slugify "${name:-$branch}")"
  if existing=$(resolve "$root" "$branch"); then
    say "exists: $existing"
    path=$existing
  else
    [ ! -e "$path" ] || die "$path exists but is not a worktree of $root"
    mkdir -p "$root/.worktrees"
    { linkable "$root" && link_repo "$root"; } || true
    # A new branch forks from whatever the caller is on, not the main
    # checkout's HEAD.
    git_add "$root" "$path" "$branch" "$base" "$(git rev-parse --verify HEAD)"
    copy_includes "$root" "$path"
  fi
  [ "$open" = 0 ] || open_somewhere "$root" "$path" "$focus" "$agent"
  printf '%s\n' "$path"
}

cmd_open() {
  local want="" focus=${WORKTREE_FOCUS:-0} agent=${WORKTREE_AGENT-pi}
  while [ $# -gt 0 ]; do
    case $1 in
      --focus) focus=1 ;;
      --no-focus) focus=0 ;;
      --no-agent) agent="" ;;
      --agent) agent=${2?--agent needs a command}; shift ;;
      -*) die "unknown option: $1" ;;
      *) want=$1 ;;
    esac
    shift
  done
  [ -n "$want" ] || { usage; exit 2; }
  local root path
  root=$(main_root .)
  path=$(resolve "$root" "$want") || die "no worktree matching '$want' (try: $prog new $want)"
  open_somewhere "$root" "$path" "$focus" "$agent"
  printf '%s\n' "$path"
}

cmd_rm() {
  local want="" force=0 delbranch=0
  while [ $# -gt 0 ]; do
    case $1 in
      --force|-f) force=1 ;;
      --delete-branch) delbranch=1 ;;
      -*) die "unknown option: $1" ;;
      *) want=$1 ;;
    esac
    shift
  done
  [ -n "$want" ] || { usage; exit 2; }
  local root path branch ws="" p w
  root=$(main_root "$( [ -d "$want" ] && echo "$want" || echo .)")
  path=$(resolve "$root" "$want") || die "no worktree matching '$want'"
  branch=$(git -C "$path" symbolic-ref --quiet --short HEAD || true)

  if in_herdr; then
    while IFS=$'\t' read -r p w; do
      [ "$(realdir "$p")" = "$(realdir "$path")" ] && ws=$w
    done < <(herdr worktree list --cwd "$root" |
      jq -r '.result.worktrees[] | select(.open_workspace_id) | [.path, .open_workspace_id] | @tsv')
  fi
  if [ -n "$ws" ]; then
    herdr worktree remove --workspace "$ws" $([ "$force" = 1 ] && echo --force) >/dev/null ||
      die "herdr refused to remove $path (dirty? retry with --force)"
    say "removed $path (closed herdr space $ws)"
  else
    git -C "$root" worktree remove $([ "$force" = 1 ] && echo --force) "$path" >&2 ||
      die "git refused to remove $path (retry with --force to discard its changes)"
    say "removed $path"
  fi
  if [ "$delbranch" = 1 ] && [ -n "$branch" ]; then
    git -C "$root" branch $([ "$force" = 1 ] && echo -D || echo -d) "$branch" >&2
  fi
}

# Claude Code auto-removes the subagent worktrees it makes itself, but keeps
# every one a WorktreeCreate hook made (its cleanup gives up on hook-based
# checkouts), so without this they pile up as .worktrees/agent-<id>. Remove
# one only when it is a Claude subagent checkout (branch worktree-agent-*),
# unlocked, clean, and has no commits that no other ref holds.
reap_agent() {
  local root=$1 path=$2 branch
  [ -d "$path" ] || return 0
  branch=$(git -C "$path" symbolic-ref --quiet --short HEAD) || return 0
  case $branch in worktree-agent-*) ;; *) return 0 ;; esac
  if git -C "$root" worktree list --porcelain |
     awk -v p="$path" '$0 == "worktree " p { f = 1 } f && /^locked/ { l = 1 } /^$/ { f = 0 } END { exit !l }'; then
    say "kept $path: locked"; return 0
  fi
  if [ -n "$(git -C "$path" status --porcelain)" ]; then
    say "kept $path: uncommitted changes"; return 0
  fi
  if [ -n "$(git -C "$root" rev-list "$branch" --not --exclude="$branch" --branches --remotes --tags)" ]; then
    say "kept $path: commits on $branch"; return 0
  fi
  git -C "$root" worktree remove "$path" >&2 && git -C "$root" branch -D "$branch" >/dev/null &&
    say "removed $path"
}

cmd_clean() {
  local root path branch
  root=$(main_root .)
  while IFS=$'\t' read -r path branch; do
    case $branch in worktree-agent-*) reap_agent "$root" "$path" ;; esac
  done < <(list_linked "$root")
}

cmd_popup() {
  # herdr runs this in a popup with no pane of its own: the target repo is the
  # one under the focused pane (HERDR_ACTIVE_PANE_CWD, else ask herdr).
  export HERDR_ENV=1
  local cwd=${HERDR_ACTIVE_PANE_CWD:-} branch
  [ -n "$cwd" ] ||
    cwd=$(herdr pane current | jq -r '.result.pane.foreground_cwd // .result.pane.cwd // empty')
  if [ -z "$cwd" ] || ! root=$(main_root "$cwd" 2>/dev/null); then
    say "The focused pane is not in a git repository${cwd:+ ($cwd)}."
    read -r -p "Press enter to close. " _ || true
    exit 0
  fi
  say "New worktree in $root/.worktrees/"
  say "Existing: $(list_linked "$root" | cut -f2 | tr '\n' ' ')"
  read -r -p "Branch (empty to cancel): " branch || exit 0
  [ -n "$branch" ] || exit 0
  if ! (cd "$cwd" && cmd_new "$branch" --focus >/dev/null); then
    read -r -p "Press enter to close. " _ || true
  fi
}

# Claude Code replaces its own `git worktree add` with these when configured
# (~/.claude/settings.json). Its sessions and isolated subagents run inside the
# checkout themselves, so nothing is opened: create, print the path, done.
cmd_hook() {
  # git's post-checkout, from the global git config (hook.worktree-link): after a
  # clone (old HEAD all zeros, branch checkout) link the new repository, so a
  # tool's first worktree in it already lands in .worktrees. Never fails, never
  # prints: whatever ran git sees nothing.
  if [ "${1:-}" = git-post-checkout ]; then
    case ${2:-} in *[!0]*|"") exit 0 ;; esac
    local root
    root=$(main_root . 2>/dev/null) || exit 0
    if linkable "$root"; then link_repo "$root" >/dev/null 2>&1 || true; fi
    exit 0
  fi
  command -v jq >/dev/null 2>&1 || die "jq is required for hooks"
  local input; input=$(cat)
  case ${1:-} in
    claude-create)
      local name cwd root path
      name=$(jq -r '.name // empty' <<<"$input")
      cwd=$(jq -r '.cwd // empty' <<<"$input")
      [ -n "$name" ] || die "WorktreeCreate input has no name"
      cd "${cwd:-.}"
      # Claude's own branch naming for --worktree sessions; the directory keeps
      # the bare name Claude generated.
      cmd_new "worktree-$name" --name "$name" --no-open
      ;;
    claude-remove)
      local path root branch
      path=$(jq -r '.worktree_path // empty' <<<"$input")
      [ -n "$path" ] && [ -d "$path" ] || exit 0
      root=$(main_root "$path")
      branch=$(git -C "$path" symbolic-ref --quiet --short HEAD || true)
      cd "$root"
      cmd_rm "$path" --force
      # Only Claude's own throwaway branches, and only if nothing would be lost.
      case $branch in
        worktree-*) git branch -d "$branch" >/dev/null 2>&1 || true ;;
      esac
      ;;
    claude-subagent-stop)
      local agent cwd root
      agent=$(jq -r '.agent_id // empty' <<<"$input")
      cwd=$(jq -r '.cwd // empty' <<<"$input")
      [ -n "$agent" ] || exit 0
      root=$(main_root "${cwd:-.}" 2>/dev/null) || exit 0
      cd "$root"
      # WorktreeCreate named it agent-<agent_id>; see reap_agent.
      reap_agent "$root" "$root/.worktrees/agent-$agent" || true
      ;;
    *) die "unknown hook: ${1:-}" ;;
  esac
}

case ${1:-} in
  new|create|add) shift; cmd_new "$@" ;;
  open) shift; cmd_open "$@" ;;
  rm|remove) shift; cmd_rm "$@" ;;
  ls|list) shift; root=$(main_root .); git -C "$root" worktree list "$@" ;;
  clean) shift; cmd_clean ;;
  link) shift; cmd_link "$@" ;;
  path)
    shift; [ $# -eq 1 ] || { usage; exit 2; }
    root=$(main_root .); resolve "$root" "$1" || die "no worktree matching '$1'" ;;
  popup) shift; cmd_popup ;;
  hook) shift; cmd_hook "$@" ;;
  -h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
