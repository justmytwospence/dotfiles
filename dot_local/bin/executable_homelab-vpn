#!/usr/bin/env bash
# homelab-vpn -- WireGuard from this exe.dev VM to the NUC, carrying Snowflake traffic.
#
# A Snowflake network policy allowlists only the home WAN IP, so connections to the
# Snowflake accounts this VM uses must leave from the NUC. The VM is peer `exe`
# (10.13.13.4) on the NUC's WireGuard server, whose MASQUERADE sends peer traffic out
# the home connection. The tunnel is split: it carries the homelab's 172.16.0.0/12
# plus a /32 per Snowflake account IP, and nothing else, so model APIs, package
# installs and the exe.dev integrations keep using the VM's own uplink. This is the
# same shape as the Mac's WireGuard app profile, except that the Mac's Snowflake IPs
# are typed in by hand; here they are re-resolved from the account hosts named in
# ~/.snowflake/config.toml (and connections.toml), at every tunnel start and every
# 15 minutes, because Snowflake moves its load balancers.
#
# The peer config holds a private key, so it never enters this public repo. It lives
# on the NUC; install it from the Mac, which can reach both machines:
#
#   ssh nuc 'docker exec wireguard cat /config/peer_exe/peer_exe.conf' \
#     | ssh <vm>.exe.xyz '~/.local/bin/homelab-vpn install'
#
# Re-running that is also how a replacement VM gets the tunnel. Subcommands:
#
#   install                    read the NUC's peer config on stdin; write
#                              /etc/wireguard/homelab.conf and the refresh timer; start both
#   refresh <iface> <sf-dir>   (root) re-resolve the Snowflake hosts, reset the peer's
#                              allowed-ips and the interface routes to match
#   status                     tunnel, routes, and which uplink each Snowflake host takes
set -euo pipefail

IFACE=homelab
CONF=/etc/wireguard/$IFACE.conf
BASE_ALLOWED=172.16.0.0/12
SELF=$(readlink -f "$0")

die() { echo "homelab-vpn: $*" >&2; exit 1; }

# The Snowflake hosts the connector dials: <account>.snowflakecomputing.com for each
# `account`, or an explicit `host`. Account locators may carry a region suffix
# (xy12345.us-east-2.aws), which belongs in the hostname too; underscores in
# org-account names become hyphens in the URL.
snowflake_hosts() {
    local dir=$1 f
    for f in "$dir/config.toml" "$dir/connections.toml"; do
        [[ -r $f ]] || continue
        sed -nE 's/^[[:space:]]*host[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' "$f"
        sed -nE 's/^[[:space:]]*account[[:space:]]*=[[:space:]]*"([^"]+)".*/\1.snowflakecomputing.com/p' "$f" \
            | tr '_' '-'
    done | tr '[:upper:]' '[:lower:]' | sort -u
}

cmd_refresh() {
    local iface=${1:-$IFACE} sfdir=${2:-} conf="/etc/wireguard/${1:-$IFACE}.conf"
    [[ $EUID -eq 0 ]] || die "refresh needs root"
    [[ -n $sfdir ]] || die "usage: homelab-vpn refresh <iface> <snowflake-dir>"
    [[ -d /sys/class/net/$iface ]] || { echo "$iface is down; nothing to refresh"; return 0; }

    local peer base host ips cidr complete=1
    peer=$(wg show "$iface" peers | head -1)
    [[ -n $peer ]] || die "$iface has no peer"
    # The static part of the list is whatever `install` wrote to the config.
    base=$(sed -nE 's/^AllowedIPs[[:space:]]*=[[:space:]]*//p' "$conf" | tr -d ' ' | tr ',' '\n')

    local -a want=()
    mapfile -t want <<<"$base"
    while read -r host; do
        [[ -n $host ]] || continue
        ips=$(getent ahostsv4 "$host" | awk '{print $1}' | sort -u) || true
        if [[ -z $ips ]]; then
            echo "cannot resolve $host; keeping its current routes" >&2
            complete=0
            continue
        fi
        while read -r cidr; do want+=("$cidr/32"); done <<<"$ips"
        echo "$host -> $(tr '\n' ' ' <<<"$ips")"
    done < <(snowflake_hosts "$sfdir")
    mapfile -t want < <(printf '%s\n' "${want[@]}" | sed '/^$/d' | sort -u)

    local -a have=()
    mapfile -t have < <(ip -4 route show dev "$iface" | awk '{print ($1 ~ /\//) ? $1 : $1 "/32"}')

    # An unresolvable host must not lose the route it had, or one DNS hiccup would
    # send its traffic out the VM's own IP until the next run -- so a partial
    # resolution only ever adds.
    if (( ! complete )); then
        mapfile -t want < <(printf '%s\n' "${want[@]}" "${have[@]}" | sort -u)
    fi

    wg set "$iface" peer "$peer" allowed-ips "$(IFS=,; echo "${want[*]}")"
    for cidr in "${want[@]}"; do ip -4 route replace "$cidr" dev "$iface"; done
    for cidr in "${have[@]}"; do
        printf '%s\n' "${want[@]}" | grep -qxF "$cidr" || ip -4 route del "$cidr" dev "$iface"
    done
    (( complete ))
}

cmd_install() {
    [[ $EUID -ne 0 ]] || die "run install as your user; it uses sudo itself"
    [[ ! -t 0 ]] || die "pipe the NUC's peer config in (see the header of $SELF)"
    local peer sfdir=${SNOWFLAKE_HOME:-$HOME/.snowflake}
    peer=$(cat)
    grep -q '^PrivateKey' <<<"$peer" || die "stdin is not a WireGuard peer config"

    command -v wg-quick >/dev/null || sudo apt-get install -y --no-install-recommends wireguard-tools

    # Adapt the server-generated peer config to this VM:
    #  - DNS: wg-quick hands it to resolvconf, which exeuntu does not ship, and the VM
    #    must keep exe.dev's resolver anyway -- it alone answers *.int.exe.xyz.
    #  - ListenPort: a client needs no fixed port.
    #  - AllowedIPs: the server template's 10.0.0.0/8 covers the VM's own eth0 subnet
    #    (10.42.0.0/16), so only 172.16.0.0/12 is taken; refresh adds Snowflake.
    #  - PostUp: resolve Snowflake as soon as the interface exists. `|| true` because a
    #    failing PostUp makes wg-quick tear the tunnel down, and at boot DNS may not be
    #    up yet -- the timer retries.
    peer=$(sed -E \
        -e '/^(DNS|ListenPort)[[:space:]]*=/d' \
        -e "s|^AllowedIPs[[:space:]]*=.*|AllowedIPs = $BASE_ALLOWED|" \
        <<<"$peer")
    peer=$(awk -v hook="PostUp = $SELF refresh %i $sfdir || true" \
        '{print} /^\[Interface\]/ {print hook}' <<<"$peer")
    sudo sh -c "umask 077; cat > '$CONF'" <<<"$peer"

    sudo tee /etc/systemd/system/homelab-vpn-refresh.service >/dev/null <<EOF
# written by homelab-vpn install -- see $SELF
[Unit]
Description=Re-resolve Snowflake hosts into the $IFACE WireGuard routes
ConditionPathExists=/sys/class/net/$IFACE
After=wg-quick@$IFACE.service network-online.target

[Service]
Type=oneshot
ExecStart=$SELF refresh $IFACE $sfdir
EOF
    sudo tee /etc/systemd/system/homelab-vpn-refresh.timer >/dev/null <<EOF
# written by homelab-vpn install -- see $SELF
[Unit]
Description=Re-resolve Snowflake hosts into the $IFACE WireGuard routes every 15 minutes

[Timer]
OnBootSec=1min
OnUnitActiveSec=15min

[Install]
WantedBy=timers.target
EOF
    sudo systemctl daemon-reload
    sudo systemctl enable wg-quick@$IFACE homelab-vpn-refresh.timer
    sudo systemctl restart wg-quick@$IFACE
    sudo systemctl start homelab-vpn-refresh.timer
    cmd_status
}

cmd_status() {
    local host ip dev
    sudo wg show "$IFACE" | grep -vE 'private key|preshared key'
    echo
    while read -r host; do
        [[ -n $host ]] || continue
        ip=$(getent ahostsv4 "$host" | awk 'NR==1 {print $1}') || true
        dev=$(ip -4 route get "$ip" 2>/dev/null | grep -oP 'dev \K\S+' || true)
        printf '%-50s %-16s via %s\n' "$host" "${ip:-unresolved}" "${dev:-?}"
    done < <(snowflake_hosts "${SNOWFLAKE_HOME:-$HOME/.snowflake}")
}

case ${1:-} in
    install) cmd_install ;;
    refresh) shift; cmd_refresh "$@" ;;
    status)  cmd_status ;;
    *) sed -n '2,/^set -euo/p' "$SELF" | sed '$d; s/^# \{0,1\}//'; exit 2 ;;
esac
