#!/usr/bin/env bash
# heeler-setup -- pairing steps for the Heeler herdr plugin, the host side of the Heeler
# iOS app (https://github.com/ZingerLittleBee/Heeler): a native console for the
# agents running in herdr on every host, sorted by which one needs you, with a
# live terminal, a composer, and end-to-end encrypted pushes when an agent is
# Blocked or Done.
#
# The plugin does two jobs on a host:
#   - `heeler.pair` shows a Pairing Code QR in a herdr popup. Scanning it adds
#     the host to the app and enrolls the app's Device Key in
#     ~/.ssh/authorized_keys through a single-use bootstrap key.
#   - Its event hooks push Blocked/Done alerts and Live Activity updates to the
#     devices the app registered over SSH, through the developer's relay, which
#     only ever sees ciphertext.
#
# It needs Node 20+ on the herdr server's PATH, herdr 0.7.5+, and an OpenSSH
# server with host keys in /etc/ssh, because the Pairing Code pins that key.
#
# An exe.dev VM has none of the last: its sshd uses its own host key and an
# authorized_keys file that exe.dev manages, so pairing cannot work there. The
# plugin is still installed for the pushes; add the VM in the app by hand and
# authorize the Device Key with `ssh exe.dev ssh-key add` (README "Heeler").
#
# The plugin itself is pinned in dotfiles (dot_config/plugins/pins.tmpl) and
# installed by `plugins sync` on every host that runs a herdr server. This script
# only checks it and prints the pairing steps, which need the phone.
set -euo pipefail

have() { command -v "$1" >/dev/null 2>&1; }

have herdr || { echo "heeler-setup: herdr is not installed" >&2; exit 1; }
node_major=$(node --version 2>/dev/null | sed -E 's/^v([0-9]+).*/\1/')
if [[ -z $node_major || $node_major -lt 20 ]]; then
    echo "heeler-setup: the plugin needs Node 20+ on PATH (found ${node_major:-none})" >&2
    exit 1
fi

# The running session, preferring the default: the NUC runs only "homelab".
session=$(herdr session list --json 2>/dev/null | jq -r '
    [.sessions[] | select(.running)] as $r
    | (($r | map(select(.default)) | .[0].name) // ($r[0].name) // "default")')
sess=()
[[ $session == default ]] || sess=(--session "$session")

if ! herdr "${sess[@]}" plugin list --plugin heeler 2>/dev/null | grep -q "^- heeler "; then
    echo "heeler-setup: the heeler plugin is not installed; run \`plugins sync\`" >&2
    exit 1
fi

if [[ -r /etc/ssh/ssh_host_ed25519_key.pub ]]; then
    cat <<EOF

==> Pair with the phone, once: open the herdr window attached to this host and run

  herdr ${sess[*]:+${sess[*]} }plugin action invoke heeler.pair

  The QR appears in a herdr popup. Check the addresses the phone can reach (the
  WireGuard one works from anywhere), press enter, scan it in Heeler.
EOF
    [[ $session == default ]] || cat <<EOF
  Then set this host's herdr Session to "$session" in the app: the Pairing Code
  does not carry it, and the app otherwise looks for the default session.
EOF
else
    cat <<'EOF'

==> This host cannot pair by QR (no OpenSSH host key in /etc/ssh; an exe.dev VM).
  Add it in Heeler by hand -- address <vm>.exe.xyz, port 22, user exedev,
  Device Key -- and authorize the app's Device Key from the Mac with
    ssh exe.dev ssh-key add '<Device Key line from Heeler>'
EOF
fi
