#!/bin/bash
# Orca host checks and supported CLI access; settings/pairing remain app-owned.
set -euo pipefail
runtime_options=()

case "$(uname -s)" in
    Darwin)
        # ORCA_CLI overrides the app's CLI (the tests use a stub; this Mac has the real app).
        cli=${ORCA_CLI:-/Applications/Orca.app/Contents/Resources/bin/orca}
        [[ -x $cli ]] || cli="$HOME/Applications/Orca.app/Contents/Resources/bin/orca"
        if [[ ! -x $cli ]]; then
            echo 'Orca app CLI missing. Install with: brew install --cask stablyai/orca/orca' >&2
            exit 1
        fi
        run_orca() { "$cli" "$@"; }
        runtime_options=(--environment NUC)
        ;;
    Linux)
        run_orca() { docker exec orca /opt/host-home/enter.sh orca-ide "$@"; }
        ;;
    *) echo 'Unsupported Orca host' >&2; exit 1 ;;
esac

case "${1:-check}" in
    cli) shift; run_orca "$@"; exit ;;
    register)
        if [[ $(uname -s) != Linux ]]; then
            echo 'Register Mac repositories on the NUC owner via orca/admin.mjs import, not in the local Mac runtime.' >&2
            exit 2
        fi
        shift
        [[ $# -gt 0 ]] || { echo 'usage: orca-setup register /absolute/repo ...' >&2; exit 2; }
        for repo in "$@"; do
            [[ $repo = /* && -d $repo ]] || { echo "Not an existing absolute directory: $repo" >&2; exit 2; }
            setup_id=$(run_orca repo add --path "$repo" --json | python3 -c '
import json, sys
reply = json.load(sys.stdin)
if not reply.get("ok"):
    sys.exit("Orca repo registration failed")
print(reply["result"]["repo"]["id"])
')
            run_orca project setup-update --setup "$setup_id" --worktree-base-path "$repo/.worktrees" --json
        done
        exit ;;
    check) ;;
    *) echo 'usage: orca-setup [check | register /absolute/repo ... | cli <command> ...]' >&2; exit 2 ;;
esac

run_orca status "${runtime_options[@]}" --json | python3 -c '
import json, sys
reply = json.load(sys.stdin)
runtime = reply.get("result", {}).get("runtime", {})
if not reply.get("ok") or runtime.get("state") != "ready":
    sys.exit("NUC Orca is not ready; pair a server named NUC on the Mac or check the NUC container.")
print("NUC Orca", runtime.get("appVersion", ""), "ready")
'
for agent in claude codex pi opencode; do
    if [[ $(uname -s) = Linux ]]; then
        docker exec orca /opt/host-home/enter.sh zsh -c 'command -v "$1"' zsh "$agent"
    else
        command -v "$agent" || { echo "Missing agent: $agent" >&2; exit 1; }
    fi
done
cat <<'EOF'

NUC owns Orca; agents/files/tools/logins live on the selected execution machine.
All desktop, web and iOS clients pair only to wss://orca.spencerboucher.com.
Macs: name the paired server NUC, select Advanced > Active Server > NUC.
Do not advertise/pair Mac runtimes or add Mac-owned SSH targets for this setup.
NUC owner registers Mac Pro and Mac Air as SSH execution hosts (WireGuard).
Create sessions in the shared NUC catalog and choose Run on: NUC / Mac Pro / Mac Air.
Turn off Hide other-client workspaces to see sessions created by other clients.
NUC local repositories: orca-setup register /absolute/repo
Mac repositories: import through NUC's orca/admin.mjs; never register locally.
Each repository's worktree root is <repo>/.worktrees; no credential/skill copying.
orca-setup cli passes raw CLI arguments; Macs add --environment NUC for routed commands.
Air MUST import its own macair VPN profile (.4), not the Pro's profile (.3).
Mac SSH hosts must be awake with WireGuard and Remote Login enabled.
Their local Orca app does not need to stay open for NUC-owned SSH sessions.
EOF
