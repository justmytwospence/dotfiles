#!/bin/bash
# Bitwarden Agent Access setup on a Mac, idempotent: log the Bitwarden CLI in, then pair
# this Mac's agents (and any ssh hosts given) with this Mac's aac-touchid listener. Each
# pairing shows one Touch ID sheet. Safe to rerun; already-paired hosts are skipped.
#   aac-setup            this Mac
#   aac-setup nuc        this Mac and the NUC
#   aac-setup status     what is paired
set -euo pipefail
[[ $(uname -s) = Darwin ]] || { echo 'aac-setup runs on a Mac (the approving side)' >&2; exit 1; }
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
for cmd in aac aac-touchid bw; do
    command -v "$cmd" >/dev/null || { echo "$cmd missing: run chezmoi apply (and brew bundle)" >&2; exit 1; }
done
me=$(chezmoi data --format json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["host"])' 2>/dev/null || hostname -s)

if [[ ${1:-} = status ]]; then aac-touchid status; exit; fi

# 1. The listener must be up.
if ! aac-touchid status >/dev/null 2>&1; then
    echo 'aac-touchid is not running; loading its LaunchAgent' >&2
    launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/com.justmytwospence.aac-touchid.plist" || true
    for _ in $(seq 1 20); do aac-touchid status >/dev/null 2>&1 && break; sleep 0.5; done
    aac-touchid status >/dev/null || { echo 'aac-touchid did not start; see ~/Library/Logs/aac-touchid.log' >&2; exit 1; }
fi

# 2. bw logged in (API key: client_id and client_secret from the web vault, typed here).
if bw status 2>/dev/null | grep -q '"status":"unauthenticated"'; then
    echo 'Log the Bitwarden CLI in (Settings > Security > Keys > API key in the web vault):'
    bw login --apikey
fi

# Paired means both ends agree: the listener knows the host's aac identity by this name.
listener_fp() { aac-touchid status --json | python3 -c 'import json,sys; print(next((d["fingerprint"] for d in json.load(sys.stdin)["status"]["devices"] if d["name"]==sys.argv[1]), ""))' "$1"; }
on() { if [[ $1 = local ]]; then shift; "$@"; else local h=$1; shift; ssh -o BatchMode=yes "$h" "PATH=\$HOME/.local/bin:\$PATH $(printf '%q ' "$@")"; fi; }
client_fp() { on "$1" aac connections list 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk '/Your identity:/ {print $3; exit}'; }
paired() { local fp; fp=$(listener_fp "$1"); [[ -n $fp && $fp = "$(client_fp "$2")" ]]; }

# 3. Pair: the listener issues a one-time code; the host's aac redeems it. The test
# request names no vault item, so after the pairing sheet nothing else is shown.
pair() {
    local name=$1 where=${2:-$1}
    if paired "$name" "$where"; then echo "$name: already paired"; return; fi
    # A stale entry (the host lost its aac identity) is replaced.
    [[ -z $(listener_fp "$name") ]] || aac-touchid revoke "$name" >/dev/null
    local code=""
    for _ in $(seq 1 30); do code=$(aac-touchid pair "$name" 2>/dev/null) && break; sleep 1; done
    [[ -n $code ]] || { echo "$name: aac-touchid could not issue a code (relay down?)" >&2; return 1; }
    echo "$name: approve the pairing with Touch ID"
    on "$where" aac run --token "$code" --timeout 120 --domain "aac-setup.invalid | aac-setup | pairing check" --env U=username -- true >/dev/null 2>&1 || true
    if paired "$name" "$where"; then echo "$name: paired"; else echo "$name: pairing failed or was cancelled" >&2; return 1; fi
}

status=0
pair "$me" local || status=1
for host in "$@"; do
    pair "$host" || status=1
done
exit $status
