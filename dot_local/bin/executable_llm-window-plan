#!/usr/bin/env python3
"""Learn account-wide Claude usage and decide when to start a 5-hour window.

Used by llm-window-prime (docs/agents.md "Usage window primer"):

  sample   record the account-wide 5-hour/7-day utilization (all devices) to
           usage.jsonl, from a fresh statusline cache or GET /api/oauth/usage
  decide   print JSON {action: ping|wait, at, reset, reason}
  report   human summary of the learned profile and the plan
  seed [host...]  rebuild history.jsonl (the time before sampling began) from the
           pi and Claude Code session logs here and on each ssh host
  costs    print this machine's logged use per 10 min (what seed runs over ssh)

The OAuth access token is read from ~/.claude/.credentials.json only to query usage;
it is never printed, logged or written. Stdlib only.
"""
import json
import os
import re
import subprocess
import sys
import time
import urllib.request
from datetime import datetime

BIN = 600  # seconds per profile bin
BINS_PER_DAY = 86400 // BIN
WINDOW = 5 * 3600
BUFFER = 120  # seconds past a reset before acting on it
KEEP = 56 * 86400  # sample retention
HALF_LIFE_DAYS = 14
MIN_DAYS = 7  # learning period before the policy takes over
START_PCT = 1.0  # expected use that starts a window on its own
LOOKAHEAD = 48  # candidate ping bins (8 h)
HORIZON = 24 * 3600 // BIN
PEAK_WEIGHT = 0.01
TIE = 0.5  # objective difference treated as a tie (percent points)
CACHE_TTL = 600
URL = "https://api.anthropic.com/api/oauth/usage"

HOME = os.path.expanduser("~")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state"), "llm-window-prime")
SAMPLES = os.path.join(STATE, "usage.jsonl")
HISTORY = os.path.join(STATE, "history.jsonl")
CACHES = [os.path.join(HOME, ".cache/claude-statusline", n) for n in ("pi-oauth-usage.json", "oauth-usage.json")]
CREDS = os.path.join(HOME, ".claude/.credentials.json")


def iso_epoch(s):
    if not s:
        return None
    s = s.replace("Z", "+00:00")
    # Older Pythons accept only 0, 3 or 6 fractional digits.
    s = re.sub(r"\.(\d+)", lambda m: "." + (m.group(1) + "000000")[:6], s, count=1)
    try:
        return datetime.fromisoformat(s).timestamp()
    except ValueError:
        return None


def parse_usage(data, t):
    """Reduce an /api/oauth/usage response to one sample, or None."""
    five = data.get("five_hour") or {}
    if five.get("utilization") is None:
        return None
    seven = data.get("seven_day") or {}
    u5 = float(five["utilization"])
    reset5 = iso_epoch(five.get("resets_at"))
    return {
        "t": int(t),
        "u5": u5,
        "reset5": reset5,
        "u7": seven.get("utilization"),
        "reset7": iso_epoch(seven.get("resets_at")),
        "capped": u5 >= 100 and bool(reset5) and reset5 > t,
    }


def read_cache(now):
    for path in CACHES:
        try:
            age = now - os.path.getmtime(path)
            if age > CACHE_TTL:
                continue
            with open(path) as f:
                s = parse_usage(json.load(f), os.path.getmtime(path))
            if s:
                return s, "cache"
        except (OSError, ValueError):
            continue
    return None, None


def fetch(now, creds=CREDS):
    """Query the usage endpoint; returns (sample, reason). Never exposes the token."""
    try:
        with open(creds) as f:
            oauth = json.load(f).get("claudeAiOauth") or {}
    except (OSError, ValueError):
        return None, "no credentials"
    token = oauth.get("accessToken")
    if not token:
        return None, "no access token"
    if (oauth.get("expiresAt") or 0) / 1000 < now + 60:
        return None, "access token expired (refreshed on next claude use)"
    try:
        ver = subprocess.run(["claude", "--version"], capture_output=True, text=True, timeout=10).stdout.split()[0]
    except (OSError, IndexError, subprocess.SubprocessError):
        ver = "2.1.0"
    req = urllib.request.Request(URL, headers={
        "Authorization": f"Bearer {token}",
        "anthropic-beta": "oauth-2025-04-20",
        "Content-Type": "application/json",
        "User-Agent": f"claude-code/{ver}",
    })
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            s = parse_usage(json.load(r), now)
    except Exception as e:  # network/HTTP errors: report the class only
        return None, f"usage request failed ({type(e).__name__})"
    return (s, "api") if s else (None, "unexpected usage response")


def load_samples(path=SAMPLES):
    out = []
    try:
        with open(path) as f:
            for line in f:
                try:
                    out.append(json.loads(line))
                except ValueError:
                    pass
    except OSError:
        pass
    out.sort(key=lambda s: s["t"])
    return out


def store(sample, now, path=SAMPLES):
    samples = [s for s in load_samples(path) if s["t"] >= now - KEEP and s["t"] != sample["t"]]
    if samples and sample["t"] - samples[-1]["t"] < 120 and sample["u5"] == samples[-1]["u5"]:
        return False  # duplicate of a sample just taken
    samples.append(sample)
    samples.sort(key=lambda s: s["t"])
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        for s in samples:
            f.write(json.dumps(s, separators=(",", ":")) + "\n")
    os.replace(tmp, path)
    return True


def same_window(a, b):
    return a.get("reset5") and b.get("reset5") and abs(a["reset5"] - b["reset5"]) < 120


def intervals(samples):
    """Yield (mid_time, demand_pct, capped) per pair of consecutive samples."""
    for a, b in zip(samples, samples[1:]):
        if b["t"] - a["t"] > 3 * BIN:
            continue  # gap: unobserved
        if same_window(a, b):
            d = max(0.0, b["u5"] - a["u5"])
        elif a.get("reset5") and a["reset5"] > b["t"] + 120:
            d = max(0.0, b["u5"] - a["u5"])  # reset field moved without a reset
        else:
            d = b["u5"]  # a new window started in between
        yield (a["t"] + b["t"]) / 2, d, bool(a.get("capped"))


# --- One-time seed: history from session logs, so the profile need not wait for samples ---
PCT_PER_DOLLAR = 0.58  # 5-hour budget % per API-equivalent $, measured Oct 2026 (Max)
PRICES = {"haiku": (1, 5, 1.25, 0.1), "sonnet": (3, 15, 3.75, 0.3),
          "fable": (15, 75, 18.75, 1.5), "opus": (5, 25, 6.25, 0.5)}  # $/Mtok in, out, write, read


def log_costs(home=HOME):
    """{10-min bin: [api-equivalent $, capped]} from pi (provider anthropic) and Claude
    Code logs, minus the primer's pings; a rate-limit error marks its bin capped."""
    from glob import glob
    bins, seen = {}, set()

    def add(ts, cost=0.0, capped=False):
        t = iso_epoch(ts) if isinstance(ts, str) else None
        if t is not None:
            b = bins.setdefault(int(t // BIN * BIN), [0.0, False])
            b[0] += cost
            b[1] = b[1] or capped

    files = glob(os.path.join(home, ".pi/agent/sessions/*/*.jsonl"))
    files += [f for f in glob(os.path.join(home, ".claude/projects/**/*.jsonl"), recursive=True) if "-tmp-tmp" not in f]
    for path in files:
        with open(path, errors="ignore") as fh:
            for line in fh:
                if '"assistant"' not in line:
                    continue
                try:
                    o = json.loads(line)
                except ValueError:
                    continue
                m = o.get("message") or {}
                if o.get("type") == "message" and m.get("role") == "assistant" and m.get("provider") == "anthropic":  # pi
                    if "rate_limit_error" in (m.get("errorMessage") or ""):
                        add(o.get("timestamp"), capped=True)
                    else:
                        add(o.get("timestamp"), ((m.get("usage") or {}).get("cost") or {}).get("total") or 0.0)
                elif o.get("type") == "assistant":  # Claude Code
                    if o.get("isApiErrorMessage"):
                        add(o.get("timestamp"), capped="limit" in json.dumps(m.get("content")).lower())
                    elif (m.get("id"), o.get("requestId")) not in seen:
                        seen.add((m.get("id"), o.get("requestId")))
                        u, model = m.get("usage") or {}, (m.get("model") or "").lower()
                        p = next((v for k, v in PRICES.items() if k in model), PRICES["opus"])
                        add(o.get("timestamp"), (u.get("input_tokens", 0) * p[0] + u.get("output_tokens", 0) * p[1]
                                                 + u.get("cache_creation_input_tokens", 0) * p[2]
                                                 + u.get("cache_read_input_tokens", 0) * p[3]) / 1e6)
    return bins


def seed(hosts, now, path=None):
    """Write history.jsonl for the 28 days before now from this machine's and each
    host's logs (this file run there as `python3 - costs` over ssh)."""
    bins = {int(b): v for b, v in log_costs().items()}
    used = []
    for host in hosts:
        try:
            with open(__file__) as me:
                out = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", host,
                                      "python3", "-", "costs"], stdin=me, capture_output=True, text=True,
                                     timeout=600).stdout
            remote = json.loads(out)
        except (OSError, ValueError, subprocess.SubprocessError):
            continue
        used.append(host)
        for b, (cost, capped) in remote.items():
            v = bins.setdefault(int(b), [0.0, False])
            v[0] += cost
            v[1] = v[1] or capped
    # After a cap hit, time stays capped until use resumes (at most one window).
    b, capped_until, n = int((now - 28 * 86400) // BIN * BIN), 0, 0
    with open(path or HISTORY, "w") as f:
        while b < now:
            cost, capped = bins.get(b, (0.0, False))
            capped_until = b + WINDOW if capped else (0 if cost > 0 else capped_until)
            f.write(json.dumps({"t": b + BIN / 2, "d": round(cost * PCT_PER_DOLLAR, 3), "capped": b < capped_until}) + "\n")
            b, n = b + BIN, n + 1
    print(f"seed: wrote {n} bins from this machine and {', '.join(used) or 'no other hosts'}"
          + "".join(f"; {h} unreachable" for h in hosts if h not in used))


def load_history(before, path=None):
    """Seeded history from before sampling began: [(mid_time, demand_pct, capped)]."""
    out = []
    try:
        with open(path or HISTORY) as f:
            for line in f:
                o = json.loads(line)
                if o["t"] < before:
                    out.append((o["t"], o["d"], bool(o.get("capped"))))
    except (OSError, ValueError, KeyError):
        pass
    return out


def day_type(dt):
    return "weekend" if dt.weekday() >= 5 else "weekday"


def bin_of(dt):
    return (dt.hour * 3600 + dt.minute * 60 + dt.second) // BIN


class Profile:
    """Expected demand (% of the 5-hour budget per bin) by day type and bin of day."""

    def __init__(self, samples, now, tz=None, history=()):
        self.tz = tz
        acc = {}  # key -> [sum w*d, sum w, sum w*active]
        obs = list(history) + list(intervals(samples))
        active = [d for _, d, c in obs if d > 0 and not c]
        # Blocked time counts as the typical active rate: demand was there but unmet.
        self.active_rate = sum(active) / len(active) if active else 0.0
        self.capped_bins = 0
        for t, d, capped in obs:
            if capped:
                d = max(d, self.active_rate)
                self.capped_bins += 1
            w = 0.5 ** ((now - t) / 86400 / HALF_LIFE_DAYS)
            dt = datetime.fromtimestamp(t, tz)
            for key in ((day_type(dt), bin_of(dt)), ("all", bin_of(dt))):
                a = acc.setdefault(key, [0.0, 0.0, 0.0])
                a[0] += w * d
                a[1] += w
                a[2] += w * (d > 0)
        self.acc = acc
        self.timeline = {}  # bin start -> demand, capped time imputed
        for t, d, capped in obs:
            b = int(t // BIN * BIN)
            self.timeline[b] = self.timeline.get(b, 0.0) + (max(d, self.active_rate) if capped else d)
        self.start = min(self.timeline) if self.timeline else None
        self.days = (max(t for t, _, _ in obs) - min(t for t, _, _ in obs)) / 86400 if obs else 0.0

    def demand(self, t):
        dt = datetime.fromtimestamp(t, self.tz)
        b = bin_of(dt)
        s, w, _ = self.acc.get((day_type(dt), b), (0.0, 0.0, 0.0))
        sa, wa, _ = self.acc.get(("all", b), (0.0, 0.0, 0.0))
        prior = sa / wa if wa else 0.0
        k = 2.0  # pseudo-observations pulling a sparse day type toward all days
        return (s + k * prior) / (w + k)

    def scenarios(self, now, days=28):
        """Each past day replayed from the same clock time: [(weight, demand per bin)].

        Real days keep their bursts, which an average smooths away. Days of the same
        type (weekday/weekend) are used when there are at least 3 of them."""
        if self.start is None:
            return []
        today = day_type(datetime.fromtimestamp(now, self.tz))
        out = []
        for k in range(1, days + 1):
            t0 = now - k * 86400
            if t0 < self.start:
                break
            kind = day_type(datetime.fromtimestamp(t0, self.tz))
            series = [self.timeline.get(int((t0 + i * BIN) // BIN * BIN), 0.0) for i in range(HORIZON)]
            out.append((0.5 ** (k / HALF_LIFE_DAYS), kind == today, series))
        same = [s for s in out if s[1]]
        chosen = same if len(same) >= 3 else out
        return [(w, series) for w, _, series in chosen]


def simulate(demand, ping):
    """demand: expected % per bin from now; ping: bin index or None.

    Returns (blocked, peak, windows). Without a ping, a window starts once
    expected use since the last expiry reaches START_PCT (your own use)."""
    blocked = peak = 0.0
    windows = []
    end = None
    used = pending = raw = 0.0
    for i, d in enumerate(demand):
        if end is not None and i >= end:
            peak = max(peak, raw)
            end = None
            pending = 0.0
        if end is None:
            if i == ping:
                end, used, raw = i + WINDOW // BIN, 0.0, 0.0
                windows.append(i)
            else:
                pending += d
                if pending >= START_PCT:
                    end, used, raw = i + WINDOW // BIN, 0.0, 0.0
                    windows.append(i)
                    d = pending
                else:
                    continue
        used += d
        raw += d
        if used > 100:
            blocked += used - 100
            used = 100.0
    if end is not None:
        peak = max(peak, raw)
    return blocked, peak, windows


def plan(profile, now):
    """Best ping bin from now (None = let your own use start it) and its scores.

    Each candidate is scored by expected blocked demand over the past days replayed
    (profile.scenarios); windows shown are those of the average day."""
    scen = profile.scenarios(now)
    total = sum(w for w, _ in scen) or 1.0
    mean = [profile.demand(now + i * BIN) for i in range(HORIZON)]
    scores = []
    for ping in [None] + list(range(LOOKAHEAD + 1)):
        blocked = obj = 0.0
        for w, series in scen:
            b, peak, _ = simulate(series, ping)
            blocked += w * b / total
            obj += w * (b + PEAK_WEIGHT * peak) / total
        wins = simulate(mean, ping)[2]
        scores.append((ping, obj, blocked, wins))
    lo = min(s[1] for s in scores)
    tied = [s for s in scores if s[1] <= lo + TIE]
    # A tie goes to not pinging; among tied ping times, the middle one is most robust
    # to a day starting or peaking a little earlier or later than usual.
    best = next((s for s in tied if s[0] is None), None)
    if best is None:
        tied.sort(key=lambda s: s[0])
        best = tied[(len(tied) - 1) // 2]
    return best, scores


def decide(samples, now, tz=None, history=()):
    last = samples[-1] if samples else None
    reset = None
    if last and now - last["t"] < 3 * BIN and last.get("reset5") and last["reset5"] > now:
        reset = last["reset5"]
        return {"action": "wait", "at": reset + BUFFER, "reset": reset,
                "reason": f"window running, {last['u5']:.0f}% used"}
    profile = Profile(samples, now, tz, history) if len(samples) > 1 or history else None
    if not profile or profile.days < MIN_DAYS:
        days = profile.days if profile else 0
        return {"action": "ping", "at": now, "reset": None,
                "reason": f"learning ({days:.1f} of {MIN_DAYS} days of data), ping at expiry"}
    best, scores = plan(profile, now)
    ping, obj, blocked = best[0], best[1], best[2]
    now_blocked = next(s[2] for s in scores if s[0] == 0)
    if ping == 0:
        return {"action": "ping", "at": now, "reset": None,
                "reason": f"ping now: expected blocked {blocked:.0f}% next 24h"}
    if ping is None:
        return {"action": "wait", "at": None, "reset": None,
                "reason": f"no ping helps (expected blocked {blocked:.0f}% either way)"}
    at = now + ping * BIN
    return {"action": "wait", "at": at, "reset": None,
            "reason": f"ping at {fmt(at, tz)}: expected blocked {blocked:.0f}% vs {now_blocked:.0f}% if now"}


def fmt(t, tz=None):
    return datetime.fromtimestamp(t, tz).strftime("%a %H:%M")


def cmd_sample(now):
    s, src = read_cache(now)
    if not s:
        s, src = fetch(now)
    if not s:
        print(f"usage: no sample, {src}")
        return 0
    store(s, now)
    reset = f", resets {fmt(s['reset5'])}" if s.get("reset5") and s["reset5"] > now else ", no window"
    u7 = f", 7d {s['u7']:.0f}%" if s.get("u7") is not None else ""
    print(f"usage ({src}): 5h {s['u5']:.0f}%{reset}{u7}")
    return 0


def cmd_report(now):
    samples = load_samples()
    hist = load_history(samples[0]["t"] if samples else now)
    if len(samples) < 2 and not hist:
        print("no samples or history yet")
        return 0
    p = Profile(samples, now, None, hist)
    print(f"{len(samples)} samples, {len(hist)} seeded history bins")
    print(f"{p.days:.1f} days of data; {p.capped_bins} capped 10-min bins; "
          f"typical active rate {p.active_rate:.1f}%/10min")
    obs = hist + list(intervals(samples))
    caps = sorted({datetime.fromtimestamp(t).strftime("%a %m-%d %H:00") for t, _, c in obs if c})
    if caps:
        print("capped hours:", ", ".join(caps[-20:]))
    def mean(kind, b):
        s, w, _ = p.acc.get((kind, b), (0.0, 0.0, 0.0))
        return s / w if w else 0.0

    for kind in ("weekday", "weekend"):
        per = BINS_PER_DAY // 24
        row = [sum(mean(kind, h * per + k) for k in range(per)) for h in range(24)]
        print(f"{kind} %/hour:", " ".join(f"{h:02d}:{v:.0f}" for h, v in enumerate(row)))
    d = decide(samples, now, None, hist)
    print("now:", d["action"], "-", d["reason"])
    start = d["at"] if d["reset"] else now
    if p.days >= MIN_DAYS:
        best, _ = plan(p, start)
        when = "no ping" if best[0] is None else "ping " + fmt(start + best[0] * BIN)
        print(f"plan from {fmt(start)}: {when}; expected blocked {best[2]:.0f}% over 24h, "
              "average-day windows at " + ", ".join(fmt(start + w * BIN) for w in best[3][:6]))
    return 0


def main(argv):
    now = time.time()
    cmd = argv[1] if len(argv) > 1 else "report"
    if cmd == "sample":
        return cmd_sample(now)
    if cmd == "decide":
        samples = load_samples()
        print(json.dumps(decide(samples, now, None, load_history(samples[0]["t"] if samples else now))))
        return 0
    if cmd == "costs":
        print(json.dumps(log_costs()))
        return 0
    if cmd == "seed":
        seed(argv[2:], now)
        return 0
    if cmd == "report":
        return cmd_report(now)
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
