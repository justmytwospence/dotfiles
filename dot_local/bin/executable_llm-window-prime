#!/usr/bin/env bash
# Start 5-hour subscription usage windows when they help most (docs/agents.md "Usage
# window primer"). Run by llm-window-prime.service on the NUC: llm-window-prime.timer
# (boot + every 10 min) samples account-wide usage, and each run books the next one at
# the earliest known reset or planned ping (transient timer llm-window-prime-next).
#
# Claude: llm-window-plan records account-wide utilization (all devices) and, once a
# window has ended, decides whether to ping now, later, or not at all from the learned
# usage profile. Codex: ping once the last known window has ended, if the plan has one.
# Official CLIs only; state lives in ~/.local/state/llm-window-prime. Reads the Claude
# OAuth access token only to query usage (llm-window-plan); never prints credentials.
#
# Optional config (~/.config/llm-window-prime.env): QUIET_HOURS="1-7" (local hours,
# start inclusive, end exclusive), CODEX_MODEL, CLAUDE_MODEL. Flags: --dry-run.
set -uo pipefail

[[ -r "$HOME/.config/llm-window-prime.env" ]] && . "$HOME/.config/llm-window-prime.env"
QUIET_HOURS=${QUIET_HOURS:-}
CLAUDE_MODEL=${CLAUDE_MODEL:-haiku}
CODEX_MODEL=${CODEX_MODEL:-gpt-6-luna}
FIVE_H=$((5 * 3600))
BUFFER=120 # seconds past a reset before pinging
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/llm-window-prime"
DRY=0
[[ ${1:-} == --dry-run ]] && DRY=1
export PATH="$HOME/.local/bin:$PATH"
# Subscription logins only: an exported API key would make the CLIs bill the API instead.
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN OPENAI_API_KEY CODEX_API_KEY

mkdir -p "$STATE"
now=$(date +%s)
log() { echo "$1: $2"; }
due() { local r; r=$(cat "$STATE/$1" 2>/dev/null || echo 0); ((now >= r + BUFFER)); }
fmt() { date -d "@$1" '+%a %H:%M' 2>/dev/null || date -r "$1" '+%a %H:%M'; }

# Sample account-wide usage on every run, quiet hours included, so the profile is complete.
command -v llm-window-plan >/dev/null && log claude "$(llm-window-plan sample 2>&1 | tail -1)"

if [[ $QUIET_HOURS =~ ^([0-9]+)-([0-9]+)$ ]]; then
  h=$((10#$(date +%H))) s=${BASH_REMATCH[1]} e=${BASH_REMATCH[2]}
  if { ((s <= e)) && ((h >= s && h < e)); } || { ((s > e)) && ((h >= s || h < e)); }; then
    echo "quiet hours ($QUIET_HOURS), skipping"; exit 0
  fi
fi

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT; cd "$tmp" || exit 1

prime_claude() {
  command -v claude >/dev/null || { log claude "not installed"; return; }
  local st; st=$(claude auth status 2>/dev/null) || true
  if [[ $(jq -r '.loggedIn' <<<"$st" 2>/dev/null) != true ||
        $(jq -r '.authMethod' <<<"$st") != claude.ai ]]; then
    log claude "no claude.ai subscription login, skipping"; return
  fi
  local plan; plan=$(jq -r '.subscriptionType // "unknown"' <<<"$st")
  # Account-wide usage shows a window started on any device, without a ping.
  local d r action
  d=$(llm-window-plan decide 2>/dev/null) && jq -e . >/dev/null 2>&1 <<<"$d" || d='{"action":"ping","reason":"no plan"}'
  r=$(jq -r '.reset // empty | floor' <<<"$d")
  [[ $r =~ ^[0-9]+$ ]] && ((!DRY)) && echo "$r" >"$STATE/claude"
  if ! due claude; then
    log claude "$plan: window runs until $(fmt "$(cat "$STATE/claude")")"; return
  fi
  action=$(jq -r '.action // "ping"' <<<"$d")
  if [[ $action == wait ]]; then
    r=$(jq -r '.at // empty | floor' <<<"$d")
    if ((!DRY)); then
      if [[ $r =~ ^[0-9]+$ ]]; then echo "$r" >"$STATE/claude.plan"; else rm -f "$STATE/claude.plan"; fi
    fi
    log claude "$plan: $(jq -r '.reason' <<<"$d")"; return
  fi
  ((DRY)) && { log claude "$plan: would ping ($(jq -r '.reason' <<<"$d"))"; return; }
  rm -f "$STATE/claude.plan"
  # The ping also reports the real five_hour reset, including a window my own use started.
  local reset
  reset=$(claude -p hi --model "$CLAUDE_MODEL" --max-turns 1 --output-format stream-json --verbose 2>/dev/null |
    jq -r 'select(.type=="rate_limit_event") | .rate_limit_info.unifiedWindows.five_hour.resetsAt // empty' | tail -1)
  [[ $reset =~ ^[0-9]+$ ]] || reset=$((now + FIVE_H))
  echo "$reset" >"$STATE/claude"
  log claude "$plan: pinged, window resets $(fmt "$reset")"
}

codex_limits() {
  { printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"clientInfo":{"name":"llm-window-prime","version":"1"}}}' \
      '{"jsonrpc":"2.0","method":"initialized"}' \
      '{"jsonrpc":"2.0","id":2,"method":"account/rateLimits/read"}'
    sleep 8; } | timeout 15 codex app-server 2>/dev/null | jq -c 'select(.id==2) | .result.rateLimits' | head -1
}

prime_codex() {
  command -v codex >/dev/null || { log codex "not installed"; return; }
  if ! codex login status 2>&1 | grep -q ChatGPT; then
    log codex "no ChatGPT login, skipping"; return
  fi
  # Plans without a 5h window (Pro) are re-checked every 6 hours, not every run.
  local skip; skip=$(cat "$STATE/codex.nowindow" 2>/dev/null || echo 0)
  if ((now < skip)); then return 0; fi
  if ! due codex; then log codex "window runs until $(fmt "$(cat "$STATE/codex")")"; return; fi
  local rl plan win
  rl=$(codex_limits)
  [[ -n $rl ]] || { log codex "could not read rate limits"; return; }
  plan=$(jq -r '.planType // "unknown"' <<<"$rl")
  win=$(jq -c '[.primary, .secondary] | map(select(. != null and .windowDurationMins == 300)) | first // empty' <<<"$rl")
  if [[ -z $win ]]; then
    echo $((now + 6 * 3600)) >"$STATE/codex.nowindow"
    log codex "$plan: no 5-hour window, skipping"; return
  fi
  local used reset
  used=$(jq -r '.usedPercent // 0' <<<"$win"); reset=$(jq -r '.resetsAt // 0' <<<"$win")
  if [[ $used != 0 ]] && ((reset > now)); then
    echo "$reset" >"$STATE/codex"; log codex "$plan: window already running until $(fmt "$reset")"; return
  fi
  ((DRY)) && { log codex "$plan: would ping"; return; }
  codex exec --skip-git-repo-check --ephemeral -s read-only -m "$CODEX_MODEL" hi >/dev/null 2>&1 ||
    { log codex "$plan: ping failed"; return; }
  reset=$(codex_limits | jq -r '[.primary, .secondary] | map(select(. != null and .windowDurationMins == 300)) | first.resetsAt // empty')
  [[ $reset =~ ^[0-9]+$ ]] || reset=$((now + FIVE_H))
  echo "$reset" >"$STATE/codex"
  log codex "$plan: pinged, window resets $(fmt "$reset")"
}

# Book the next run at the earliest known reset + BUFFER or planned Claude ping
# (replaces any earlier booking).
schedule_next() {
  ((DRY)) && return 0
  command -v systemd-run >/dev/null || return 0
  local next=0 r p
  for p in claude codex claude.plan; do
    [[ -f $STATE/$p ]] || continue
    r=$(cat "$STATE/$p")
    [[ $r =~ ^[0-9]+$ ]] || continue
    [[ $p == *.plan ]] || r=$((r + BUFFER))
    ((r > now)) && { ((next == 0 || r < next)) && next=$r; }
  done
  ((next)) || { echo "no reset or ping planned; 10-minute timer covers it"; return 0; }
  systemctl --user stop llm-window-prime-next.timer 2>/dev/null
  systemctl --user reset-failed llm-window-prime-next.timer llm-window-prime-next.service 2>/dev/null
  if systemd-run --user --quiet --unit=llm-window-prime-next --on-active="$((next - now))s" \
      --timer-property=AccuracySec=1s systemctl --user start --no-block llm-window-prime.service; then
    echo "next run $(fmt "$next")"
  else
    echo "could not book next run; 10-minute timer covers it"
  fi
}

prime_claude
prime_codex
schedule_next
exit 0
