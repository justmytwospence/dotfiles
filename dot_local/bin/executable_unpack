#!/usr/bin/env bash
# unpack: Extract common file formats
# Display usage if no parameters given

if [[ $# -eq 0 ]]; then
  echo " ${0##*/} <archive> - extract common file formats"
  exit 1
fi

archive="$1"

# Test if file exists
if [ ! -f "$archive" ]; then
  echo " File \"$archive\" doesn't exist" >&2
  exit 1
fi

# Required program, checked only for the format at hand
need() {
  hash "$1" 2>&- || \
  { echo >&2 " Required program \"$1\" not installed."; exit 1; }
}

# Extract file by using extension as reference
case "$archive" in
  *.7z ) need 7zz; 7zz x "$archive" ;;
  *.rar ) need 7zz; 7zz x "$archive" ;;
  *.tar.bz2 | *.tbz2 ) tar xvjf "$archive" ;;
  *.bz2 ) bunzip2 "$archive" ;;
  *.deb ) ar vx "$archive" ;;
  *.tar.gz | *.tgz ) tar xvzf "$archive" ;;
  *.gz ) gunzip "$archive" ;;
  *.tar | *.tar.xz ) tar xvf "$archive" ;;
  *.zip ) need unzip; unzip "$archive" ;;
  *.Z ) uncompress "$archive" ;;
  * ) echo " Unsupported file format" >&2; exit 1 ;;
esac
