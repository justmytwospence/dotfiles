{
  "treeFilterMode": "no-tools",
  "npmCommand": [
    "npm-cooldown",
    "--",
    "npm"
  ],
  "packages": [
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:pi-web-access",
    "npm:@cortexkit/pi-antigravity-auth@3.0.4",
    "git:github.com/justmytwospence/pi-plugins@7a48a19b8b384dd7005fb8f03a4c9ae808fa69b0",
    "git:github.com/justmytwospence/tmux-agents@6cc3091dfcac77ee6e230566f2d27b2c467b5d24",
    "git:github.com/justmytwospence/anthropic-billing-guard@630ca078865fba658f808184ee4f5902c0865207",
    {
      "source": "npm:pi-autoresearch",
      "skills": []
    }
  ],
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "externalEditor": "edamame",
  "shellCommandPrefix": "git() { if [ -n \"${PI_SESSION_ID:-}\" ] && [ -d \"$HOME/.config/sphinx/hooks/global\" ]; then CI=1 command git \"$@\"; else command git \"$@\"; fi; }; export -f git",
  "cacheWarming": "idle",
  "showCacheMissNotices": false,
  "enabledModels": [
    "anthropic/claude-fable-5-1",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-sonnet-5-5",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6.1-sol",
    "meta/muse-wonder-1.0",
    "google/antigravity-gemini-4-argon"
  ],
  "theme": "light/dark",
  "tuiMode": "fullscreen",
  "warnings": {
    "anthropicExtraUsage": false
  }
}
