{
  "treeFilterMode": "no-tools",
  "npmCommand": [
    "npm-cooldown",
    "--",
    "npm"
  ],
  "packages": [
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:pi-web-access",
    "git:github.com/justmytwospence/pi-plugins@0da05fea714d28e23c03888cb6f472f0e625c0ea",
    "git:github.com/justmytwospence/tmux-agents@f7e399ffb85fa0b3e8b6097d3f9af16dce04f0d1",
    "git:github.com/justmytwospence/anthropic-billing-guard@630ca078865fba658f808184ee4f5902c0865207",
    "npm:pi-autoresearch"
  ],
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "xhigh",
  "cacheWarming": "idle",
  "showCacheMissNotices": false,
  "enabledModels": [
    "anthropic/claude-fable-5-1",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-sonnet-5-5",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6.1-sol",
    "meta/muse-wonder-1.0"
  ],
  "theme": "light/dark",
  "tuiMode": "fullscreen",
  "warnings": {
    "anthropicExtraUsage": false
  }
}
