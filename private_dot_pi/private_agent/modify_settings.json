#!/usr/bin/env python3
# ~/.pi/agent/settings.json: the keys in settings.managed.json are the repo's (packages, models,
# theme, ...); pi's own (lastChangelogVersion, deviceId) stay. Merge rules: lib/agent_settings.py.
import os, sys
sys.dont_write_bytecode = True  # no __pycache__ in the source tree
os.environ["CHEZMOI_SOURCE_DIR"] = os.environ.get("CHEZMOI_SOURCE_DIR") or os.popen("chezmoi source-path").read().strip()
sys.path.insert(0, os.path.join(os.environ["CHEZMOI_SOURCE_DIR"], "lib"))
import agent_settings as a  # noqa: E402

a.run_json("private_dot_pi/private_agent/settings.managed.json", a.merge_pi_settings)
