#!/bin/bash
# Harness wiring that lives outside the repo: Codex features, vim plugins.
# herdr's agent hooks rerun per herdr version in 51-herdr-hooks.
set -uo pipefail
{{ template "script-path.sh" . }}
have() { command -v "$1" >/dev/null 2>&1; }

# Codex's managed worktrees live in one global pool; worktrees here go in
# <project>/.worktrees through ~/.local/bin/worktree (docs/agents.md).
if have codex; then
    mkdir -p "$HOME/.codex"
    codex features disable worktrees >/dev/null || true
fi

# vim plugins (vim-plug itself comes from .chezmoiexternal.toml): drop clones the
# vimrc no longer lists, install the missing ones. Headless ex mode, the way
# vim-plug documents it; it exits 1 even when it worked, so check the result.
vim -es -u "$HOME/.vimrc" -i NONE -c 'PlugClean!' -c 'PlugInstall' -c 'qa' </dev/null >/dev/null 2>&1 || true
want=$(grep -cE "^\s*Plug '" "$HOME/.vimrc")
have=$(find "$HOME/.vim/plugins" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
[[ $have -ge $want ]] || echo "vim plugins: $have of $want installed; run :PlugInstall in vim" >&2
