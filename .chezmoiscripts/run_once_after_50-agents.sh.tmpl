#!/bin/bash
# Harness wiring that lives outside the repo: herdr's agent hooks, Codex features,
# vim plugins.
set -uo pipefail
export PATH="/opt/homebrew/bin:$HOME/.local/bin:/usr/local/bin:$PATH"  # brew first on the Mac, as in .zshenv
have() { command -v "$1" >/dev/null 2>&1; }
{{- if not (hasPrefix "paseo-" .host) }}

# herdr's integration writes its hook script (~/.claude/hooks/herdr-agent-state.sh
# and the like) and an entry in each harness's settings. The repo's managed hooks
# already carry that entry with a portable $HOME path, so the next `chezmoi apply`
# drops the installer's absolute-path copy (lib/agent_settings.py).
if have herdr; then
    for agent in claude codex pi opencode; do
        herdr integration install "$agent" || echo "herdr integration install $agent failed" >&2
    done
fi
{{- end }}

# Codex's managed worktrees live in one global pool; worktrees here go in
# <project>/.worktrees through ~/.local/bin/worktree (docs/agents.md).
if have codex; then
    mkdir -p "$HOME/.codex"
    codex features disable worktrees >/dev/null || true
fi

# vim plugins (vim-plug itself comes from .chezmoiexternal.toml): drop clones the
# vimrc no longer lists, install the missing ones. Headless ex mode, the way
# vim-plug documents it; it exits 1 even when it worked, so check the result.
vim -es -u "$HOME/.vimrc" -i NONE -c 'PlugClean!' -c 'PlugInstall' -c 'qa' </dev/null >/dev/null 2>&1 || true
want=$(grep -cE "^\s*Plug '" "$HOME/.vimrc")
have=$(find "$HOME/.vim/plugins" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
[[ $have -ge $want ]] || echo "vim plugins: $have of $want installed; run :PlugInstall in vim" >&2
