{{- if hasPrefix "mac-" .host -}}
{{- $node := "/opt/homebrew/bin/node" -}}
{{- $pkg := "/opt/homebrew/lib/node_modules/sphinx-understand" -}}
#!/bin/bash
# Sphinx understanding checks (docs/agents.md#sphinx), Pi only. brew bundle installs the npm
# package (dot_Brewfile.tmpl); `sphinx install` then writes what it owns and records in
# ~/.config/sphinx/install.json: the global Git hooks and Pi's extension
# (~/.pi/agent/extensions/sphinx.js). dot_gitconfig.tmpl renders the hooksPath it sets, and
# Pi's shellCommandPrefix (settings.managed.json) makes agent pushes use Pi's dialogs.
# Sphinx pins hooks to Node's Cellar path, so this reruns when Node or Sphinx changes:
# node {{ if stat $node }}{{ output $node "--version" | trim }}{{ end }}
# sphinx {{ if stat (joinPath $pkg "package.json") }}{{ (include (joinPath $pkg "package.json") | fromJson).version }}{{ end }}
set -euo pipefail
{{ template "script-path.sh" . }}

# Homebrew's node, not nvm's default that script-path.sh puts first: the hooks pin this node.
if [ ! -x {{ $node | quote }} ] || [ ! -f {{ joinPath $pkg "bin/sphinx.js" | quote }} ]; then
    echo "sphinx-understand is missing; brew bundle (20-brew-bundle) should have installed it" >&2
    exit 1
fi
{{ $node | quote }} {{ joinPath $pkg "bin/sphinx.js" | quote }} install --yes --no-launch \
    --preset claude-economy --agents pi
{{- end }}
