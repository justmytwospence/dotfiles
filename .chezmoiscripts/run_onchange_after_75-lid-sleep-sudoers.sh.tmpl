{{- if hasPrefix "mac-" .host -}}
#!/bin/bash
# Passwordless sudo for exactly the two `pmset disablesleep` commands used by the
# lid-sleep toggles (SwiftBar lid-caffeine plugin, Raycast toggle-lid-sleep).
# Reruns when this script changes; skips sudo when the file already matches.
set -euo pipefail

dest=/etc/sudoers.d/lid-caffeine
entry='{{ .chezmoi.username }} ALL=(root) NOPASSWD: /usr/bin/pmset -a disablesleep 1, /usr/bin/pmset -a disablesleep 0'

if [ -f "$dest" ] && [ "$(cat "$dest" 2>/dev/null)" = "$entry" ]; then
  exit 0
fi

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
printf '%s\n' "$entry" > "$tmp"

/usr/sbin/visudo -cf "$tmp" >/dev/null
cmd="/usr/bin/install -m 0440 -o root -g wheel '$tmp' '$dest'"

echo "lid-sleep: installing $dest (admin password required)"
if [ -t 0 ]; then
  sudo /bin/sh -c "$cmd"
else
  # No terminal (e.g. run from an agent): use the macOS GUI password prompt.
  /usr/bin/osascript -e "do shell script \"$cmd\" with administrator privileges"
fi
{{- end }}
