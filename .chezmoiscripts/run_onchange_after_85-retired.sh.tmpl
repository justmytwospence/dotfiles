#!/bin/bash
# Removes what this repo used to install or what other tools left behind, on every
# host. Dropping a line from the Brewfile or 10-packages stops new installs but
# leaves existing ones in place; this script removes them. Reruns whenever its
# content changes, and every step is a no-op once the thing is gone, so entries
# can stay here indefinitely.
{{ template "script-path.sh" . }}
set -uo pipefail

gone() { echo "retired: $*"; }

# beads (bd): dropped for the harnesses' own task tools. Projects that still
# carry a .beads/ directory keep their data; only the CLI and its telemetry go.
if command -v brew >/dev/null 2>&1 && brew list --formula beads >/dev/null 2>&1; then
    brew uninstall --formula beads >/dev/null && gone "beads (brew)"
fi
bd=$(command -v bd 2>/dev/null || true)
case $bd in
    "") ;;
    "$HOME"/*) rm -f "$bd" && gone "$bd" ;;
    *) echo "retired: bd is still installed at $bd; remove it by hand" >&2 ;;
esac
[ -e "$HOME/.beads" ] && rm -rf "$HOME/.beads" && gone "~/.beads"
[ -d /opt/homebrew/etc/dolt ] && ! command -v dolt >/dev/null 2>&1 && rm -rf /opt/homebrew/etc/dolt && gone "beads' dolt config"

# Cursor. --zap also takes ~/.cursor and its Library state.
if command -v brew >/dev/null 2>&1 && brew list --cask cursor >/dev/null 2>&1; then
    brew uninstall --zap --cask cursor >/dev/null && gone "Cursor"
fi

# Codex desktop's agent import, now pinned off (CODEX_PINS in lib/agent_settings.py), left
# a stow-era copy of AGENTS.md in $HOME (pi and opencode load it as an ancestor of every
# project, after the real one) and Cursor's built-in skills in the shared skills directory.
if [ -f "$HOME/AGENTS.md" ] && grep -q "GNU stow" "$HOME/AGENTS.md"; then
    rm -f "$HOME/AGENTS.md" && gone "~/AGENTS.md"
fi
for skill in create-rule create-skill create-subagent migrate-to-skills shell update-cursor-settings .trash; do
    [ -e "$HOME/.agents/skills/$skill" ] && rm -rf "$HOME/.agents/skills/$skill" && gone "~/.agents/skills/$skill"
done

# Per-agent links back into ~/.agents/skills, which `npx skills add` without `-a` (and
# `orca skills install`) fan out to every agent it detects. These agents read
# ~/.agents/skills already, so the links only duplicate it (skills-install explains).
for dir in "$HOME/.pi/agent/skills" "$HOME/.config/opencode/skills" "$HOME/.codeium/windsurf/skills" "$HOME/.kiro/skills" "$HOME/.snowflake/cortex/skills"; do
    [ -d "$dir" ] && [ ! -L "$dir" ] || continue
    for link in "$dir"/*; do
        [ -L "$link" ] && case $(readlink "$link") in *.agents/skills/*) rm -f "$link" && gone "$link" ;; esac
    done
    rmdir "$dir" 2>/dev/null && gone "$dir"
done

# Superset (its hooks are purged by DENY in lib/agent_settings.py) left slash commands here.
if [ -d "$HOME/.agents/commands/superset" ]; then
    rm -rf "$HOME/.agents/commands/superset" && gone "~/.agents/commands/superset"
    rmdir "$HOME/.agents/commands" 2>/dev/null
fi

# pi npm packages no longer in settings.json: pi stops loading a package dropped from
# `packages` but leaves it installed in ~/.pi/agent/npm. Settings are applied before this
# script runs (it is an after script), so they are the list to keep.
pi_npm="$HOME/.pi/agent/npm"
if [ -f "$pi_npm/package.json" ] && [ -f "$HOME/.pi/agent/settings.json" ] && command -v npm >/dev/null 2>&1; then
    extra=$(python3 - "$pi_npm/package.json" "$HOME/.pi/agent/settings.json" <<'PY'
import json, sys
def name(spec):
    spec = spec[4:]
    at = spec.find("@", 1)
    return spec if at < 0 else spec[:at]
installed = json.load(open(sys.argv[1])).get("dependencies", {})
wanted = {name(p) for p in json.load(open(sys.argv[2])).get("packages", [])
          if isinstance(p, str) and p.startswith("npm:")}
print(" ".join(sorted(set(installed) - wanted)))
PY
)
    if [ -n "$extra" ]; then
        # shellcheck disable=SC2086  # a word list of package names
        npm --prefix "$pi_npm" uninstall --legacy-peer-deps --no-audit --no-fund $extra >/dev/null 2>&1 && gone "pi npm packages: $extra"
    fi
fi
# pi-voice: dictation belongs to the OS (Handy), not to one harness. Its Parakeet model
# stays in the Hugging Face cache, which Handy uses.
[ -e "$HOME/.pi/agent/pi-voice.json" ] && rm -f "$HOME/.pi/agent/pi-voice.json" && gone "~/.pi/agent/pi-voice.json"

# Skills no longer used, or moved out of the global set because they only matter in a few
# projects (install those per project: `npx skills add <repo> -a claude-code` without -g).
# Their entries in skills' lock file go too, so the CLI does not list them as installed.
lock="$HOME/.agents/.skill-lock.json"
for skill in marimo-export-on-commit jupyter-to-marimo marimo-notebook marimo-pair marimo-lens mcp-builder pymc-modeling priorlabs typesafe-ai typst; do
    [ -e "$HOME/.agents/skills/$skill" ] && rm -rf "$HOME/.agents/skills/$skill" && gone "~/.agents/skills/$skill"
    if [ -f "$lock" ] && command -v jq >/dev/null 2>&1 && jq -e --arg s "$skill" '.skills | has($s)' "$lock" >/dev/null 2>&1; then
        jq --arg s "$skill" 'del(.skills[$s])' "$lock" >"$lock.tmp" && mv "$lock.tmp" "$lock"
    fi
done
# find-skills is a personal skill now (dot_agents/skills), forked to follow skills-install's
# rules; chezmoi owns the directory, so only the CLI's lock entry goes.
if [ -f "$lock" ] && command -v jq >/dev/null 2>&1 && jq -e '.skills | has("find-skills")' "$lock" >/dev/null 2>&1; then
    jq 'del(.skills["find-skills"])' "$lock" >"$lock.tmp" && mv "$lock.tmp" "$lock"
fi

# Superset's pi extension (Superset is retired, see above).
[ -e "$HOME/.pi/agent/extensions/superset-hooks.ts" ] && rm -f "$HOME/.pi/agent/extensions/superset-hooks.ts" && gone "~/.pi/agent/extensions/superset-hooks.ts"

# Moshi (iOS terminal) and moshi-hook, its host daemon: dropped. Its hooks in every agent's
# config go first (Claude Code's and Codex's are also purged by DENY in lib/agent_settings.py),
# then the daemon, the binary, its state, and the SSH key its Easy Pair authorized.
moshi=
for p in /opt/homebrew/bin/moshi-hook /usr/local/opt/moshi-hook/bin/moshi-hook "$HOME/.local/bin/moshi-hook"; do
    [ -x "$p" ] && moshi=$p && break
done
if [ -n "$moshi" ]; then
    "$moshi" uninstall >/dev/null 2>&1 && gone "moshi hooks in every agent"
    "$moshi" service uninstall >/dev/null 2>&1
fi
if command -v brew >/dev/null 2>&1 && brew list --formula moshi-hook >/dev/null 2>&1; then
    brew services stop moshi-hook >/dev/null 2>&1
    brew uninstall --formula moshi-hook >/dev/null && gone "moshi-hook (brew)"
fi
command -v brew >/dev/null 2>&1 && brew tap | grep -qx rjyo/moshi && brew untap rjyo/moshi >/dev/null 2>&1 && gone "tap rjyo/moshi"
if [ -f "$HOME/.config/systemd/user/moshi-hook.service" ]; then
    systemctl --user disable --now moshi-hook.service >/dev/null 2>&1
    rm -f "$HOME/.config/systemd/user/moshi-hook.service" && systemctl --user daemon-reload 2>/dev/null
    gone "moshi-hook systemd unit"
fi
for f in "$HOME/.local/bin/moshi-hook" "$HOME/.local/bin/moshi" "$HOME/.local/bin/moshi-setup"; do
    [ -e "$f" ] || [ -L "$f" ] && rm -f "$f" && gone "$f"
done
for d in "$HOME/.config/moshi" "$HOME/.local/state/moshi" "$HOME/Library/Application Support/Moshi"; do
    [ -e "$d" ] && rm -rf "$d" && gone "$d"
done
if [ -f "$HOME/.ssh/authorized_keys" ] && grep -q ' moshi-pair:' "$HOME/.ssh/authorized_keys"; then
    grep -v ' moshi-pair:' "$HOME/.ssh/authorized_keys" >"$HOME/.ssh/authorized_keys.tmp" &&
        chmod 600 "$HOME/.ssh/authorized_keys.tmp" && mv "$HOME/.ssh/authorized_keys.tmp" "$HOME/.ssh/authorized_keys" &&
        gone "Moshi's key in ~/.ssh/authorized_keys"
fi
# The link (or, on hosts without Moshi, the no-op stub) the repo's hooks used to call.
if [ -e /usr/local/bin/moshi-hook ] || [ -L /usr/local/bin/moshi-hook ]; then
    if sudo -n rm -f /usr/local/bin/moshi-hook 2>/dev/null; then gone /usr/local/bin/moshi-hook
    else echo "retired: remove /usr/local/bin/moshi-hook by hand (needs sudo)" >&2; fi
fi

# Claude Code plugins and marketplaces no longer used. (Linear stays, installed at project
# scope in the projects that use it.)
if command -v claude >/dev/null 2>&1; then
    for plugin in superwhisper@superwhisper; do
        grep -q "\"$plugin\"" "$HOME/.claude/plugins/installed_plugins.json" 2>/dev/null &&
            claude plugin uninstall "$plugin" >/dev/null 2>&1 && gone "Claude plugin $plugin"
    done
    for market in superwhisper beads-marketplace; do
        grep -q "\"$market\"" "$HOME/.claude/plugins/known_marketplaces.json" 2>/dev/null &&
            claude plugin marketplace remove "$market" >/dev/null 2>&1 && gone "Claude marketplace $market"
    done
fi
{{- if hasPrefix "mac-" .host }}

# Claude Code's native installer, left over from before the claude-code@latest cask;
# the cask comes first on PATH, so the native copy only goes stale.
if [ -x /opt/homebrew/bin/claude ] && [ -L "$HOME/.local/bin/claude" ] &&
    case $(readlink "$HOME/.local/bin/claude") in "$HOME"/.local/share/claude/*) true ;; *) false ;; esac; then
    rm -f "$HOME/.local/bin/claude" && rm -rf "$HOME/.local/share/claude" && gone "native Claude Code install"
fi
{{- end }}

exit 0
