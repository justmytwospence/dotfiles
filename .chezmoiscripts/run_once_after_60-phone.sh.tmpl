{{- /* Phone access (docs/phone-access.md): Paseo, Heeler. Pairing needs the phone,
       so each script prints its remaining steps. */ -}}
{{- $paseo := or (hasPrefix "mac-" .host) (eq .host "exe") -}}
{{- $heeler := has .host (list "mac-pro" "mac-air" "nuc" "exe") -}}
{{- if or $paseo $heeler -}}
#!/bin/bash
set -uo pipefail
{{ template "script-path.sh" . }}
{{- if $paseo }}
"$HOME/.local/bin/paseo-setup" || echo "paseo-setup failed; rerun it by hand" >&2
{{- end }}
{{- if $heeler }}
"$HOME/.local/bin/heeler-setup" || echo "heeler-setup failed; rerun it by hand" >&2
{{- end }}
{{- end }}
