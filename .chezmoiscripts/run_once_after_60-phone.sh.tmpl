{{- /* Phone access (docs/phone-access.md): Moshi, Paseo, Heeler. Pairing needs the phone,
       so each script prints its remaining steps. */ -}}
{{- $moshi := has .host (list "mac-pro" "mac-air" "nuc" "exe" "m0-hub") -}}
{{- $paseo := or (hasPrefix "mac-" .host) (eq .host "exe") (hasPrefix "paseo-" .host) -}}
{{- $heeler := has .host (list "mac-pro" "mac-air" "nuc" "exe" "m0-hub") -}}
{{- if or $moshi $paseo $heeler -}}
#!/bin/bash
set -uo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
{{- if $moshi }}
"$HOME/.local/bin/moshi-setup" || echo "moshi-setup failed; rerun it by hand" >&2
{{- end }}
{{- if $paseo }}
"$HOME/.local/bin/paseo-setup" || echo "paseo-setup failed; rerun it by hand" >&2
{{- end }}
{{- if $heeler }}
"$HOME/.local/bin/heeler-setup" || echo "heeler-setup failed; rerun it by hand" >&2
{{- end }}
{{- end }}
