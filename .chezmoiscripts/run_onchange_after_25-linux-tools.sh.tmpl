{{- /* Linux user-level tools from .chezmoidata/linux.json: uv tools, global npm
       packages and vendor installers. Install-only, keyed by the executable: a tool
       already on PATH (however it got there) is left alone, so this never upgrades
       or fights a tool's own updater. Reruns when this host's lists change. */ -}}
{{- if has .host (list "nuc" "agentbox-box") -}}
{{- $uv := concat .linux.uv.common (get .linux.uv .host | default (list)) }}
{{- $npm := get .linux.npm .host | default (list) }}
{{- $inst := get .linux.installers .host | default (list) }}
{{- $npmNames := list }}{{ range $npm }}{{ $npmNames = append $npmNames .pkg }}{{ end }}
{{- $uvNames := list }}{{ range $uv }}{{ $uvNames = append $uvNames .pkg }}{{ end }}
{{- $allow := includeTemplate "cooldown-allow.sh" (dict "allow" .cooldownAllow "npm" $npmNames "uv" $uvNames) | trim -}}
#!/bin/bash
# lists hash: {{ list $uv $npm $inst | toJson | sha256sum }}
# cooldown allowances hash: {{ $allow | sha256sum }}
set -uo pipefail
{{ template "script-path.sh" . }}
export PATH="$HOME/.local/bin:$PATH"
have() { command -v "$1" >/dev/null 2>&1; }
failed=()

# npm 10 ignores min-release-age (the 7-day cooldown in ~/.npmrc); npm 11 honours it.
# Pinned to a release past the cooldown; it lands in the npm prefix, ahead of /usr/bin.
if [ "$(npm --version | cut -d. -f1)" -lt 11 ]; then echo "==> npm 11"; npm install -g --no-fund --no-audit npm@11.21.0 || failed+=(npm); hash -r; fi

# OpenCode 1 (opencode-ai) owns the same `opencode` binary as OpenCode 2 (@opencode/cli).
if npm ls -g opencode-ai >/dev/null 2>&1; then echo "==> npm uninstall opencode-ai"; npm uninstall -g opencode-ai || failed+=(opencode-ai); fi
{{- if $allow }}

# Explicitly allowed fresh releases (docs/cooldown.md): installed, or upgraded to, before the
# install-only lists below, which then find the executable already on PATH.
{{ $allow }}
{{- end }}
{{- range $uv }}

have {{ .bin | quote }} || { echo "==> uv tool {{ .pkg }}"; uv tool install {{ .pkg | quote }} || failed+=({{ .pkg | quote }}); }
{{- end }}
{{- range $npm }}

have {{ .bin | quote }} || { echo "==> npm {{ .pkg }}"; npm install -g --no-fund --no-audit {{ if hasKey . "allow_scripts" }}--allow-scripts={{ .pkg | quote }} {{ end }}{{ .pkg | quote }} || failed+=({{ .pkg | quote }}); }
{{- end }}
{{- range $inst }}

have {{ .bin | quote }} || { echo "==> {{ .bin }} (vendor installer)"; bash -c {{ .cmd | quote }} || failed+=({{ .bin | quote }}); }
{{- end }}

# Fail so chezmoi retries next apply instead of recording a partial run as done.
if ((${#failed[@]})); then
    echo "linux tools: failed to install: ${failed[*]}" >&2
    exit 1
fi
{{- end }}
