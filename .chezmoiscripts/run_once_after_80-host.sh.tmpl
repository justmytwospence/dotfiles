{{- /* Per-host tail for an AgentBox box: the hook stand-in and pi's packages. */ -}}
{{- if eq .host "agentbox-box" -}}
#!/bin/bash
set -euo pipefail
BIN=$HOME/.local/bin
{{ template "script-path.sh" . }}
log() { printf '\n==> %s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

# No herdr in a box, so the Claude hook script herdr would own is a stand-in.
mkdir -p "$HOME/.claude/hooks"
[[ -e $HOME/.claude/hooks/herdr-agent-state.sh ]] ||
    printf '#!/bin/sh\n# written by chezmoi: no herdr on this host.\ncat >/dev/null 2>&1\nexit 0\n' \
        > "$HOME/.claude/hooks/herdr-agent-state.sh"
chmod +x "$HOME/.claude/hooks/herdr-agent-state.sh"

if have pi; then
    log "pi packages"
    timeout 900 pi update --extensions </dev/null >/dev/null 2>&1 || true
fi
{{- end }}
