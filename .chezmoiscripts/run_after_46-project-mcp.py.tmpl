#!/usr/bin/env python3
# Every apply: switch project-scoped MCP servers (mcp.json "projects": "<marker>") on in each
# repo in ~/Projects that has the marker, for pi, Codex and opencode. Claude Code's local-scope
# entries come from modify_private_dot_claude.json. Every apply, not on change: the set of
# repos changes without this repo changing. Prints only what it changed.
import os, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join({{ .chezmoi.sourceDir | quote }}, "lib"))
import agent_settings as a  # noqa: E402

try:
    a.enable_project_servers()
except Exception as error:  # never fail the apply over this
    print("project MCP servers: %s" % error, file=sys.stderr)
