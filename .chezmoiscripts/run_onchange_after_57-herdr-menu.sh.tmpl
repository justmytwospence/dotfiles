{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# HerdrMenu (docs/plugins.md): build the pinned source (.chezmoiexternal.toml.tmpl) into
# ~/Applications/HerdrMenu.app, and restart it if it is running. Reruns when the pin changes:
# herdr-menu {{ .herdrMenu.commit }}
set -euo pipefail
{{ template "script-path.sh" . }}

src="$HOME/.local/share/herdr-menu"
if ! xcrun --find swiftc >/dev/null 2>&1; then
    echo "herdr-menu: swiftc is missing; run xcode-select --install, then chezmoi apply again" >&2
    exit 1
fi
sh "$src/build.sh"
if pkill -f "HerdrMenu.app/Contents/MacOS/HerdrMenu"; then
    sleep 1
    open "$HOME/Applications/HerdrMenu.app"
fi
{{- end }}
