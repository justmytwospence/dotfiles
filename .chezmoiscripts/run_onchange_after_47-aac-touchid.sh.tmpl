{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# aac-touchid (Bitwarden Agent Access listener with Touch ID approvals): (re)load its
# LaunchAgent when the plist or the pinned binary changes. Restarting locks the vault;
# the next agent request asks for the master password again.
# plist: {{ include "private_Library/private_LaunchAgents/com.justmytwospence.aac-touchid.plist.tmpl" | sha256sum }}
# binary: {{ .aacTouchid.tag }} {{ get .aacTouchid.sha256 .chezmoi.arch }}
set -euo pipefail
label=com.justmytwospence.aac-touchid
plist="$HOME/Library/LaunchAgents/$label.plist"
domain="gui/$(id -u)"
if [ ! -x "$HOME/.local/libexec/aac-touchid/Bitwarden" ] || [ ! -f "$plist" ]; then
    echo "aac-touchid: binary or LaunchAgent missing; skipping" >&2
    exit 0
fi
launchctl bootout "$domain/$label" 2>/dev/null || true
# bootout returns before the job is gone; bootstrapping too early fails with error 5.
for _ in $(seq 1 20); do
    launchctl print "$domain/$label" >/dev/null 2>&1 || break
    sleep 0.5
done
launchctl bootstrap "$domain" "$plist" || { sleep 2; launchctl bootstrap "$domain" "$plist"; }
for _ in $(seq 1 20); do "$HOME/.local/bin/aac-touchid" status >/dev/null 2>&1 && break; sleep 0.5; done
if "$HOME/.local/bin/aac-touchid" status 2>/dev/null | grep -q '(none)'; then
    echo "aac-touchid: no devices paired yet; run: aac-setup nuc" >&2
fi
{{- end }}
