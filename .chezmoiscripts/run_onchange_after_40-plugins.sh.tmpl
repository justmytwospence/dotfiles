#!/bin/bash
# Native installers own Pi and Herdr installations. Chezmoi owns standalone
# plugin archives and skills (.chezmoiexternal.toml.tmpl).
# Pi settings {{ include "private_dot_pi/private_agent/settings.managed.json" | sha256sum }}
set -euo pipefail
{{ template "script-path.sh" . }}

# Update only configured Git packages, not Pi itself or unpinned npm packages.
# Targeted update reconciles existing clones to the configured commit.
if command -v pi >/dev/null 2>&1; then
{{- range (include "private_dot_pi/private_agent/settings.managed.json" | fromJson).packages }}
{{- $source := . }}
{{- if kindIs "map" . }}{{ $source = .source }}{{ end }}
{{- if hasPrefix "git:" $source }}
    pi update {{ $source | quote }}
{{- end }}
{{- end }}
fi

{{ if has .host (list "mac-pro" "mac-air" "nuc") -}}
# These native installs run their own build and registration steps. A failed
# install fails apply rather than recording incomplete provisioning as success.
if ! command -v herdr >/dev/null 2>&1; then
    echo "herdr is required for this host's plugins" >&2
    exit 1
fi
herdr plugin install justmytwospence/herdr-git-status --ref 39beeb7dca104ddf1b0763ede503773658a0be50 --yes
herdr plugin install smarzban/herdr-file-viewer --ref 3996b88d6c6ca5608872abedf05067a803a168ec --yes
herdr plugin install justmytwospence/herdr-undo --ref e65a79a5b1c1814b61a4573d908d0ca0c0c94fc4 --yes
# pi-sidebar's pane navigation (prefix+h/j/k/l in the herdr config); keep its ref with the pi-plugins pin.
herdr plugin install justmytwospence/pi-plugins/packages/pi-sidebar/herdr-plugin --ref d4e68cd3dc4a1df77ce5d268b1bbea08c21042b0 --yes
# Its build step runs terminal-browser's own installer: the app on the NUC
# (~/.local/share/terminal-browser, wrapper in ~/.local/bin), a redundant copy
# behind the cask on Macs. SKIP_SETUP stops that installer's `setup` from
# linking global agent skills; ~/.local/state/terminal-browser/skills-choice
# (managed) declines them for the app's own first-run setup.
TERMINAL_BROWSER_SKIP_SETUP=1 herdr plugin install zenbu-labs/terminal-browser/herdr-plugin --ref 4fb68a1cc0e0f5898c4d08712a4ce9f4bfc81d94 --yes
{{ if hasPrefix "mac-" .host -}}
herdr plugin install madarco/agentbox --ref 71ed05309b27346f1ae9e07b59f33ad88ce488ad --yes
{{ else if eq .host "nuc" -}}
herdr plugin install justmytwospence/herdr-agentbox --ref 2b8276fe1d0f72ad29f2e9b3c13b7aa101e5f90d --yes
{{ end -}}
{{ end -}}
