#!/bin/bash
# Self-maintained plugins at their pins (README "Plugins"). Reruns whenever a pin moves:
#   pins {{ includeTemplate "dot_config/plugins/pins.tmpl" . | sha256sum }}
#   pi   {{ include "private_dot_pi/private_agent/settings.managed.json" | sha256sum }}
set -euo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
"$HOME/.local/bin/plugins" sync
