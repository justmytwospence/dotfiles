{{- /* Target paths chezmoi leaves alone on this host. Templated: see .chezmoi.toml.tmpl for .host and .extras. */ -}}
{{- $extras := splitList "," (.extras | replace " " "") -}}
{{- $mac := hasPrefix "mac-" .host -}}

# Repo files that are not targets (dot-prefixed agent metadata is ignored automatically)
AGENTS.md
CLAUDE.md
README.md
docs
lib
linux-desktop
# The managed halves of the modify_ targets: read by the modify_ scripts, never written to $HOME
**/*.managed.json
# Docker Desktop owns ~/.docker/config.json (credsStore, contexts); kept for reference only
.docker
# Claude Code generates these runtime type links/configs inside mod archives.
# Keep them outside chezmoi ownership, including exact archive deletion.
.local/share/plugins/**/.claude-plugin/types
.local/share/plugins/**/.claude-plugin/types/**
.local/share/plugins/claude-code-playground/claude-code/mods/token-weather/tsconfig.json

{{ if not $mac -}}
# macOS only
.Brewfile
.gvimrc
.config/ghostty
.config/karabiner
.config/muse
.config/swiftbar
Library
raycast-scripts
# Native Mac notifications; the Mac's watcher already covers remote herdr machines
.config/herdr/plugins/config/herdr-native-notify
.local/bin/herdr-native-notify
{{- end }}

{{ if $mac -}}
# systemd user units are Linux-only
.config/systemd
{{- end }}

{{ if ne .host "mac-pro" -}}
# Local LLMs on the pro Mac only (docs/agents.md)
.config/llama-swap
.lmstudio
Library/LaunchAgents/com.spencerboucher.llama-swap.plist
{{- end }}

{{ if ne .host "nuc" -}}
# telebrowser runs on the NUC only (~/homelab/telebrowser): its launcher link and skill
.local/bin/telebrowser
.agents/skills/telebrowser
# The NUC's always-on herdr server (docs/herdr.md)
.config/systemd/user/herdr.service
.config/systemd/user/default.target.wants/herdr.service
# herdr-agentbox settings (NUC only): a new space stays a plain shell
.config/herdr-agentbox
{{- end }}

{{ if eq .host "agentbox-box" -}}
# No herdr in an AgentBox box
.config/herdr
{{- end }}

{{ if not (and (has .host (list "mac-pro" "mac-air" "nuc")) (stat (joinPath .chezmoi.homeDir ".config/chezmoi/key.txt"))) -}}
# API keys: decrypted only where the age key has been copied (README "Secrets")
.config/dotfiles
{{- end }}

{{ if not (has "emacs" $extras) -}}
.emacs.d
.config/systemd/user/emacs.service
{{- end }}

{{ if not (has "jupyter" $extras) -}}
.jupyter
.ipython
{{- end }}

{{ if not (has "linux-desktop" $extras) -}}
.Xmodmap
.config/Code
.config/alacritty
.config/albert
.config/autostart
.config/gtk-3.0
.config/i3
.config/kitty
.config/polybar
.config/rofi
.config/run-or-raise
.config/systemd/user/terminator.service
.config/terminator
.local/bin/remap-keys
{{- end }}
