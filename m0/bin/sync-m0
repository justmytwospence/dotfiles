#!/usr/bin/env bash
# sync-m0 -- herdr-machine0 `sync_command` for spokes (m0/.config/herdr-machine0/config.json).
#
# The hub runs it on a spoke at creation and on `spoke sync`, after pushing its
# own plugin there. Pulls dotfiles and redoes the steps a pull can invalidate;
# skips them, and says "already current", when dotfiles did not move since the
# last run (the golden image build runs it once, so fresh clones usually skip).
set -euo pipefail

DOTFILES=${DOTFILES_DIR:-$HOME/dotfiles}
STAMP=$HOME/.local/state/herdr-machine0/synced

cd "$DOTFILES"
git pull --rebase --autostash -q
now=$(git rev-parse HEAD)
if [[ -f $STAMP && $(cat "$STAMP") == "$now" ]]; then
    echo "dotfiles already current"
else
    "$DOTFILES/shell/.local/bin/dotfiles-restow" shell m0 || [[ $? -eq 1 ]]
    "$DOTFILES/shell/.local/bin/plugins" sync
    "$DOTFILES/shell/.local/bin/skills-install" >/dev/null 2>&1 || true
    mkdir -p "$(dirname "$STAMP")" && echo "$now" > "$STAMP"
fi
# herdr-attention-queue's pi bridge, which its herdr startup hook would install
# on a machine running a herdr server.
HERDR_MACHINE0_ATTENTION_QUEUE=$HOME/.local/share/plugins/herdr-attention-queue ~/.local/bin/spoke install-pi-extension
