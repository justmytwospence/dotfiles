{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "if [ -f \"$HOME/.codex/herdr-agent-state.sh\" ]; then bash \"$HOME/.codex/herdr-agent-state.sh\" session; fi",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.local/share/plugins/tmux-agents/bin/agent-state\" clear",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.local/share/plugins/codex-cache-guard/bin/codex-cache-guard\" ]; then \"$HOME/.local/share/plugins/codex-cache-guard/bin/codex-cache-guard\" session-start; fi",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.local/share/plugins/tmux-agents/bin/agent-state\" done",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.local/share/plugins/codex-cache-guard/bin/codex-cache-guard\" ]; then \"$HOME/.local/share/plugins/codex-cache-guard/bin/codex-cache-guard\" stop; fi",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.local/share/plugins/tmux-agents/bin/agent-state\" running",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.local/share/plugins/codex-cache-guard/bin/codex-cache-guard\" ]; then \"$HOME/.local/share/plugins/codex-cache-guard/bin/codex-cache-guard\" prompt; fi",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.local/share/plugins/tmux-agents/bin/agent-state\" running",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.local/share/plugins/tmux-agents/bin/agent-state\" clear",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.local/share/plugins/codex-cache-guard/bin/codex-cache-guard\" ]; then \"$HOME/.local/share/plugins/codex-cache-guard/bin/codex-cache-guard\" session-end; fi",
            "timeout": 3,
            "type": "command"
          }
        ]
      }
    ]
  }
}
