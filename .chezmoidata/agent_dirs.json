{
  "agentDirs": {
    "hosts": ["mac-pro"],
    "private": ["~/Projects", "~/dotfiles", "~/Documents", "~/Desktop", "~/Downloads", "~/Library/Mobile Documents"],
    "alwaysWrite": [
      "/tmp", "/private/tmp", "/dev", "$TMPDIR",
      "~/.cache", "~/Library/Caches", "~/.npm", "~/.bun", "~/.cargo", "~/.rustup", "~/.pyenv", "~/.local/share", "~/.local/state"
    ],
    "derived": {
      "paths": [
        "~/.config", "~/.local/bin", "~/.agents", "~/.pi/agent", "~/.claude", "~/.codex", "~/.zsh", "~/.tmux",
        "~/.vim", "~/.emacs.d", "~/Library/LaunchAgents"
      ],
      "hint": "If chezmoi manages this file, edit its source in ~/dotfiles instead (`chezmoi source-path <file>` names it), then deploy it with `chezmoi apply <file>`. If it is not managed, ask the user."
    },
    "exemptCommands": ["chezmoi apply", "chezmoi update"],
    "projects": {
      "dotfiles": {"root": "~/dotfiles", "read": ["*"], "write": ["~/Projects/pi-plugins", "~/Projects/herdr-*"]},
      "pi-plugins": {"root": "~/Projects/pi-plugins", "read": ["~/Projects/herdr-*"], "write": ["~/dotfiles"]},
      "herdr-agentbox": {"root": "~/Projects/herdr-agentbox", "read": ["~/Projects/pi-plugins"], "write": ["~/dotfiles"]},
      "herdr-focus-notify": {"root": "~/Projects/herdr-focus-notify", "read": ["~/Projects/pi-plugins"], "write": ["~/dotfiles"]},
      "herdr-git-status": {"root": "~/Projects/herdr-git-status", "read": ["~/Projects/pi-plugins"], "write": ["~/dotfiles"]},
      "herdr-native-notify": {"root": "~/Projects/herdr-native-notify", "read": ["~/Projects/pi-plugins"], "write": ["~/dotfiles"]},
      "herdr-repeat-navigation": {"root": "~/Projects/herdr-repeat-navigation", "read": ["~/Projects/pi-plugins"], "write": ["~/dotfiles"]},
      "herdr-sort-spaces": {"root": "~/Projects/herdr-sort-spaces", "read": ["~/Projects/pi-plugins"], "write": ["~/dotfiles"]},
      "herdr-undo": {"root": "~/Projects/herdr-undo", "read": ["~/Projects/pi-plugins"], "write": ["~/dotfiles"]},
      "blog": {"root": "~/Projects/blog", "read": ["*"], "write": []}
    }
  }
}
