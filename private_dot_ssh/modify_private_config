#!/bin/sh
# Keeps the NUC's hand-kept ~/.ssh/config and only makes sure it reads
# ~/.ssh/config.d/*, where the managed Host entries live (NUC only, .chezmoiignore).
current=$(cat)
case "$current" in
    *"Include ~/.ssh/config.d/*"*) printf '%s\n' "$current" ;;
    *) printf 'Include ~/.ssh/config.d/*\n\n%s\n' "$current" ;;
esac
