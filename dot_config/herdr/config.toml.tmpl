{{- $mac := hasPrefix "mac-" .host -}}
# herdr configuration -- managed in dotfiles (chezmoi source:
# dot_config/herdr/config.toml.tmpl, one file for every host; the host-specific
# parts are template branches). Runtime files (sockets, logs, session.json,
# *.lock, release-notes.json) are herdr's own and stay out of the repo.
# Validate with `herdr config check`; hot-reload with `herdr server reload-config`.
{{- if eq .host "nuc" }}
#
# The NUC: remote agent workspace for ~/homelab.
# Attach from the Mac with: herdr --remote nuc (the default session)
{{- else if not $mac }}
#
# A remote agent workspace, one of the machines in the Mac's herdr window.
# Added there with: herdr machine add <host> --label <name>
{{- end }}
{{- if not $mac }}
#
# Key bindings are client-local (unless a client attaches with
# --remote-keybindings server), so this host carries no [keys] table: the Mac's
# bindings apply when it views this machine.
{{- end }}

onboarding = false

[theme]
# "terminal" inherits the outer terminal's own palette, so herdr follows Ghostty's
# auto light/dark instead of pinning a herdr theme.
name = "terminal"

[terminal]
{{- if eq .host "nuc" }}
# New panes/tabs/workspaces default into the homelab repo.
new_cwd = "~/homelab"
{{- else }}
# New splits/tabs/workspaces open in the focused pane's cwd (matches the tmux %/" habit).
new_cwd = "follow"
{{- end }}
# Herdr's default, stated so terminal-browser's open (which greps for this line)
# does not append [experimental] kitty_graphics = true to the deployed copy.
kitty_graphics = true

[ui]
# Mouse was deliberately re-enabled for herdr+tmux (dotfiles commit 2746b9e).
mouse_capture = true
# Match the Ghostty/tmux OSC-52 copy-on-select clipboard flow.
copy_on_select = true
# One tab per space is the norm here, so the tab bar is pure chrome; it
# reappears as soon as a space gets a second tab.
hide_tab_bar_when_single_tab = true

# One queue across every connected machine: blocked, then done, then working,
# then idle, most recent change first within each. "done" means finished and not
# yet viewed, so an agent drops to idle (and down the list) once you look at it.
agent_panel_sort = "priority"
# Distinct glyphs per state, not just coloured dots.
status_indicators = "symbols"
# herdr renders the title on the server, so every host carries the same line.
window_title = "herdr {hostname}: {workspace}"
[ui.toast]
# In-app toasts, for every connected machine, except for the tab you are on.
# Clicking one, or prefix+o (open_notification_target) while it shows (5 s for
# finished, 8 s for needs input), focuses the agent's pane, switching machines
# if needed. herdr-native-notify supplies native Mac alerts separately, with
# exact Ghostty/pane routing and timed cleanup, plus alerts for attached saved
# machines whose clicks cannot switch machines (docs/herdr.md). Herdr has one
# client-wide mode, so keep these toasts for remote federation: suppressing only
# the local duplicates needs upstream support. Sounds ([ui.sound]) still play
# when Ghostty is in the background.
# tmux-agents' Claude hook stays silent under HERDR_ENV.
delivery = "herdr"

[ui.toast.herdr]
position = "top-right"

[ui.sound]
# Play a sound when an agent in a BACKGROUND space changes state (needs input or
# done). No sound for the space you are actively viewing, by design. droid is
# muted by herdr default; claude/codex/etc. are audible.
enabled = true

# One line per agent: state icon, workspace, then the tab and machine only when
# they say something (a tab renamed from herdr's default "1"; a machine other
# than Local), then the cache-guard plugins' pane token `cache` (pi, Claude Code,
# opencode, Codex; docs/plugins.md): "❄ 664k" while the next prompt would
# re-cache that much history (at least $0.50 at API prices), nothing while the
# cache is warm or small. "❄?" is a guess from idle time (Codex, OpenAI
# models in pi): dimmer. Then the marimo ports' pane token `marimo` (pi, Claude
# Code, opencode): "fit.py: Model fit" while a cell the agent started outlives
# its turn (the pane itself reads idle), nothing otherwise; a notification
# follows when the run finishes. Then pi-herdr's `bg` (pi): background work that
# will wake the agent ("subagents (2) · child auth-fix"), while the pane itself
# may read done.
[ui.sidebar.agents]
rows = [
  ["state_icon", "workspace",
   { token = "tab", rules = [{ equals = "1", hide = true }] },
   { token = "machine", dim = true, rules = [{ equals = "Local", hide = true }] },
   { token = "$cache", fg = "#5f87d7", rules = [{ starts_with = "❄?", dim = true }] },
   { token = "$marimo", fg = "#d7af5f" },
   { token = "$bg", fg = "#87af87" }],
]

# One Git row item: * uncommitted work, ↑N ↓N commits, ! conflict/unavailable
# or paused operation. Spaces within the summary avoid native separators
# between marks; no tracking labels, file counts, or clean markers.
# Normal spaces: name on row one, branch + summary + existing PR on row two.
# Linked children already show their branch as the row-one label and suppress
# native branch; only they get a row-one suffix to preserve their one-row height.
[ui.sidebar.spaces]
rows = [
  ["state_icon", "workspace",
   { token = "$git_child_summary", fg = "#87af87", rules = [
     { contains = "!", fg = "#d75f5f", bold = true },
     { contains = "↓", fg = "#d75f5f" },
     { contains = "*", fg = "#d7af00" }] }],
  ["branch",
   { token = "$git_summary", fg = "#87af87", rules = [
     { contains = "!", fg = "#d75f5f", bold = true },
     { contains = "↓", fg = "#d75f5f" },
     { contains = "*", fg = "#d7af00" }] },
   { token = "$pr", fg = "#5f87d7" }],
]

[session]
# Reconnect Claude/agent panes to their native sessions after a server restart --
# this is exactly what the SessionStart hook (herdr-agent-state.sh) feeds.
resume_agents_on_restore = true

[worktrees]
# Only herdr's sidebar "New worktree" uses this one global directory, so don't:
# every worktree lives in <repo>/.worktrees (docs/agents.md "Worktrees"), which
# prefix+G (below) and everything else pass to herdr as an explicit --path.
directory = "~/.herdr/worktrees"

[experimental]
# Restore each pane's recent on-screen history across a full server restart, so a
# restart brings back the layout AND what was on screen (pairs with
# [session].resume_agents_on_restore, which reconnects the agents themselves).
pane_history = true

[advanced]
# Big per-pane scrollback to match the 100k-line Ghostty scrollback you keep "for
# Claude Code output". Default is 10 MB; this is ~50 MB.
scrollback_limit_bytes = 52428800

{{- if $mac }}

[keys]
# Mirror ~/.tmux.conf. Every binding below is either a key tmux itself uses or a
# key bound explicitly in .tmux.conf; herdr-only actions were moved off the keys
# tmux claims. Punctuation is written as the literal character (herdr also
# accepts names like "ampersand", but the literal is unambiguous).
#
# herdr has no `bind -r` repeat, so held sequences need the prefix each time.
# Plain n/p and Ctrl-j/k navigate spaces; Enter jumps to priority work.
prefix = "ctrl+b"

# Session/global. tmux prefix+q is display-panes, NOT detach -- leaving herdr's
# default there was an easy way to detach by accident.
detach = "prefix+d"                  # tmux: prefix d  detach-client
help = "prefix+?"                    # tmux: prefix ?  list-keys
settings = "prefix+shift+s"          # herdr-only; moved off prefix+s for tmux
reload_config = "prefix+shift+r"     # herdr-only
toggle_sidebar = "prefix+b"          # herdr-only (unbound in tmux)
open_notification_target = "prefix+o"  # herdr-only; see cycle_pane_next below
goto = ["prefix+s", "prefix+f"]     # herdr-only; Goto searches every machine

# SPACES = tmux windows. herdr has one level more than tmux (space > tab >
# pane), and in practice each space here holds a single tab, so it is the space
# -- not the tab -- that a tmux window corresponds to. The whole tmux window
# family therefore drives spaces.
new_workspace = "prefix+c"           # tmux: prefix c  new-window
rename_workspace = "prefix+,"        # tmux: prefix ,  rename-window
close_workspace = "prefix+&"         # tmux: bind & kill-window
# Ctrl-j/k follow the sidebar's down/up space order; n/p stay as aliases.
next_workspace = ["prefix+n", "prefix+ctrl+j"]
previous_workspace = ["prefix+p", "prefix+ctrl+k"]
workspace_picker = "prefix+w"        # tmux: prefix w  choose-window
# prefix+w highlights spaces on every connected machine (next/previous_workspace
# only see the selected machine). Ctrl-j/k move the highlight like they move
# spaces; Enter switches, Esc cancels. h/j/k/l stay pane moves there.
navigate_workspace_down = ["down", "ctrl+j"]
navigate_workspace_up = ["up", "ctrl+k"]
switch_workspace = "prefix+1..9"     # tmux: prefix 1-9 select-window
# Agents across every machine, in Agents panel order (priority: blocked first).
# Alt-1..9 (no prefix) focuses the Nth agent, so Alt-1 is the most urgent; hold
# Alt and tap j/k to walk down/up the list (wrapping). The prefix forms stay for
# tmux habit. pi, Claude Code and zsh leave Alt-digits and Alt-j/k unbound.
# Viewing a done agent turns it idle, which is herdr's acknowledgement.
focus_agent = ["prefix+alt+1..9", "alt+1..9"]
# ctrl+alt+shift+f12 is reserved for herdr-native-notify: a notification click
# narrows the Agents list to its target and sends this key to the bound Ghostty
# surface, so herdr itself switches machine and pane. Ghostty 1.3.1's scripted
# `send key` only encodes function keys; keep it a function key.
next_agent = ["prefix+enter", "alt+j", "ctrl+alt+shift+f12"]
previous_agent = "alt+k"
# herdr's built-in dialog only knows the global [worktrees] directory;
# prefix+G (below) creates per-repo .worktrees checkouts instead.
new_worktree = ""

# TABS are herdr's extra level, with no tmux counterpart. They keep the shift
# family so nothing here competes with a tmux binding. Left indexed switching
# to the spaces above; prefix+shift+1..9 collides with shifted punctuation.
new_tab = "prefix+shift+c"
rename_tab = "prefix+shift+t"
close_tab = "prefix+shift+x"
next_tab = ["prefix+shift+right", "prefix+alt+l", "prefix+ctrl+n"]
previous_tab = ["prefix+shift+left", "prefix+alt+h", "prefix+ctrl+p"]
switch_tab = ""
rename_pane = "prefix+shift+p"       # herdr-only

# Panes. herdr names splits the vim way (vertical = side by side, horizontal =
# stacked), which is the opposite of tmux's -h/-v flags -- so these two lines
# read inverted but land exactly where .tmux.conf puts them.
split_vertical = 'prefix+"'          # tmux: bind '"' split-window -h (left/right)
split_horizontal = "prefix+%"        # tmux: bind %   split-window    (top/bottom)
# prefix+h/j/k/l (tmux: select-pane -L/-D/-U/-R) are pi-sidebar-nav's actions below:
# the same pane moves, plus moves between a Pi session and its pi-sidebar.
focus_pane_left = ""
focus_pane_down = ""
focus_pane_up = ""
focus_pane_right = ""
# tmux has prefix+o AND C-o for pane cycling; .tmux.conf binds C-o, so that is
# the one that gets the action and prefix+o stays herdr's notification jump.
cycle_pane_next = ["prefix+ctrl+o", "prefix+ctrl+l"]
cycle_pane_previous = ["prefix+shift+tab", "prefix+ctrl+h"]
last_pane = "prefix+;"               # tmux: prefix ;  last-pane
close_pane = "prefix+x"              # tmux: bind x kill-pane (no prompt)
zoom = ""                            # unused; prefix+z is herdr-undo (below)
copy_mode = "prefix+["               # tmux: prefix [  copy-mode
edit_scrollback = "prefix+e"         # herdr-only (scrollback into $EDITOR)
resize_mode = "prefix+r"             # herdr-only modal resize
# Ctrl-h/j/k/l now navigate. Use prefix+r's resize mode instead.
resize_pane_left = ""
resize_pane_down = ""
resize_pane_up = ""
resize_pane_right = ""
# tmux's `bind -r < / >` swap-window has no herdr workspace action, so it is
# not mirrored.
# Undocumented but real herdr actions; tmux's {/} are cyclic rather than
# directional, so these keep herdr's mnemonic shift+hjkl instead.
swap_pane_left = "prefix+shift+h"
swap_pane_down = "prefix+shift+j"
swap_pane_up = "prefix+shift+k"
swap_pane_right = "prefix+shift+l"


# Fuzzy command palette (tmux's command-prompt key): herdr's API commands and
# plugin actions, run against the pane it was opened from on the machine you are
# viewing, plus every key binding for client-only actions. Type to filter.
[[keys.command]]
key = "prefix+:"
type = "popup"
command = '"$HOME/.local/bin/herdr-commands"'
description = "command palette"
width = "80%"
height = "60%"

# New worktree in <repo>/.worktrees/<branch> (slashes as dashes), opened as a
# grouped herdr worktree space. herdr's own `worktree create --path` does the
# work; the repo is the one under the focused pane, even from inside a worktree.
[[keys.command]]
key = "prefix+shift+g"               # herdr-only
type = "popup"
description = "new worktree (<repo>/.worktrees)"
height = 8
command = '''bash -c '
cwd=${HERDR_ACTIVE_PANE_CWD:-$PWD}
if ! common=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
  read -rsn1 -p "Not in a git repository ($cwd). Any key to close. " _; exit 0
fi
root=${common%/.git}
echo "New worktree in $root/.worktrees/"
# Read the branch by hand so Escape cancels (plain `read` cannot see it).
esc=$(printf "\033"); del=$(printf "\177"); bs=$(printf "\b"); b=
printf "Branch (Esc to cancel): "
stty -echo; trap "stty echo" EXIT
while IFS= read -rn1 k; do
  case $k in
    "$esc") exit 0 ;;
    "") break ;;
    "$del"|"$bs") [ -n "$b" ] && { b=${b%?}; printf "\b \b"; } ;;
    *) b+=$k; printf %s "$k" ;;
  esac
done
echo
[ -n "$b" ] || exit 0
herdr worktree create --cwd "$root" --branch "$b" --path "$root/.worktrees/${b//\//-}" --focus >/dev/null ||
  read -rsn1 -p "Failed. Any key to close. " _
''''

# herdr-file-viewer (pinned in chezmoi's native Herdr install script): toggles a read-only file tree
# in a split beside the focused pane, at its cwd. tmux's prefix+t (clock) is unused.
[[keys.command]]
key = "prefix+t"
type = "plugin_action"
command = "herdr-file-viewer.open-file-viewer"
description = "file viewer (split)"

# herdr-undo (pinned in chezmoi's native Herdr install script): reopens the last
# closed pane, tab or space with its layout, directories and labels, resuming
# agent sessions; repeat to go further back. Processes and scrollback are gone.
[[keys.command]]
key = "prefix+z"
type = "plugin_action"
command = "herdr-undo.reopen"
description = "reopen last closed pane/tab/space"

# pi-sidebar-nav (pi-plugins' packages/pi-sidebar/herdr-plugin, pinned in chezmoi's native Herdr
# install script): Herdr's pane focus, except that in a Pi pane the move goes to Pi first, so it
# also moves between main and pi-sidebar's in-process split as if Sidebar were a pane.
[[keys.command]]
key = "prefix+h"
type = "plugin_action"
command = "pi-sidebar-nav.focus-left"
description = "focus left (pane or Pi Sidebar)"

[[keys.command]]
key = "prefix+j"
type = "plugin_action"
command = "pi-sidebar-nav.focus-down"
description = "focus down (pane or Pi Sidebar)"

[[keys.command]]
key = "prefix+k"
type = "plugin_action"
command = "pi-sidebar-nav.focus-up"
description = "focus up (pane or Pi Sidebar)"

[[keys.command]]
key = "prefix+l"
type = "plugin_action"
command = "pi-sidebar-nav.focus-right"
description = "focus right (pane or Pi Sidebar)"
{{- end }}

{{- if $mac }}

# Still not mirrorable:
#   tmux `Space` next-layout -> herdr has no cycle-layout action or API
#   tmux `!` break-pane      -> pane.move exists in the API but always leaves a
#                               spare shell pane behind in the new tab
#   tmux `u` (tmux-fzf-url)  -> would need an fzf URL picker in a herdr popup
{{- end }}
{{- if $mac }}

# AgentBox's herdr plugin (pinned in chezmoi's native Herdr install script, docs/agentbox.md). Its build
# step splices this exact block (markers included) back at the end of this file, so it
# must stay identical and last, or every plugin install leaves the file drifted.

# >>> agentbox install herdr (managed) >>>
# Remove this block (or run `herdr config reset-keys`) to drop the shortcuts.
[[keys.command]]
key = "prefix+a"
type = "plugin_action"
command = "agentbox.boxes"
description = "AgentBox: boxes overlay"

[[keys.command]]
key = "prefix+shift+a"
type = "plugin_action"
command = "agentbox.new"
description = "AgentBox: new box"
# <<< agentbox install herdr (managed) <<<
{{- end }}
