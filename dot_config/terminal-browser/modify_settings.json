#!/usr/bin/env python3
# ~/.config/terminal-browser/settings.json: the keys in settings.managed.json (telemetry off)
# are the repo's and always win; what `terminal-browser config set` writes otherwise stays.
import os, sys
sys.dont_write_bytecode = True  # no __pycache__ in the source tree
os.environ["CHEZMOI_SOURCE_DIR"] = os.environ.get("CHEZMOI_SOURCE_DIR") or os.popen("chezmoi source-path").read().strip()
sys.path.insert(0, os.path.join(os.environ["CHEZMOI_SOURCE_DIR"], "lib"))
import agent_settings as a  # noqa: E402

a.run_json("dot_config/terminal-browser/settings.managed.json", lambda live, managed: a.deep_merge(live, managed))
