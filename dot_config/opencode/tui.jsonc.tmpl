{
  // opencode TUI config -- written by chezmoi to ~/.config/opencode/tui.jsonc. Separate from
  // opencode.jsonc, with its own schema: https://opencode.ai/tui.json
  //
  // herdr and Orca own the plugin entries below (`herdr integration install
  // opencode` and Orca's agent-status setup rewrite this file to ensure them), so
  // they are kept here too: each installer then finds its entry present and the
  // next `chezmoi apply` has nothing to undo. Orca's only where Orca put its file.
  // opencode-marimo, opencode-cache-guard, opencode-next-prompt and opencode-herdr are ours: the TUI
  // halves of the plugins in opencode.jsonc, at the same commits (`plugins pin <repo>`
  // bumps both). opencode-git-status is ours too, TUI-only: the git status beside the
  // prompt, in the format every prompt and footer shares (~/.local/bin/git-status-line).
  // opencode-prose-width, TUI-only: prose wraps at a readable measure, code and tables full width.
  "$schema": "https://opencode.ai/tui.json",
{{- $orca := joinPath .chezmoi.homeDir ".config/opencode/plugins/orca-opencode-status-tui/tui.js" }}
  "plugin": [
    "opencode-marimo@github:justmytwospence/opencode-marimo#17e4a0fce53ae6e95ee0fb1efe3cd4c0504d6bc7",
    "opencode-cache-guard@github:justmytwospence/opencode-cache-guard#b71f753190bdce7a7034b8bcf7ef7f882365d3d9",
    "opencode-next-prompt@github:justmytwospence/opencode-next-prompt#5d9bb0882a4450fed5972105d669ac8b5c42f42f",
    "opencode-herdr@github:justmytwospence/opencode-herdr#f9fd4da2d11d8c428546b0eff6c7617a66c593b3",
    "opencode-git-status@github:justmytwospence/opencode-git-status#552cdb69bb1db0dc26dca153e05e9fa50692e94b",
    "opencode-prose-width@github:justmytwospence/opencode-prose-width#3d070927944182bc88c94a1620354927c32edbfd",
    "./herdr-tui-session.js"{{ if stat $orca }},
    "file://{{ $orca }}"{{ end }}
  ],

  // "system" builds the palette from the terminal's own colors and derives
  // light/dark from the background it reads back, so opencode follows Ghostty's
  // auto-switching the way herdr's "terminal" theme and Claude Code's
  // "dark-ansi" do. It falls back to the built-in "opencode" theme if the
  // terminal does not answer the color query. prefix theme_mode_lock pins it.
  "theme": "system",

  // Matches herdr's mouse_capture = true.
  "mouse": true,
  // "auto" adapts the diff to terminal width, which suits the split panes.
  "diff_style": "auto",

  // Aligned with Claude Code's defaults (the reference harness), and with the
  // shell's ctrl+p/ctrl+n history. Leader stays ctrl+x, Claude's chord prefix.
  // Only departures from opencode's defaults are listed.
  "keybinds": {
    "history_previous": "up,ctrl+p",
    "history_next": "down,ctrl+n",
    "command_list": "<leader>p",            // was ctrl+p; "/" still opens commands
    "model_list": "alt+p,<leader>m",        // Claude: alt+p model picker
    "variant_cycle": "alt+t",               // Claude: alt+t thinking
    "agent_cycle": "shift+tab",             // Claude: shift+tab cycles modes
    "agent_cycle_reverse": "none",
    "tool_details": "ctrl+o",               // Claude: ctrl+o verbose transcript
    "prompt_stash": "ctrl+s",               // Claude: ctrl+s stash prompt
    "editor_open": "ctrl+g,<leader>e",      // Claude: ctrl+g external editor
    "messages_first": "home"                // was ctrl+g,home
  }
}
