# The droidtty bridge for the NUC's herdr (docs/phone-access.md): the Droidtty iOS app
# pairs with it (`droidtty-cli pair --url wss://nuc.spencerboucher.com:<port>`) and
# reaches it over WireGuard. Its keys, TLS certificate (pinned by the app) and paired
# devices are ~/.config/droidtty. NUC only (.chezmoiignore).
[Unit]
Description=droidtty bridge (herdr on the phone)
After=herdr.service
Wants=herdr.service

[Service]
Type=simple
ExecStart=/usr/bin/zsh -c 'exec droidtty-cli serve --herdr-socket %h/.config/herdr/herdr.sock'
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
