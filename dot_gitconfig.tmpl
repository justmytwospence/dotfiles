[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
{{- if has .host (list "exe" "m0-hub" "paseo-hub") }}
# exe.dev host: no GitHub SSH key. GitHub goes through the exe.dev GitHub
# integration proxy, which serves public repos outright and private ones that
# have an integration attached:
#   ssh exe.dev integrations add github --name <repo> \
#       --repository justmytwospence/<repo> --attach vm:<vm> --act-as-user
# The first block cancels the ssh rewrite below: git takes the longest matching
# insteadOf and, on a tie, the one it read first. The second routes your own
# repos through the proxy in every URL spelling, so every machine keeps the same
# git@github.com: remotes.
[url "https://github.com/"]
	insteadOf = https://github.com/
[url "https://github.int.exe.xyz/justmytwospence/"]
	insteadOf = https://github.com/justmytwospence/
	insteadOf = git@github.com:justmytwospence/
	insteadOf = ssh://git@github.com/justmytwospence/
{{- else if has .host (list "m0-spoke" "paseo-spoke") }}
# machine0 host: the machine0 profile connects GitHub (a GitHub App token for
# gh) and there is no SSH key, so cancel the ssh rewrite below and use gh as the
# credential helper. The credential blocks are exactly what `gh auth setup-git`
# writes (machine0 runs it at boot), trailing space included, so that rewrite
# changes nothing.
[url "https://github.com/"]
	insteadOf = https://github.com/
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
{{- else if eq .host "agentbox-box" }}
# AgentBox box: `git` is AgentBox's shim, which hands clone/fetch/pull/push to the
# hub, and the hub holds the GitHub credential. The box has no key and needs no
# helper; cancel the ssh rewrite below so anything that runs the real git (setup,
# a tool cloning a public repo) uses https as given.
[url "https://github.com/"]
	insteadOf = https://github.com/
{{- end }}
# Fresh clones get their herdr worktree link right away (`worktree link`), so
# herdr's sidebar "New worktree" lands in <repo>/.worktrees from the first one.
# A config-based hook: it runs alongside each repo's own hooks, needs git 2.54+
# (Apple's /usr/bin/git ignores it), and always exits 0 because a
# post-checkout status becomes the status of the checkout or clone.
[hook "worktree-link"]
	event = post-checkout
	command = "f() { case $1 in *[!0]*) return 0 ;; esac; [ -x \"$HOME/.local/bin/worktree\" ] && \"$HOME/.local/bin/worktree\" hook git-post-checkout \"$@\"; return 0; }; f"
[include]
	path = "~/.gitconfig.local"
[init]
  defaultBranch = main
[pull]
  rebase = true
[rebase]
	autostash = true
  autosquash = true
[rerere]
	enabled = true
[url "ssh://git@github.com/"]
	insteadOf = "https://github.com/"
[user]
	email = "github@spencerboucher.com"
	name = "Spencer Boucher"
