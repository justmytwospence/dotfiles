[core]
	pager = delta
{{- /* Sphinx (run_onchange_after_55-sphinx) sets this itself, byte for byte as here. Render it only
     once its hooks exist: pointing hooksPath at them before the first `sphinx install` would make
     Sphinx chain its hooks to themselves. */}}
{{- $sphinxHooks := joinPath .chezmoi.homeDir ".config/sphinx/hooks/global" }}
{{- if stat $sphinxHooks }}
	hooksPath = {{ $sphinxHooks }}
{{- end }}
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
{{- if eq .host "agentbox-box" }}
# AgentBox box: `git` is AgentBox's shim, which hands clone/fetch/pull/push to the
# hub, and the hub holds the GitHub credential. The box has no key and needs no
# helper; cancel the ssh rewrite below so anything that runs the real git (setup,
# a tool cloning a public repo) uses https as given.
[url "https://github.com/"]
	insteadOf = https://github.com/
{{- end }}
[include]
	path = "~/.gitconfig.local"
[init]
  defaultBranch = main
[pull]
  rebase = true
[rebase]
	autostash = true
  autosquash = true
[rerere]
	enabled = true
[url "ssh://git@github.com/"]
	insteadOf = "https://github.com/"
[user]
	email = "github@spencerboucher.com"
	name = "Spencer Boucher"
