# The following lines were added by Docker Desktop to add commands to your PATH.
# (Its markers are kept so Docker Desktop finds the block and leaves it alone;
# the guarded $HOME spelling works on every host.)
[[ -d $HOME/.docker/bin ]] && export PATH="$PATH:$HOME/.docker/bin"
# End of Docker Desktop section.

# Restore .zshenv's PATH ordering after macOS /etc/zprofile runs path_helper.
(( $+functions[_zsh_setup_path] )) && _zsh_setup_path

