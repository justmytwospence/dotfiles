[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[diff]
	algorithm = histogram
	colorMoved = default
[merge]
{{- if eq .host "nuc" }}
	# Debian's Git 2.30 predates zdiff3 (Git 2.35).
	conflictStyle = diff3
{{- else }}
	conflictStyle = zdiff3
{{- end }}
[branch]
	sort = -committerdate
[tag]
	sort = -version:refname
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[commit]
	verbose = true
[alias]
	dft = -c diff.external=difft diff
	dlog = -c diff.external=difft log -p --ext-diff
{{- if eq .host "agentbox-box" }}
# AgentBox box: `git` is AgentBox's shim, which hands clone/fetch/pull/push to the
# hub, and the hub holds the GitHub credential. The box has no key and needs no
# helper; cancel the ssh rewrite below so anything that runs the real git (setup,
# a tool cloning a public repo) uses https as given.
[url "https://github.com/"]
	insteadOf = https://github.com/
{{- end }}
[init]
	defaultBranch = main
[pull]
	rebase = true
[rebase]
	autostash = true
	autosquash = true
[rerere]
	enabled = true
[url "ssh://git@github.com/"]
	insteadOf = "https://github.com/"
[user]
	email = "github@spencerboucher.com"
	name = "Spencer Boucher"
[include]
	path = "~/.gitconfig.local"
