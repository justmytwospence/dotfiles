{
  "treeFilterMode": "no-tools",
  "npmCommand": [
    "npm-cooldown",
    "--",
    "npm"
  ],
  "packages": [
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:pi-web-access",
    "npm:@cortexkit/pi-antigravity-auth@3.0.11",
    "npm:pi-muse-bridge@0.3.0",
    "git:github.com/justmytwospence/pi-plugins@ccdd0ec648ed4408dc3ab99075daa3b990b31bb2",
    "git:github.com/justmytwospence/pi-marimo@f68bd69a6c2cb534dc95713e7608843f1597dce6",
    {
      "source": "npm:pi-autoresearch",
      "skills": []
    }
  ],
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "medium",
  "externalEditor": "edamame",
  "cacheWarming": "idle",
  "showCacheMissNotices": false,
  "enabledModels": [
    "anthropic/claude-opus-5-5",
    "openai/gpt-6-astra",
    "openai/gpt-6.1-sol",
    "muse-code/muse-wonder-1.0",
    "google/antigravity-gemini-4-argon"
  ],
  "theme": "light/dark",
  "tuiMode": "fullscreen",
  "editorPaddingX": 1,
  "hideThinkingBlock": true,
  "warnings": {
    "anthropicExtraUsage": false
  },
  "piVim": {
    "displayLineMotion": true
  }
}
