{
  "treeFilterMode": "no-tools",
  "npmCommand": [
    "npm-cooldown",
    "--",
    "npm"
  ],
  "packages": [
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:pi-web-access",
    "npm:@cortexkit/pi-antigravity-auth@3.1.7",
    "npm:pi-muse-bridge@0.3.0",
    "git:github.com/justmytwospence/pi-plugins@v0.1.102",
    "npm:pi-marimo@0.8.7",
    {
      "source": "npm:pi-autoresearch",
      "skills": []
    }
  ],
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "medium",
  "externalEditor": "edamame",
  "cacheWarming": "idle",
  "showCacheMissNotices": false,
  "enabledModels": [
    "anthropic/claude-fable-5-2",
    "anthropic/claude-sonnet-5-5",
    "anthropic/claude-opus-5-5",
    "openai/gpt-6-astra",
    "openai/gpt-6.1-terra",
    "openai/gpt-6.1-sol",
    "google/antigravity-gemini-4-carbon",
    "google/antigravity-gemini-4-argon",
    "mtplx/mtplx-qwen38-27b-optimized-speed",
    "local-gguf/nanbeige43-33b",
    "anthropic/opusplan",
    "anthropic/fableplan",
    "anthropic/fableplan-sonnet",
    "openai/astraplan",
    "openai/astraplan-terra",
    "openai/solplan",
    "google/carbonplan",
    "google/carbonplan-hydrogen",
    "google/argonplan"
  ],
  "theme": "light/dark",
  "tuiMode": "fullscreen",
  "editorPaddingX": 1,
  "hideThinkingBlock": true,
  "warnings": {
    "anthropicExtraUsage": false
  },
  "piVim": {
    "displayLineMotion": true
  }
}
