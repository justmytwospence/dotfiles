#!/usr/bin/env zsh

# Uncomment to profile startup time
# zmodload zsh/zprof

setopt auto_cd
setopt auto_pushd
setopt correct
setopt extended_glob
setopt extended_history
setopt glob_dots
setopt hist_fcntl_lock
setopt hist_find_no_dups
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_lex_words
setopt hist_reduce_blanks
setopt hist_verify
setopt inc_append_history
setopt interactive_comments
setopt no_case_glob
setopt numeric_glob_sort
setopt pushd_ignore_dups
setopt pushd_silent
setopt rm_star_wait

autoload -U select-word-style
select-word-style bash

typeset -U path  # Disallow duplicates

export GPG_TTY=$TTY  # Set GPG TTY for interactive shells

HISTFILE=$ZSH/history
HISTSIZE=100000
KEYTIMEOUT=23
REPORTTIME=5
SAVEHIST=100000
ZLE_RPROMPT_INDENT=0
zle_highlight=(paste:none)

source $ZSH/functions.zsh
source $ZSH/completion.zsh
source $ZSH/directory_tracking.zsh
source $ZSH/prompt.zsh
source $ZSH/keybindings.zsh

{{- if eq .host "agentbox-box" }}
# AgentBox box: `git` is AgentBox's shim, which relays clone/fetch/pull/push to the hub
# and refuses most of them. zinit fetches public plugins into its own directory with
# plain git; give it, and only it, the real one.
git() {
    if [[ $PWD == ${XDG_DATA_HOME:-$HOME/.local/share}/zinit* || "$*" == *"/.local/share/zinit"* ]]; then
        /usr/bin/git "$@"
    else
        command git "$@"
    fi
}
{{- end }}

### Added by Zinit's installer
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
[ ! -d $ZINIT_HOME ] && mkdir -p "$(dirname $ZINIT_HOME)"
[ ! -d $ZINIT_HOME/.git ] && git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
source "${ZINIT_HOME}/zinit.zsh"


# Load syntax highlighting and completions with turbo mode (async after prompt)
zinit wait lucid for \
  atinit"zicompinit; zicdreplay; autoload -U bashcompinit && bashcompinit" \
    zdharma-continuum/fast-syntax-highlighting \
  blockf atpull'zinit creinstall -q .' \
    zsh-users/zsh-completions

# Load other plugins async
zinit wait lucid atload"bindkey '^u' dwim" for \
    oknowton/zsh-dwim

# fzf integration (Ctrl+T file finder, Alt+C cd; Ctrl+R is owned by Atuin)
# (fzf 0.48+ for --zsh; an older distro fzf just gets no bindings, not an error)
if command -v fzf >/dev/null 2>&1; then
    source <(fzf --zsh 2>/dev/null)
    # fzf binds Tab in the main keymap (viins, since keybindings.zsh ran bindkey -v) to its
    # fzf-completion wrapper; a wrapper widget keeps the second Tab from entering menu select.
    # Keep native completion there.
    bindkey -M viins '^I' expand-or-complete
fi

## tool initialization

if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
fi

if command -v atuin >/dev/null 2>&1; then
    eval "$(atuin init zsh --disable-up-arrow)"
fi

if command -v direnv >/dev/null 2>&1; then
    eval "$(direnv hook zsh)"
fi

if command -v rbenv >/dev/null 2>&1; then
    eval "$(rbenv init - zsh)"
fi

[[ $TERM_PROGRAM == vscode ]] && . "$(code --locate-shell-integration-path zsh)"

## local
# API keys come from ~/.zshenv, so non-interactive shells get them too.

if [[ -f $HOME/.zshrc.local ]]; then
    source $HOME/.zshrc.local
fi

# Uncomment to see profiling output
# zprof

# broot's launcher is installed per machine (macOS only here), so guard it --
# an unguarded source prints an error on every shell start on the Linux hosts.
[[ -f $HOME/.config/broot/launcher/bash/br ]] && source $HOME/.config/broot/launcher/bash/br
