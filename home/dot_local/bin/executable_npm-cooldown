#!/usr/bin/env node
// npm-cooldown: make `npm view <spec> version --json` respect npm's min-release-age.
//
// npm's installer honors min-release-age (set in ~/.npmrc), but `npm view` does not,
// so tools that check for updates with `npm view` (e.g. pi) report versions that
// npm will then refuse to install. This wrapper filters that one query down to
// versions older than the cooldown and passes every other command through untouched.
// Packages matching min-release-age-exclude (e.g. @earendil-works/*) are passed through too.
// Exact releases explicitly allowed with `cooldown-allow` (~/.config/cooldown-allow.json, until
// they clear the cooldown anyway) count as old enough here, and `npm install` gets
// --min-release-age-exclude for them, the bare name pinned to the allowed version, so a pi
// package can move to that release while its dependencies and later releases still wait.
//
// Usage: npm-cooldown -- npm <args...>
// pi:    "npmCommand": ["npm-cooldown", "--", "npm"]   (the "--" lets pi detect npm)

const { spawnSync } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

let argv = process.argv.slice(2);
if (argv[0] === "--") argv = argv.slice(1);
const [cmd = "npm", ...rawArgs] = argv;

// Active allowances: pkg -> version.
const allowed = new Map();
try {
  const file = path.join(os.homedir(), ".config", "cooldown-allow.json");
  for (const e of JSON.parse(fs.readFileSync(file, "utf8"))) {
    if (e.kind === "npm" && Date.parse(e.until) > Date.now()) allowed.set(e.pkg, e.version);
  }
} catch {}

function specName(spec) {
  const at = spec.lastIndexOf("@");
  return at > 0 ? spec.slice(0, at) : spec;
}

// npm install: pin an allowed package's bare name to its allowed release and exempt only
// that package, so its dependencies keep the cooldown. Other versions of it are left alone.
const INSTALL = new Set(["install", "i", "add"]);
const args = [...rawArgs];
if (INSTALL.has(args[0])) {
  const exempt = [];
  for (let i = 1; i < args.length; i++) {
    const a = args[i];
    if (a.startsWith("-")) continue;
    const name = specName(a);
    const version = allowed.get(name);
    if (!version || (a !== name && a !== `${name}@${version}` && a !== `${name}@latest`)) continue;
    args[i] = `${name}@${version}`;
    exempt.push(`--min-release-age-exclude=${name}`);
  }
  args.push(...exempt);
}

function passthrough() {
  const r = spawnSync(cmd, args, { stdio: "inherit" });
  if (r.error) {
    console.error(`npm-cooldown: ${r.error.message}`);
    process.exit(127);
  }
  process.exit(r.status ?? 1);
}

function capture(a) {
  const r = spawnSync(cmd, a, { encoding: "utf8" });
  if (r.status !== 0) return undefined;
  try {
    return JSON.parse(r.stdout);
  } catch {
    return undefined;
  }
}

function parse(v) {
  const m = /^(\d+)\.(\d+)\.(\d+)(?:-([^+]+))?/.exec(v);
  return m ? { nums: [+m[1], +m[2], +m[3]], pre: m[4] } : undefined;
}

function compare(a, b) {
  const pa = parse(a), pb = parse(b);
  for (let i = 0; i < 3; i++) if (pa.nums[i] !== pb.nums[i]) return pa.nums[i] - pb.nums[i];
  if (pa.pre === pb.pre) return 0;
  if (!pa.pre) return 1;
  if (!pb.pre) return -1;
  return pa.pre < pb.pre ? -1 : 1;
}

// Only intercept the exact update-check query: view <spec> version --json
const isVersionQuery =
  args.length === 4 && args[0] === "view" && args[2] === "version" && args[3] === "--json";
if (!isVersionQuery) passthrough();

const ageRun = spawnSync(cmd, ["config", "get", "min-release-age"], { encoding: "utf8" });
const ageDays = Number.parseFloat((ageRun.stdout || "").trim());
if (!(ageDays > 0)) passthrough();

const spec = args[1];
const at = spec.lastIndexOf("@");
const name = at > 0 ? spec.slice(0, at) : spec;

// Packages exempt from the cooldown (`min-release-age-exclude[]` in ~/.npmrc): report as npm installs.
function globToRegExp(glob) {
  const body = glob.replace(/[.+^${}()|[\]\\]/g, "\\$&").replace(/\*/g, "[^/]*").replace(/\?/g, "[^/]");
  return new RegExp(`^${body}$`);
}
const excludeRun = spawnSync(cmd, ["config", "get", "min-release-age-exclude", "--json"], { encoding: "utf8" });
let excludes = [];
try {
  const parsed = JSON.parse(excludeRun.stdout || "[]");
  excludes = (Array.isArray(parsed) ? parsed : [parsed]).filter((p) => typeof p === "string" && p);
} catch {
  excludes = (excludeRun.stdout || "").split(/[\n,]/).map((p) => p.trim()).filter(Boolean);
}
if (excludes.some((pattern) => pattern === name || globToRegExp(pattern).test(name))) passthrough();

const result = capture(args);
const times = capture(["view", name, "time", "--json"]);
if (result === undefined || !times || typeof times !== "object") passthrough();

const cutoff = Date.now() - ageDays * 86_400_000;
const eligible = (v) =>
  (typeof times[v] === "string" && Date.parse(times[v]) <= cutoff) || allowed.get(name) === v;

let out;
if (Array.isArray(result)) {
  const kept = result.filter(eligible);
  out = kept.length > 0 ? kept : result;
} else if (typeof result === "string" && parse(result)) {
  if (eligible(result)) {
    out = result;
  } else {
    // Mirror npm's install behavior: newest eligible stable version not above the target.
    const fallback = Object.keys(times)
      .filter((v) => parse(v) && !parse(v).pre && eligible(v) && compare(v, result) <= 0)
      .sort(compare)
      .pop();
    out = fallback ?? result;
  }
} else {
  out = result;
}

process.stdout.write(JSON.stringify(out, null, 2) + "\n");
