#!/usr/bin/env node
// npm-cooldown: make pi's npm calls respect npm's min-release-age (docs/cooldown.md).
//
// npm's installer honors min-release-age (~/.npmrc), but `npm view` does not, so pi's update
// check (`npm view <spec> version --json`) reports versions npm then refuses to install. This
// wrapper answers that one query with the newest version old enough and passes every other
// command through. Packages matching min-release-age-exclude are passed through too.
//
// npm exempts packages only by name. Exact releases let through early are listed in
// ~/.config/npm-cooldown/allow.json ("<pkg>@<version>", rendered from the dotfiles'
// .chezmoidata/cooldown.json cooldownAllow, the list pnpm, yarn and bun also read). Such a
// release counts as old enough here, and when it is the newest eligible version an install of
// the bare name or `name@latest` is pinned to it with --min-release-age-exclude=<name> for that
// one command, so its dependencies and later releases still wait.
//
// Usage: npm-cooldown -- npm <args...>
// pi:    "npmCommand": ["npm-cooldown", "--", "npm"]   (the "--" lets pi detect npm)

const { spawnSync } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

let argv = process.argv.slice(2);
if (argv[0] === "--") argv = argv.slice(1);
const [cmd = "npm", ...rawArgs] = argv;

// Allowed releases: name -> Set of versions.
const allowed = new Map();
try {
  const file = path.join(os.homedir(), ".config", "npm-cooldown", "allow.json");
  for (const entry of JSON.parse(fs.readFileSync(file, "utf8"))) {
    if (typeof entry !== "string") continue;
    const name = specName(entry);
    const versions = entry.slice(name.length + 1).split("||").map((v) => v.trim()).filter(Boolean);
    if (!name || versions.length === 0) continue;
    if (!allowed.has(name)) allowed.set(name, new Set());
    for (const v of versions) allowed.get(name).add(v);
  }
} catch {}

function specName(spec) {
  const at = spec.lastIndexOf("@");
  return at > 0 ? spec.slice(0, at) : spec;
}

function passthrough() {
  const r = spawnSync(cmd, args, { stdio: "inherit" });
  if (r.error) {
    console.error(`npm-cooldown: ${r.error.message}`);
    process.exit(127);
  }
  process.exit(r.status ?? 1);
}

function capture(a) {
  const r = spawnSync(cmd, a, { encoding: "utf8" });
  if (r.status !== 0) return undefined;
  try {
    return JSON.parse(r.stdout);
  } catch {
    return undefined;
  }
}

function parse(v) {
  const m = /^(\d+)\.(\d+)\.(\d+)(?:-([^+]+))?/.exec(v);
  return m ? { nums: [+m[1], +m[2], +m[3]], pre: m[4] } : undefined;
}

function compare(a, b) {
  const pa = parse(a), pb = parse(b);
  for (let i = 0; i < 3; i++) if (pa.nums[i] !== pb.nums[i]) return pa.nums[i] - pb.nums[i];
  if (pa.pre === pb.pre) return 0;
  if (!pa.pre) return 1;
  if (!pb.pre) return -1;
  return pa.pre < pb.pre ? -1 : 1;
}

function globToRegExp(glob) {
  const body = glob.replace(/[.+^${}()|[\]\\]/g, "\\$&").replace(/\*/g, "[^/]*").replace(/\?/g, "[^/]");
  return new RegExp(`^${body}$`);
}

// The cooldown in days (npm's min-release-age), or NaN when unset.
function ageDays() {
  const run = spawnSync(cmd, ["config", "get", "min-release-age"], { encoding: "utf8" });
  return Number.parseFloat((run.stdout || "").trim());
}

// Packages exempt from the cooldown (`min-release-age-exclude[]` in ~/.npmrc).
function isExcluded(name) {
  const run = spawnSync(cmd, ["config", "get", "min-release-age-exclude", "--json"], { encoding: "utf8" });
  let excludes = [];
  try {
    const parsed = JSON.parse(run.stdout || "[]");
    excludes = (Array.isArray(parsed) ? parsed : [parsed]).filter((p) => typeof p === "string" && p);
  } catch {
    excludes = (run.stdout || "").split(/[\n,]/).map((p) => p.trim()).filter(Boolean);
  }
  return excludes.some((pattern) => pattern === name || globToRegExp(pattern).test(name));
}

// A version is eligible once it is old enough or is an allowed release.
function eligibleFor(name, times, days) {
  return (v) =>
    (typeof times[v] === "string" && Date.parse(times[v]) <= Date.now() - days * 86_400_000) ||
    !!allowed.get(name)?.has(v);
}

// Newest stable version that is eligible and not above the ceiling.
function newestStable(times, eligible, ceiling) {
  return Object.keys(times)
    .filter((v) => parse(v) && !parse(v).pre && eligible(v) && (!ceiling || compare(v, ceiling) <= 0))
    .sort(compare)
    .pop();
}

// npm install: pin an allowed package to its allowed release when that is the newest
// eligible version, and exempt only that package, so its dependencies keep the cooldown.
const INSTALL = new Set(["install", "i", "add"]);
const args = [...rawArgs];
if (INSTALL.has(args[0]) && allowed.size > 0 && ageDays() > 0) {
  const exempt = [];
  for (let i = 1; i < args.length; i++) {
    const a = args[i];
    if (a.startsWith("-")) continue;
    const name = specName(a);
    if (!allowed.has(name) || isExcluded(name)) continue;
    if (a !== name && a !== `${name}@latest`) {
      if (allowed.get(name).has(a.slice(name.length + 1))) exempt.push(`--min-release-age-exclude=${name}`);
      continue;
    }
    const times = capture(["view", name, "time", "--json"]);
    const latest = capture(["view", name, "version", "--json"]);
    if (!times || typeof times !== "object" || typeof latest !== "string" || !parse(latest)) continue;
    const best = newestStable(times, eligibleFor(name, times, ageDays()), latest);
    if (best && allowed.get(name).has(best)) {
      args[i] = `${name}@${best}`;
      exempt.push(`--min-release-age-exclude=${name}`);
    }
  }
  args.push(...exempt);
}

// Only intercept the exact update-check query: view <spec> version --json
const isVersionQuery =
  args.length === 4 && args[0] === "view" && args[2] === "version" && args[3] === "--json";
if (!isVersionQuery) passthrough();

const days = ageDays();
if (!(days > 0)) passthrough();

const name = specName(args[1]);
if (isExcluded(name)) passthrough();

const result = capture(args);
const times = capture(["view", name, "time", "--json"]);
if (result === undefined || !times || typeof times !== "object") passthrough();

const eligible = eligibleFor(name, times, days);

let out;
if (Array.isArray(result)) {
  const kept = result.filter(eligible);
  out = kept.length > 0 ? kept : result;
} else if (typeof result === "string" && parse(result)) {
  // Mirror npm's install behavior: newest eligible stable version not above the target.
  out = eligible(result) ? result : (newestStable(times, eligible, result) ?? result);
} else {
  out = result;
}

process.stdout.write(JSON.stringify(out, null, 2) + "\n");
