#!/usr/bin/env node
// jev-ask -- ask the configured native System 1 waterfall typed questions about stdin.
//
// The legacy command name follows /system1: agentDir/system1.json holds the ordered waterfall.
// Missing settings default to Jev only; a legacy backend selects a singleton. Mixed/OpenAI
// orders use the installed pi-system1 CLI, notify on stderr, and try only configured rungs.
// A singleton Jev keeps the raw https://api.typesafe.ai/v1/systemone implementation.
// No mode changes the chat model, uses a chat imitation, or executes a verdict.
//
//   jev-ask <<'JSON'
//   {
//     "state": "Help! My payouts have been failing for 3 days.",
//     "questions": {
//       "is_urgent": { "type": "noul", "instructions": "Does this convey urgency?" },
//       "team": {
//         "type": "choice",
//         "instructions": "Which team should handle this?",
//         "criteria": { "billing": "Payments, refunds", "technical": "Bugs, outages" }
//       }
//     }
//   }
//   JSON
//
// Request: `state` (string, object, or array), `questions` (id -> noul, choice, score, or
// box question), optional `model` (default jev-latest; `jev-preview` for Jev 1.14).
// Docs: https://docs.typesafe.ai/api.md
//
// Experimental ("danger zone"; not production-grade):
// - `assets`: images, keyed by a unique reference string (a UUID is safest) that you write
//   in `state`, `instructions`, or `criteria` where the image belongs. Each asset is
//   {"path": "photo.jpg"} (read and base64-encoded here) or {"format": "png", "data_base64": ...}.
//   Sends `TypeSafe-Danger-Zone-Images: true`. https://docs.typesafe.ai/go/images
// - `box` questions: {"type": "box", "instructions": "the mug in `photo`"} returns one
//   bounding box (fractions of width/height) plus confidence. Needs an image and Jev 1.14;
//   there is no "not found", so pair it with a noul. https://docs.typesafe.ai/go/box
// - `"long_context": true`: lift the production context limit (less reliable).
//
// Jev needs TYPESAFE_API_KEY. Decisions needs pi-system1 and /login system1-openai or
// SYSTEM1_OPENAI_API_KEY, using the organization linked to claimed Pro API credits.
// No purchased balance, auto-recharge or paid continuation may be enabled for credits-only use.
// Pi cannot verify the billing source. Box/assets/long_context/model overrides require a
// singleton Jev order. A mixed order rejects them rather than dropping unsupported data.
// Classifier failures can advance only within the configured waterfall; valid denials do not.

const ENDPOINT = "https://api.typesafe.ai/v1/systemone";
const DEFAULT_MODEL = "jev-latest";
const TIMEOUT_MS = 30_000;
const RETRY_DELAYS_MS = [1_000, 3_000];
const QUESTION_TYPES = new Set(["noul", "choice", "score", "box"]);
const IMAGE_FORMATS = new Map([["png", "png"], ["jpg", "jpg"], ["jpeg", "jpg"]]);

async function usage() {
  const { readFileSync } = await import("node:fs");
  const lines = readFileSync(process.argv[1], "utf8").split("\n").slice(1);
  const end = lines.findIndex((line) => !line.startsWith("//"));
  return lines
    .slice(0, end)
    .map((line) => line.replace(/^\/\/ ?/u, ""))
    .join("\n");
}

function fail(message, code = 1) {
  process.stderr.write(`jev-ask: ${message}\n`);
  process.exit(code);
}

async function readStdin() {
  if (process.stdin.isTTY) fail("pass the request as JSON on stdin (see jev-ask --help)", 2);
  let text = "";
  for await (const chunk of process.stdin) text += chunk;
  return text;
}

async function system1Route() {
  const { readFileSync } = await import("node:fs");
  const { homedir } = await import("node:os");
  const { join } = await import("node:path");
  const dir = process.env.PI_CODING_AGENT_DIR || join(homedir(), ".pi", "agent");
  let source;
  try { source = readFileSync(join(dir, "system1.json"), "utf8"); }
  catch (error) {
    if (error?.code === "ENOENT") return { waterfall: ["jev"], dir };
    fail("cannot read System 1 settings; correct agentDir/system1.json", 2);
  }
  let value;
  try { value = JSON.parse(source); }
  catch { fail("invalid System 1 settings JSON; correct agentDir/system1.json", 2); }
  const invalid = () => fail("invalid System 1 backend/waterfall; use a nonempty unique list of jev and openai-decisions in agentDir/system1.json", 2);
  if (!value || typeof value !== "object" || Array.isArray(value)) invalid();
  const waterfall = Object.hasOwn(value, "waterfall") ? value.waterfall : [value.backend];
  if (!Array.isArray(waterfall) || !waterfall.length || waterfall.length > 2 ||
      waterfall.some(backend => !["jev", "openai-decisions"].includes(backend)) ||
      new Set(waterfall).size !== waterfall.length) invalid();
  return { waterfall, dir };
}

async function askWaterfall(dir) {
  const { existsSync } = await import("node:fs");
  const { join } = await import("node:path");
  const { spawn } = await import("node:child_process");
  const cli = join(dir, "git", "github.com", "justmytwospence", "pi-plugins", "packages", "pi-system1", "bin", "ask.mjs");
  if (!existsSync(cli)) fail("The configured System 1 waterfall needs pi-system1; update the Pi suite. No provider outside the configured order was tried.");
  const input = await readStdin();
  const child = spawn(process.execPath, [cli], { stdio: ["pipe", "inherit", "inherit"], env: process.env });
  child.stdin.on("error", () => {}); // An early CLI failure may close stdin before all input is written.
  child.stdin.end(input);
  process.exitCode = await new Promise((resolve, reject) => {
    child.once("error", () => reject(new Error("could not start the installed System 1 CLI")));
    child.once("close", (code) => resolve(code ?? 1));
  });
}

async function loadAssets(assets) {
  if (typeof assets !== "object" || assets === null || Array.isArray(assets)) {
    fail("`assets` must be an object mapping reference strings to images", 2);
  }
  const { readFile } = await import("node:fs/promises");
  const { extname } = await import("node:path");
  const loaded = {};
  for (const [ref, asset] of Object.entries(assets)) {
    if (typeof asset !== "object" || asset === null) fail(`asset \`${ref}\` must be an object`, 2);
    if (typeof asset.path === "string") {
      const format = IMAGE_FORMATS.get((asset.format ?? extname(asset.path).slice(1)).toLowerCase());
      if (!format) fail(`asset \`${ref}\`: only png and jpg images are supported`, 2);
      let data;
      try {
        data = await readFile(asset.path);
      } catch (error) {
        fail(`asset \`${ref}\`: ${error instanceof Error ? error.message : String(error)}`, 2);
      }
      loaded[ref] = { type: "image", format, data_base64: data.toString("base64") };
    } else if (typeof asset.data_base64 === "string" && IMAGE_FORMATS.has(String(asset.format).toLowerCase())) {
      loaded[ref] = { type: "image", format: IMAGE_FORMATS.get(asset.format.toLowerCase()), data_base64: asset.data_base64 };
    } else {
      fail(`asset \`${ref}\` needs \`path\`, or \`format\` (png or jpg) and \`data_base64\``, 2);
    }
  }
  return loaded;
}

async function validate(request) {
  if (typeof request !== "object" || request === null || Array.isArray(request)) {
    fail("the request must be a JSON object with `state` and `questions`", 2);
  }
  const unknown = Object.keys(request).filter((key) => !["state", "questions", "model", "assets", "long_context"].includes(key));
  if (unknown.length > 0) fail(`unknown request fields: ${unknown.join(", ")}`, 2);
  if (request.state === undefined) fail("`state` is required", 2);
  const { questions } = request;
  if (typeof questions !== "object" || questions === null || Array.isArray(questions)) {
    fail("`questions` must be an object mapping ids to questions", 2);
  }
  const ids = Object.keys(questions);
  if (ids.length === 0) fail("`questions` is empty", 2);
  for (const id of ids) {
    const question = questions[id];
    if (!question || !QUESTION_TYPES.has(question.type)) {
      fail(`question \`${id}\` needs a type of noul, choice, score, or box`, 2);
    }
    if (question.instructions === undefined) fail(`question \`${id}\` needs instructions`, 2);
  }
  if (request.model !== undefined && typeof request.model !== "string") fail("`model` must be a string", 2);
  if (request.long_context !== undefined && typeof request.long_context !== "boolean") {
    fail("`long_context` must be true or false", 2);
  }
  const body = { state: request.state, questions, model: request.model || DEFAULT_MODEL };
  const headers = {};
  if (request.assets !== undefined) body.assets = await loadAssets(request.assets);
  if (body.assets || Object.values(questions).some((question) => question.type === "box")) {
    headers["TypeSafe-Danger-Zone-Images"] = "true";
  }
  if (request.long_context) headers["TypeSafe-Danger-Zone-Long-Context"] = "true";
  return { body, headers };
}

async function ask({ body, headers }, apiKey) {
  for (let attempt = 0; ; attempt += 1) {
    let response;
    try {
      response = await fetch(ENDPOINT, {
        method: "POST",
        headers: { authorization: `Bearer ${apiKey}`, "content-type": "application/json", ...headers },
        body: JSON.stringify(body),
        signal: AbortSignal.timeout(TIMEOUT_MS),
      });
    } catch (error) {
      if (attempt < RETRY_DELAYS_MS.length) {
        await new Promise((resolve) => setTimeout(resolve, RETRY_DELAYS_MS[attempt]));
        continue;
      }
      fail(`request failed: ${error instanceof Error ? error.message : String(error)}`);
    }
    const text = await response.text();
    if (response.ok) return JSON.parse(text);
    if ((response.status === 429 || response.status === 529) && attempt < RETRY_DELAYS_MS.length) {
      await new Promise((resolve) => setTimeout(resolve, RETRY_DELAYS_MS[attempt]));
      continue;
    }
    const hint = response.status === 401 ? " (check TYPESAFE_API_KEY)" : "";
    fail(`HTTP ${response.status}${hint}: ${text.slice(0, 2_000)}`);
  }
}

async function main() {
  const args = process.argv.slice(2);
  if (args.length === 1 && (args[0] === "-h" || args[0] === "--help")) {
    process.stdout.write(`${await usage()}\n`);
    return;
  }
  // Only stdin: Plan mode grants match a command prefix, so arguments must not change what runs.
  if (args.length > 0) fail("takes no arguments; pass the request as JSON on stdin (see jev-ask --help)", 2);
  const route = await system1Route();
  if (route.waterfall.length !== 1 || route.waterfall[0] !== "jev") return askWaterfall(route.dir);
  const apiKey = process.env.TYPESAFE_API_KEY?.trim();
  if (!apiKey) fail("TYPESAFE_API_KEY is not set");
  let request;
  try {
    request = JSON.parse(await readStdin());
  } catch (error) {
    fail(`stdin is not valid JSON: ${error instanceof Error ? error.message : String(error)}`, 2);
  }
  const result = await ask(await validate(request), apiKey);
  const { model, answers, usage: tokens } = result;
  process.stdout.write(`${JSON.stringify({ model, answers, usage: tokens }, null, 2)}\n`);
}

main().catch((error) => fail(error instanceof Error ? error.message : String(error)));
