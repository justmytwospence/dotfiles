{
  "agentDirs": {
    "hosts": ["mac-pro"],
    "private": ["~/Projects", "~/Documents", "~/Desktop", "~/Library/Mobile Documents",
      "~/Library/Application Support/aac-touchid"],
    "alwaysWrite": [
      "/tmp", "/private/tmp", "/dev", "$TMPDIR",
      "~/.cache", "~/Library/Caches", "~/.npm", "~/.bun", "~/.cargo", "~/.rustup", "~/.pyenv", "~/.local/share", "~/.local/state",
      "~/.access-protocol"
    ],
    "derived": {
      "paths": [
        "~/.config", "~/.local/bin", "~/.agents", "~/.pi/agent", "~/.claude", "~/.codex", "~/.zsh", "~/.tmux",
        "~/.vim", "~/.emacs.d", "~/Library/LaunchAgents"
      ],
      "hint": "If chezmoi manages this file, edit its source in ~/Projects/dotfiles instead (`chezmoi source-path <file>` names it), then deploy it with `chezmoi apply <file>`. If it is not managed, ask the user."
    },
    "exemptCommands": ["chezmoi apply", "chezmoi update"]
  }
}
