#!/usr/bin/env python3
# Manage connection metadata only; Hermes owns tokens and browser sessions.
import sys
sys.dont_write_bytecode = True
import os
import subprocess

source = os.environ.get("CHEZMOI_SOURCE_DIR") or subprocess.run(
    ["chezmoi", "source-path"], capture_output=True, text=True, check=True
).stdout.strip()
sys.path.insert(0, os.path.join(source, "lib"))
from agent_settings import run_json
from hermes_settings import merge_connections

run_json(
    "private_Library/private_Application Support/private_Hermes/connections.managed.json",
    merge_connections,
)
