{{- /*
  Per-machine answers, asked once by `chezmoi init` and kept in
  ~/.config/chezmoi/chezmoi.toml. Answer without a prompt with
    chezmoi init --source ~/Projects/dotfiles --apply --promptChoice host=<host> --promptString extras=<list>
  README "Hosts" describes each host.
*/ -}}
{{- $hosts := list "mac-pro" "mac-air" "nuc" "agentbox-box" -}}
{{- /* The prompt text is the flag key (--promptChoice host=...), so it is the bare name. */ -}}
{{- $host := promptChoiceOnce . "host" "host" $hosts -}}
{{- /* Comma-separated: emacs, jupyter, linux-desktop; empty for none. */ -}}
{{- $extras := promptStringOnce . "extras" "extras" "" -}}
{{- /* The working tree, not .chezmoi.sourceDir (its home/ subdirectory): chezmoi finds home/ through .chezmoiroot. */ -}}
sourceDir = {{ .chezmoi.workingTree | quote }}
encryption = "age"

[age]
identity = "~/.config/chezmoi/key.txt"
recipient = "age175qn2wp0ekscukgnw2mj703lankldttwyejg4rs76d5uker3tcrspadwxq"

[data]
host = {{ $host | quote }}
role = {{ if eq $host "mac-pro" }}"pro"{{ else }}"air"{{ end }}
extras = {{ $extras | quote }}

[diff]
exclude = ["scripts"]
{{- if ne $host "agentbox-box" }}
{{- /* $HOME tracks committed main: apply and update refuse a worktree, another branch or
       uncommitted source (AGENTS.md "Source and change workflow"). Boxes reset their
       disposable checkout to origin/main before applying, so they need no guard. */}}
{{- $guard := joinPath .chezmoi.workingTree "home/lib/apply_guard.sh" }}

[hooks.apply.pre]
command = "sh"
args = [{{ $guard | quote }}]

[hooks.update.pre]
command = "sh"
args = [{{ $guard | quote }}]
{{- end }}
