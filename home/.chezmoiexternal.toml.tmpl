{{ if eq .chezmoi.os "darwin" -}}
# Bitwarden Agent Access CLI (no Homebrew formula), the client agents run; aac-touchid
# below is the approving side. The
# approving side; the NUC builds its own (installers in .chezmoidata/linux.json). Bump tag and
# both checksums together, honoring the seven-day release cooldown.
{{- $aacSum := dict "arm64" "5d20923e4bb9649ef5df2798d9aa0e95b4a1840ce663d3091534177a118231c1" "amd64" "13bd3535a63285a48bfcc7007b8010223eefa8ef1d1ad73a49ef5cbf72906938" }}
{{- $aacArch := dict "arm64" "aarch64" "amd64" "x86_64" }}

[".local/bin/aac-bin"]
type = "archive-file"
url = "https://github.com/bitwarden/agent-access/releases/download/v0.11.0/aac-macos-{{ get $aacArch .chezmoi.arch }}.tar.gz"
checksum.sha256 = {{ get $aacSum .chezmoi.arch | quote }}
path = "aac"
executable = true

# aac-touchid: the approving side, run by its LaunchAgent. Pinned in
# .chezmoidata/aac_touchid.json.
{{- $aacTouchidArch := dict "arm64" "aarch64" "amd64" "x86_64" }}

[".local/bin/aac-touchid"]
type = "archive-file"
url = "https://github.com/justmytwospence/aac-touchid/releases/download/{{ .aacTouchid.tag }}/aac-touchid-macos-{{ get $aacTouchidArch .chezmoi.arch }}.tar.gz"
checksum.sha256 = {{ get .aacTouchid.sha256 .chezmoi.arch | quote }}
path = "aac-touchid"
executable = true

# The same binary as the service runs it: macOS titles the Touch ID sheet with the
# executable's file name, so the LaunchAgent runs this copy named Bitwarden.
[".local/libexec/aac-touchid/Bitwarden"]
type = "archive-file"
url = "https://github.com/justmytwospence/aac-touchid/releases/download/{{ .aacTouchid.tag }}/aac-touchid-macos-{{ get $aacTouchidArch .chezmoi.arch }}.tar.gz"
checksum.sha256 = {{ get .aacTouchid.sha256 .chezmoi.arch | quote }}
path = "aac-touchid"
executable = true
{{- end }}

{{ if eq .chezmoi.os "darwin" -}}
# HerdrMenu, the menu bar app for herdr (upstream; includes our saved SSH machines PR): source only.
# The converge script's herdr-menu section builds it into ~/Applications. Pin in .chezmoidata/herdr_menu.json.
[".local/share/herdr-menu"]
type = "archive"
url = "https://github.com/pierre-charles/herdr-menu/archive/{{ .herdrMenu.commit }}.tar.gz"
checksum.sha256 = {{ .herdrMenu.sha256 | quote }}
stripComponents = 1
exact = true
{{- end }}

{{ if eq .chezmoi.os "linux" -}}
# Linux release binaries from .chezmoidata/linux.json (the Brewfile's counterpart),
# pinned by tag and sha256. Bump with `python3 lib/linux_releases.py pin <name>`.
{{- $arch := .chezmoi.arch }}
{{- range $name, $r := .linux.releases }}
{{- if or (not (hasKey $r "hosts")) (has $.host $r.hosts) }}
{{- $asset := $r.asset | replace "{version}" $r.version | replace "{arch}" (get $r.arch $arch) }}
{{- $url := printf "https://github.com/%s/releases/download/%s/%s" $r.repo $r.tag $asset }}
{{- $sum := get $r.sha256 $arch }}
{{- if hasKey $r "members" }}
{{- range $bin, $member := get $r.members $arch }}

[".local/bin/{{ $bin }}"]
type = "archive-file"
url = {{ $url | quote }}
checksum.sha256 = {{ $sum | quote }}
path = {{ $member | quote }}
executable = true
{{- end }}
{{- else }}

[".local/bin/{{ $name }}"]
type = "file"
url = {{ $url | quote }}
checksum.sha256 = {{ $sum | quote }}
executable = true
{{- end }}
{{- end }}
{{- end }}
{{- end }}
