{
  // opencode global config -- written by chezmoi to ~/.config/opencode/opencode.jsonc.
  //
  // opencode validates strictly and refuses to start on an invalid field, so
  // check https://opencode.ai/config.json before adding keys. It reads config
  // once at startup: quit and relaunch after editing.
  //
  // Not tracked here, because opencode and herdr own them: auth.json (in
  // ~/.local/share/opencode), plugins/herdr-agent-state.js, herdr-tui-session.js,
  // and tui.jsonc. Credentials never belong in this repo -- it is public.
  //
  // Skills need no config: opencode auto-loads ~/.agents/skills/<name>/SKILL.md,
  // where every skill lives. (It also reads ~/.claude/skills, but that is now a
  // symlink to the same directory -- the bridge Claude Code needs, see docs/agents.md.)
  "$schema": "https://opencode.ai/config.json",

  // Worktrees opencode creates itself (OpenCode Desktop's "New workspace") go in
  // <project>/.worktrees like everyone else's (docs/agents.md "Worktrees");
  // relative paths resolve against the project's main checkout.
  "worktree": {
    "directory": ".worktrees"
  },

  // Claude Code's defaultMode "auto" with guardrails, not an allowlist. An
  // allowlist here means every command outside it stops the agent, which is the
  // opposite of not babysitting it. opencode takes the LAST matching rule, so
  // the blanket allow goes first and the exceptions after it.
  //
  // What still asks: the irreversible things. Everything else -- builds, tests,
  // installs, git, file writes -- just runs.
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "task": "allow",
    "skill": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
{{- if has .host .agentDirs.hosts }}
    // Outside the project: private folders ask (.chezmoidata/agent_dirs.json); a
    // project's grants are allowed in its .opencode/opencode.jsonc. Shell commands
    // are checked by opencode-tool-gate's directory policy.
    "external_directory": {
      "*": "allow"{{ range .agentDirs.private }},
      {{ printf "%s/**" . | toJson }}: "ask"{{ end }}
    },
{{- else }}
    // Reading and editing outside the project directory, e.g. ~/Projects/dotfiles from a
    // project checkout. Set to "ask" if you would rather be told each time.
    "external_directory": "allow",
{{- end }}
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "rm -rf *": "ask",
      "rm -fr *": "ask",
      "git push --force*": "ask",
      "git push -f *": "ask",
      "git reset --hard*": "ask",
      "git clean -*": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "shutdown*": "ask",
      "reboot*": "ask",
      // Slack writes (slackcli): drafting and reading stay allowed
      "*slackcli*messages send*": "ask",
      "*slackcli*messages send-draft*": "ask",
      "*slackcli*messages schedule*": "ask",
      "*slackcli*messages edit*": "ask",
      "*slackcli*messages delete*": "ask",
      "*slackcli*messages react*": "ask",
      "*slackcli*messages unreact*": "ask",
      "*slackcli*canvas create*": "ask",
      "*slackcli*canvas edit*": "ask",
      "*slackcli*conversations members add*": "ask",
      "*slackcli*conversations members remove*": "ask",
      "*slackcli*conversations join*": "ask",
      "*slackcli*conversations leave*": "ask",
      "*slackcli*emoji add*": "ask",
      "*slackcli*emoji remove*": "ask",
      "*slackcli*usergroups create*": "ask",
      "*slackcli*usergroups update*": "ask",
      "*slackcli*usergroups add*": "ask",
      "*slackcli*usergroups remove*": "ask",
      "*slackcli*usergroups enable*": "ask",
      "*slackcli*usergroups disable*": "ask"
    }
  },

  // Off: OpenCode's own updater ignores the 7-day npm cooldown. The CLI is the npm
  // package @opencode/cli; `npm update -g @opencode/cli` moves it to the newest
  // release that has cleared the cooldown.
  "autoupdate": false,
  // The default model for new sessions (OpenCode 2 keeps it per session, apart from
  // the agent's own model, so `opencode run` otherwise starts on a free model).
  "model": "anthropic/claude-sonnet-5-5#high",
  // The login shell on every one of these machines.
  "shell": "/bin/zsh",
  // Nothing here gets shared to opencode's servers.
  "share": "disabled",

  // Plugins (OpenCode 2 API). The auth plugins are npm pins, bumped once a release
  // clears the 7-day cooldown. The rest are components of the opencode-plugins suite
  // (~/Projects/opencode-plugins), all pinned to one suite commit with ::path: specs;
  // OpenCode loads each one's terminal half with it. Terminal-only components are in
  // cli.json at the same commit. The Jev ones need TYPESAFE_API_KEY.
  "plugins": [
    "@ex-machina/opencode-anthropic-auth@2.0.0-next.5",
    "@cortexkit/opencode-antigravity-auth@3.0.0",
    "opencode-auto-effort@github:justmytwospence/opencode-plugins#d34faad4ff44c9647b80e34b2f5cc189680024ab::path:packages/opencode-auto-effort",
    "opencode-tool-gate@github:justmytwospence/opencode-plugins#d34faad4ff44c9647b80e34b2f5cc189680024ab::path:packages/opencode-tool-gate",
    "opencode-marimo@github:justmytwospence/opencode-plugins#d34faad4ff44c9647b80e34b2f5cc189680024ab::path:packages/opencode-marimo",
    "opencode-cache-guard@github:justmytwospence/opencode-plugins#d34faad4ff44c9647b80e34b2f5cc189680024ab::path:packages/opencode-cache-guard",
    "opencode-next-prompt@github:justmytwospence/opencode-plugins#d34faad4ff44c9647b80e34b2f5cc189680024ab::path:packages/opencode-next-prompt",
    "opencode-herdr@github:justmytwospence/opencode-plugins#d34faad4ff44c9647b80e34b2f5cc189680024ab::path:packages/opencode-herdr",
    "opencode-status-footer@github:justmytwospence/opencode-plugins#d34faad4ff44c9647b80e34b2f5cc189680024ab::path:packages/opencode-status-footer",
    "opencode-bg@github:justmytwospence/opencode-plugins#d34faad4ff44c9647b80e34b2f5cc189680024ab::path:packages/opencode-bg",
    "opencode-subagents@github:justmytwospence/opencode-plugins#d34faad4ff44c9647b80e34b2f5cc189680024ab::path:packages/opencode-subagents",
    "opencode-btw@github:justmytwospence/opencode-plugins#d34faad4ff44c9647b80e34b2f5cc189680024ab::path:packages/opencode-btw",
    "opencode-context@github:justmytwospence/opencode-plugins#d34faad4ff44c9647b80e34b2f5cc189680024ab::path:packages/opencode-context",
    "opencode-copy@github:justmytwospence/opencode-plugins#d34faad4ff44c9647b80e34b2f5cc189680024ab::path:packages/opencode-copy"
  ],

  // Planning -- the closest config-only match to pi's plan plugin
  // (pi-plan-mode; docs/agents.md).
  //
  // Tab switches between plan and build, and each agent carries its own model
  // and effort (variant): plan on Opus at xhigh, build on Sonnet at high. Change
  // either before sending with the model picker (<leader>m) or the effort cycle
  // (ctrl+t). /multiplan plans with Fable and Astra in parallel (each able to fan
  // out read-only scouts on Opus and Sol) and lets you pick or synthesize;
  // /implement-fresh hands only the final plan to a fresh-context implementer.
  // Those live in agents/ and commands/ beside this file.
  //
  // The plan permissions are load-bearing: the global "permission" block above
  // is applied after opencode's built-in plan rules and the last match wins, so
  // without these its blanket edit and bash allows made plan mode writable.
  // Planners launch scouts, which is one level deeper than opencode's default
  // (1: subagents cannot launch subagents). The scouts themselves deny task.
  "subagent_depth": 2,
  "agent": {
    "plan": {
      "model": "anthropic/claude-opus-5-5",
      "variant": "xhigh",
      "permission": {
        "edit": {
          "*": "deny",
          ".opencode/plans/*.md": "allow",
          "../.local/share/opencode/plans/*.md": "allow"
        },
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git diff*": "allow",
          "git branch*": "allow",
          "git ls-files*": "allow",
          "git blame*": "allow",
          "git rev-parse*": "allow",
          "ls*": "allow",
          "pwd": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "tree*": "allow",
          "which *": "allow",
          "command -v *": "allow",
          "find *": "allow",
          "find *-delete*": "ask",
          "find *-exec*": "ask"
        }
      }
    },
    "build": {
      "model": "anthropic/claude-sonnet-5-5",
      "variant": "high"
    }
  },

  // Global preferences come from ~/.config/opencode/AGENTS.md, a symlink to the
  // shared ~/.agents/AGENTS.md (as are ~/.claude/CLAUDE.md, ~/.codex/AGENTS.md
  // and ~/.pi/agent/AGENTS.md). No "instructions" entry: opencode already falls
  // back to ~/.claude/CLAUDE.md, so listing the file here risked loading it twice.

  // Meta's Model API ships in opencode's catalogue (models.dev "meta"), but
  // Meta runs on the Muse Code subscription, which only Muse Code and pi
  // (/login) can use; here it would need a pay-as-you-go key. Off, so it is not
  // offered.
  "disabled_providers": ["meta"],

  "provider": {
    // Local Qwen3.8 27B on the pro Mac, the same two servers pi's models.json
    // declares (see its _comment for the details). Elsewhere they just fail to
    // connect. Context is capped at 128k to match pi and LM Studio's load size.
    //
    // mtplx: llama-swap on :8000 (~/.config/llama-swap) starts `mtplx serve`
    // on demand, so the first request after 15 idle minutes waits for the load;
    // timeouts are off for that reason. Mirrors what `mtplx start opencode`
    // writes, done by hand because that rewrites this config. The
    // plugins/mtplx-session.js plugin tags requests with the session id so
    // MTPLX can reuse its KV cache across turns.
    "mtplx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MTPLX (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "mtplx-local",
        "timeout": false,
        "headerTimeout": false,
        "chunkTimeout": 900000,
        "headers": { "x-mtplx-client": "opencode" }
      },
      "models": {
        "mtplx-qwen38-27b-optimized-speed": {
          "name": "Qwen3.8 27B (MTPLX, local)",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "attachment": true,
          "limit": { "context": 131072, "output": 32768 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    },
    // lmstudio: LM Studio, through the same llama-swap on :8000, which unloads
    // MTPLX first so the two are never loaded together. LM Studio JIT-loads the
    // model with the defaults in ~/.lmstudio/.internal/user-concrete-model-
    // default-config (128k context, MTP, draft 3). opencode ships its own
    // lmstudio catalog of models we have not downloaded; whitelist hides them.
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "whitelist": ["qwen3.8-27b"],
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "lm-studio",
        "timeout": false,
        "headerTimeout": false
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B (LM Studio, local)",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "attachment": true,
          "limit": { "context": 131072, "output": 32768 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  },

  // Rendered from dot_config/mcp/mcp.managed.json (also ~/.config/mcp/mcp.json), the shared
  // server set every harness gets; opencode does not read that path itself.
  // Remote servers authenticate interactively with `opencode mcp auth <name>`.
  "mcp": {
{{- $servers := (include "dot_config/mcp/mcp.managed.json" | fromJson).mcpServers }}
{{- range $name, $s := $servers }}{{ if and (hasKey $s "hosts") (not (has $.host $s.hosts)) }}{{ $_ := set $s "enabled" false }}{{ end }}{{ end }}
{{- $names := keys $servers | sortAlpha }}
{{- range $i, $name := $names }}
{{- $s := index $servers $name }}
    {{ $name | toJson }}: {
{{- if hasKey $s "url" }}
      "type": "remote",
      "url": {{ $s.url | toJson }}
{{- if and (hasKey $s "enabled") (not $s.enabled) }},
      "enabled": false
{{- end }}
{{- if and (hasKey $s "oauth") (hasKey $s.oauth "clientId") }},
      "oauth": { "clientId": {{ $s.oauth.clientId | toJson }} }
{{- end }}
{{- else }}
      "type": "local",
      "command": {{ prepend ($s.args | default list) $s.command | toJson }}
{{- if hasKey $s "env" }},
      "environment": {{ $s.env | toJson }}
{{- end }}
{{- if and (hasKey $s "enabled") (not $s.enabled) }},
      "enabled": false
{{- end }}
{{- end }}
    }{{ if lt $i (sub (len $names) 1) }},{{ end }}
{{- end }}
  }
}
