{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "solarized"
  },
  "mouse": true,
  "animations": true,
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "keybinds": {
    "prompt.history.previous": "up,ctrl+p",
    "prompt.history.next": "down,ctrl+n",
    "command.palette.show": "<leader>p",
    "model.list": "alt+p,<leader>m",
    "variant.cycle": "alt+t",
    "agent.cycle": "shift+tab",
    "prompt.stash": "ctrl+s",
    "prompt.editor": "ctrl+g,<leader>e",
    "session.first": "home"
  },
  "plugins": [
    "./herdr-opencode",
    "opencode-prose-width@github:justmytwospence/opencode-plugins#d34faad4ff44c9647b80e34b2f5cc189680024ab::path:packages/opencode-prose-width",
    "opencode-markdown-extras@github:justmytwospence/opencode-plugins#d34faad4ff44c9647b80e34b2f5cc189680024ab::path:packages/opencode-markdown-extras",
    "opencode-sticky-last-prompt@github:justmytwospence/opencode-plugins#d34faad4ff44c9647b80e34b2f5cc189680024ab::path:packages/opencode-sticky-last-prompt",
    "opencode-diff-review@github:justmytwospence/opencode-plugins#d34faad4ff44c9647b80e34b2f5cc189680024ab::path:packages/opencode-diff-review"
  ]
}
