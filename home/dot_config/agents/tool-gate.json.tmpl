{{- /* Generic Pi boundaries on every host; shared project grants/rules belong to each repository's .pi/tool-gate.json, not chezmoi. Native harness host policy remains separate. */ -}}
{
  "persistence": {"project": "shared", "userWritable": false},
  "directories": {
    "enabled": true,
    "private": {{ .agentDirs.private | toJson }},
    "alwaysWrite": {{ .agentDirs.alwaysWrite | toJson }},
    "derived": [
{{- range $i, $p := .agentDirs.derived.paths }}{{ if $i }},{{ end }}
      {{ dict "path" $p "hint" $.agentDirs.derived.hint | toJson }}
{{- end }}
    ],
    "exemptCommands": {{ .agentDirs.exemptCommands | toJson }}
  }
}
