# Samples account-wide usage every 10 minutes (defenestrator-plan) and is the safety net
# for the exact-time runs each run books (transient defenestrator-next.timer, lost
# on reboot).
# Enabled by the timers.target.wants link beside it.
[Unit]
Description=Defenestrator: throw out spent 5-hour LLM usage windows, start fresh ones (sampling and fallback)

[Timer]
OnBootSec=2min
OnCalendar=*:0/10

[Install]
WantedBy=timers.target
