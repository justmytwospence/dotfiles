# The NUC's always-on herdr server, the default session (docs/herdr.md). Deployed on the
# NUC only (.chezmoiignore) and enabled by the default.target.wants link beside it.
#
# Without this the server lives in whatever SSH login started it and does not come back
# after a reboot until a client attaches; phone access to its panes and plugin
# daemons (herdr-agentbox, git-status) are unavailable until then.
#
# A server that is already running unsupervised is left alone (ExecCondition). Moving it
# under systemd: `herdr server stop && systemctl --user start herdr` back to back, with
# no client attached -- an attached client (the Macs' `homelab` alias) starts a new
# unsupervised server within a second of the stop. Panes end; agents resume through
# [session].resume_agents_on_restore.
# Upgrade by restarting this unit, not by `herdr update --handoff`: a live handoff under
# a systemd unit kills the panes or leaves the new server unsupervised (herdr#4972).
[Unit]
Description=herdr server (default session)

[Service]
Type=simple
# zsh -c reads ~/.zshenv: PATH (node for the plugin hooks, ~/.local/bin) and the PI_*
# settings, for the server and every pane it spawns.
ExecCondition=/usr/bin/zsh -c '! herdr status server | grep -qx "status: running"'
ExecStart=/usr/bin/zsh -c 'exec herdr server'
WorkingDirectory=%h/homelab
Restart=on-failure
RestartSec=10
# SIGTERM to herdr alone first, so it saves the session and stops its panes itself.
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=default.target
