# Font
font-family = JetBrains Mono
font-size = 14

# Theme (auto-switches with macOS dark/light mode)
theme = light:custom-light,dark:custom-dark

# Shell integration
shell-integration-features = cursor,sudo,ssh-terminfo
# Pi fullscreen captures mouse clicks. Shift+Command-click bypasses capture to open links.
link-url = true
mouse-shift-capture = false

# macOS
macos-titlebar-style = tabs
macos-option-as-alt = true
macos-non-native-fullscreen = visible-menu
desktop-notifications = true
bell-features = system

# Clipboard (enable OSC 52 for tmux integration)
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true

# Font rendering
font-thicken = true

# Window state
window-save-state = never
window-inherit-working-directory = false
working-directory = home

# Window (slightly translucent, frosted glass; macOS blur)
background-opacity = 0.88
background-blur = 20
window-padding-x = 8
window-padding-y = 4

# Cursor (block cursor, no blink -- vim style)
cursor-style = block
cursor-style-blink = false

# Scrollback (generous for agent output). The limit is bytes, not lines: 50 MB,
# matching herdr's scrollback_limit_bytes and Ghostty 1.4's default (compressed
# while idle there). 1.4 renames it scrollback-limit-bytes and adds
# scrollback-limit-lines; the old name keeps working, and 1.3 rejects the new ones.
scrollback-limit = 52428800

# Mouse
mouse-hide-while-typing = true
# Ghostty 1.4: "clipboard" means the system clipboard only (macOS has no
# selection clipboard to miss), and no longer changes middle-click paste.
copy-on-select = clipboard

# Splits
unfocused-split-opacity = 0.85
split-divider-color = #6699ff


# Fullscreen
keybind = cmd+enter=toggle_fullscreen

# Quick terminal (summon from anywhere)
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# Don't prompt when closing a pane
confirm-close-surface = false

