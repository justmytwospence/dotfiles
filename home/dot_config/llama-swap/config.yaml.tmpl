# llama-swap: on-demand front for local inference servers (pro Mac only).
# Run by ~/Library/LaunchAgents/com.spencerboucher.llama-swap.plist on
# 127.0.0.1:8000. A request naming a model below starts its cmd on ${PORT},
# waits for checkEndpoint, proxies, and stops it after ttl idle seconds.
# Status/logs UI: http://127.0.0.1:8000/ui. Unload now:
#   curl -X POST http://127.0.0.1:8000/api/models/unload
#
# pi's and opencode's local providers point here; their model ids must match.
# With no groups configured, llama-swap runs one model at a time. A global
# limit prevents overlapping inference; manually loading in LM Studio bypasses it.

healthCheckTimeout: 300  # first load reads the model weights and warms up
logLevel: info
startPort: 10001
# off: it injects "loading..." text into the reasoning stream, which pi would
# store as model thinking
sendLoadingState: false
globalTTL: 900
globalConcurrencyLimit: 1
unloadTimeout: 20  # mtplx flushes its session cache on SIGTERM

models:
  "mtplx-qwen38-27b-optimized-speed":
    name: "Qwen3.8 27B (MTPLX)"
    # The model id is MTPLX's served id for this pack, so no useModelName.
    # Default profile resolves to Turbo for this pack, same as `mtplx start`.
    cmd: |
      /opt/homebrew/bin/mtplx serve
        --model Youssofal/Qwen3.8-27B-MTPLX-Optimized-Speed
        --host 127.0.0.1 --port ${PORT}
    checkEndpoint: /health
    ttl: 900

  "qwen3.8-27b":
    name: "Qwen3.8 27B (LM Studio)"
    # LM Studio's own server on :1234 does the serving; lmstudio-hold just
    # marks the model as running and unloads LM Studio when stopped. The first
    # request JIT-loads the model with its saved defaults (128k, MTP draft 3).
    cmd: {{ .chezmoi.homeDir }}/.config/llama-swap/lmstudio-hold
    proxy: http://127.0.0.1:1234
    checkEndpoint: /v1/models
    ttl: 900
{{ range .localModels.additions }}
  {{ .id | quote }}:
    name: {{ .name | quote }}
    cmd: |
{{- if eq .runtime "mtplx" }}
      /usr/bin/env MTPLX_MANAGED_CLIENT_CONTROLS=client /opt/homebrew/bin/mtplx serve
        --model {{ joinPath $.chezmoi.homeDir .directory | quote }} --model-id {{ .id | quote }}
        --host 127.0.0.1 --port ${PORT}
        --context-window {{ .contextWindow }} --max-tokens {{ .maxTokens }}
        --profile {{ .settings.profile }} --depth {{ .settings.depth }} --no-stats-footer
        --default-temperature {{ .settings.temperature }} --default-top-p {{ .settings.topP }}
        --default-top-k {{ .settings.topK }} --default-presence-penalty {{ .settings.presencePenalty }}
{{- if hasKey .settings "reasoningEffort" }}
        --reasoning-effort {{ .settings.reasoningEffort }}
{{- end }}
{{- else if eq .runtime "llama.cpp" }}
      /opt/homebrew/bin/llama-server
        --model {{ joinPath $.chezmoi.homeDir .directory .settings.modelFile | quote }}
        --mmproj {{ joinPath $.chezmoi.homeDir .directory .settings.mmprojFile | quote }}
        --alias {{ .id | quote }} --host 127.0.0.1 --port ${PORT}
        -ngl {{ .settings.gpuLayers }} -fa {{ .settings.flashAttention }} -c {{ .contextWindow }} -np {{ .settings.parallel }}
        --n-predict {{ .maxTokens }} --no-context-shift
        -b {{ .settings.batchSize }} -ub {{ .settings.microBatchSize }} --cache-type-k {{ .settings.cacheTypeK }} --cache-type-v {{ .settings.cacheTypeV }}
        --jinja --reasoning-format {{ .settings.reasoningFormat }} --temp {{ .settings.temperature }} --top-p {{ .settings.topP }}
        --top-k {{ .settings.topK }} --min-p {{ .settings.minP }} --repeat-penalty {{ .settings.repeatPenalty }}
        --chat-template-kwargs '{{ .settings.chatTemplateKwargs | toJson }}'
{{- end }}
    checkEndpoint: /health
    ttl: 900
{{ end }}
