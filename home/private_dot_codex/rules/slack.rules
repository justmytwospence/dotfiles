prefix_rule(pattern=["slackcli", "emoji", "remove"], decision="forbidden", justification="Slack writes are blocked in Codex: ask the user to run it themselves")
prefix_rule(pattern=["slackcli", "usergroups", "create"], decision="forbidden", justification="Slack writes are blocked in Codex: ask the user to run it themselves")
