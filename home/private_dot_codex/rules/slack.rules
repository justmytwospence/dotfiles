# Slack: Codex cannot post or change anything others can see. "prompt" does not work here:
# approvals_reviewer = "auto_review" (a model) answers it instead of the user. Reading,
# searching and drafting stay free. Written by chezmoi; Codex appends its own approvals to default.rules.
prefix_rule(pattern=["slackcli", "messages", "send"], decision="forbidden", justification="Slack writes are blocked in Codex: ask the user to run it themselves")
prefix_rule(pattern=["slackcli", "messages", "send-draft"], decision="forbidden", justification="Slack writes are blocked in Codex: ask the user to run it themselves")
prefix_rule(pattern=["slackcli", "messages", "schedule"], decision="forbidden", justification="Slack writes are blocked in Codex: ask the user to run it themselves")
