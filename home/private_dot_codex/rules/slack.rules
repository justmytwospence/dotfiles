prefix_rule(pattern=["slackcli", "messages", "delete"], decision="forbidden", justification="Slack writes are blocked in Codex: ask the user to run it themselves")
prefix_rule(pattern=["slackcli", "messages", "react"], decision="forbidden", justification="Slack writes are blocked in Codex: ask the user to run it themselves")
prefix_rule(pattern=["slackcli", "messages", "unreact"], decision="forbidden", justification="Slack writes are blocked in Codex: ask the user to run it themselves")
prefix_rule(pattern=["slackcli", "canvas", "create"], decision="forbidden", justification="Slack writes are blocked in Codex: ask the user to run it themselves")
prefix_rule(pattern=["slackcli", "canvas", "edit"], decision="forbidden", justification="Slack writes are blocked in Codex: ask the user to run it themselves")
