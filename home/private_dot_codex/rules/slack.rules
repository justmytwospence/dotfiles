# Slack: posting or changing anything others can see asks first. Reading, searching and
# drafting stay free. Written by chezmoi; Codex appends its own approvals to default.rules.
prefix_rule(pattern=["slackcli", "messages", "send"], decision="prompt", justification="Slack write: needs explicit approval")
prefix_rule(pattern=["slackcli", "messages", "send-draft"], decision="prompt", justification="Slack write: needs explicit approval")
prefix_rule(pattern=["slackcli", "messages", "schedule"], decision="prompt", justification="Slack write: needs explicit approval")
prefix_rule(pattern=["slackcli", "messages", "edit"], decision="prompt", justification="Slack write: needs explicit approval")
prefix_rule(pattern=["slackcli", "messages", "delete"], decision="prompt", justification="Slack write: needs explicit approval")
prefix_rule(pattern=["slackcli", "messages", "react"], decision="prompt", justification="Slack write: needs explicit approval")
prefix_rule(pattern=["slackcli", "messages", "unreact"], decision="prompt", justification="Slack write: needs explicit approval")
prefix_rule(pattern=["slackcli", "canvas", "create"], decision="prompt", justification="Slack write: needs explicit approval")
prefix_rule(pattern=["slackcli", "canvas", "edit"], decision="prompt", justification="Slack write: needs explicit approval")
prefix_rule(pattern=["slackcli", "conversations", "members", "add"], decision="prompt", justification="Slack write: needs explicit approval")
prefix_rule(pattern=["slackcli", "conversations", "members", "remove"], decision="prompt", justification="Slack write: needs explicit approval")
prefix_rule(pattern=["slackcli", "conversations", "join"], decision="prompt", justification="Slack write: needs explicit approval")
prefix_rule(pattern=["slackcli", "conversations", "leave"], decision="prompt", justification="Slack write: needs explicit approval")
prefix_rule(pattern=["slackcli", "emoji", "add"], decision="prompt", justification="Slack write: needs explicit approval")
prefix_rule(pattern=["slackcli", "emoji", "remove"], decision="prompt", justification="Slack write: needs explicit approval")
prefix_rule(pattern=["slackcli", "usergroups", "create"], decision="prompt", justification="Slack write: needs explicit approval")
prefix_rule(pattern=["slackcli", "usergroups", "update"], decision="prompt", justification="Slack write: needs explicit approval")
prefix_rule(pattern=["slackcli", "usergroups", "add"], decision="prompt", justification="Slack write: needs explicit approval")
prefix_rule(pattern=["slackcli", "usergroups", "remove"], decision="prompt", justification="Slack write: needs explicit approval")
prefix_rule(pattern=["slackcli", "usergroups", "enable"], decision="prompt", justification="Slack write: needs explicit approval")
prefix_rule(pattern=["slackcli", "usergroups", "disable"], decision="prompt", justification="Slack write: needs explicit approval")
