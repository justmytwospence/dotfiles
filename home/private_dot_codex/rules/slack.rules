prefix_rule(pattern=["slackcli", "conversations", "members", "remove"], decision="forbidden", justification="Slack writes are blocked in Codex: ask the user to run it themselves")
prefix_rule(pattern=["slackcli", "conversations", "join"], decision="forbidden", justification="Slack writes are blocked in Codex: ask the user to run it themselves")
prefix_rule(pattern=["slackcli", "conversations", "leave"], decision="forbidden", justification="Slack writes are blocked in Codex: ask the user to run it themselves")
