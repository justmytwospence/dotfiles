{{- /* Target paths chezmoi leaves alone on this host. Templated: see .chezmoi.toml.tmpl for .host and .extras. */ -}}
{{- $extras := splitList "," (.extras | replace " " "") -}}
{{- $mac := hasPrefix "mac-" .host -}}

# The Python behind the modify_ scripts and the converge script, and its tests
lib
# The managed halves of the modify_ targets: read by the modify_ scripts, never written to $HOME
**/*.managed.json
# Docker Desktop owns ~/.docker/config.json (credsStore, contexts); kept for reference only
.docker
# Claude Code generates these runtime type links/configs inside mod archives.
# Keep them outside chezmoi ownership, including exact archive deletion.
.local/share/plugins/**/.claude-plugin/types
.local/share/plugins/**/.claude-plugin/types/**
.local/share/plugins/claude-code-playground/claude-code/mods/token-weather/tsconfig.json

{{ if not $mac -}}
# macOS only
.Brewfile
.gvimrc
.config/ghostty
.config/karabiner
# pip.conf's uploaded-prior-to needs pip 26; Linux hosts have the distro's pip 20
.config/pip
.config/swiftbar
Library
# aac-touchid's Bitwarden-named service binary (.chezmoiexternal.toml.tmpl)
.local/libexec/aac-touchid
# The NUC's key, authorized on the Macs (NUC -> Mac SSH over WireGuard)
.ssh/authorized_keys
# ssh uses the Bitwarden desktop app's SSH agent
.ssh/config.d/bitwarden-agent
# GitHub and NUC use plain keys, not the Bitwarden agent
.ssh/config.d/00-plain-keys
# Publishing alias for reports.spencerboucher.com (bio-discovery pre-push hook)
.ssh/config.d/reports-publish
raycast-scripts
# Native Mac notifications; the Mac's watcher already covers remote herdr machines
.config/herdr/plugins/config/herdr-native-notify
.local/bin/herdr-native-notify
{{- end }}

{{ if $mac -}}
# systemd user units are Linux-only
.config/systemd
# pnpm reads ~/Library/Preferences/pnpm on macOS
.config/pnpm
{{- end }}

{{ if ne .host "mac-pro" -}}
# Local LLMs on the pro Mac only (docs/agents.md)
.config/llama-swap
.lmstudio
Library/LaunchAgents/com.spencerboucher.llama-swap.plist
{{- end }}

{{ if ne .host "nuc" -}}
# telebrowser runs on the NUC only (~/Projects/homelab/telebrowser): its launcher link and skill
.local/bin/telebrowser
.agents/skills/telebrowser
# The NUC's always-on herdr server (docs/herdr.md)
.config/systemd/user/herdr.service
.config/systemd/user/default.target.wants/herdr.service
# herdr-agentbox settings (NUC only): a new space stays a plain shell
.config/herdr-agentbox
# SSH Host entries for the Macs (NUC only)
.ssh/config.d/macs
{{- end }}

{{ if not (or $mac (eq .host "nuc")) -}}
# The Include that reads ~/.ssh/config.d (NUC and Macs)
.ssh/config
.ssh/config.d
{{- end }}

{{ if ne .host "agentbox-box" -}}
# herdr writes its own Claude hook script (`herdr integration install`); a box has no herdr,
# so chezmoi creates a no-op stand-in there for the managed hook entry to call.
.claude/hooks/herdr-agent-state.sh
{{- end }}

{{ if eq .host "agentbox-box" -}}
# No herdr in an AgentBox box
.config/herdr
# No Collie in a box (it mirrors herdr)
.config/collie
# No aac (Bitwarden Agent Access) in a box: release builds are x86_64-only
.agents/skills/agent-access
.local/bin/aac
# No Slack in a box: sessions stay on the Macs and the NUC (slackcli's release is NUC-only)
.agents/skills/slackcli
.local/bin/slack-agent
# terminal-browser comes with the herdr plugin (.chezmoidata/herdr_plugins.json): its skill links,
# state and settings
.agents/skills/terminal-browser
.codex/skills
.local/bin/terminal-browser-agent
.config/terminal-browser
.local/state/terminal-browser
{{- end }}

{{ if not (and (has .host (list "mac-pro" "mac-air" "nuc")) (stat (joinPath .chezmoi.homeDir ".config/chezmoi/key.txt"))) -}}
# API keys: decrypted only where the age key has been copied (README "Secrets")
.config/dotfiles
{{- end }}

{{ if not (has "emacs" $extras) -}}
.emacs.d
.config/systemd/user/emacs.service
{{- end }}

{{ if not (has "jupyter" $extras) -}}
.jupyter
.ipython
{{- end }}

{{ if not (has "linux-desktop" $extras) -}}
.Xmodmap
.config/Code
.config/alacritty
.config/albert
.config/autostart
.config/gtk-3.0
.config/i3
.config/kitty
.config/polybar
.config/rofi
.config/run-or-raise
.config/systemd/user/terminator.service
.config/terminator
.local/bin/remap-keys
{{- end }}
