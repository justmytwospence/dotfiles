{{- /* A project's .agents/tool-gate.json: its grants (and any pi-tool-gate permission rules, `permissions`) from .chezmoidata/agent_dirs.json, for pi-tool-gate, opencode-tool-gate and claude-tool-gate. Argument: the chezmoi data plus "name", the project. */ -}}
{{- $p := index $.agentDirs.projects .name -}}
{{- $out := dict "directories" (dict "read" $p.read "write" $p.write) -}}
{{- if hasKey $p "permissions" }}{{ $_ := set $out "permissions" $p.permissions }}{{ end -}}
{{- $out | toPrettyJson | trim -}}
